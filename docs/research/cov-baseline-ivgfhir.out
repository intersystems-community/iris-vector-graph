L|Graph.KG.NKGAccelTraversal.1|382|0|    }
L|Graph.KG.NKGAccelTraversal.1|383|0|KHSDone
L|Graph.KG.NKGAccelTraversal.1|384|0|    Set tag = $TR($ZHex($Now())_$ZHex($RANDOM(999999)),":.","__")
L|Graph.KG.NKGAccelTraversal.1|385|0|    Set node = ""
L|Graph.KG.NKGAccelTraversal.1|386|0|    For {
L|Graph.KG.NKGAccelTraversal.1|387|0|        Set node = $Order(^||visited(node), 1, dist)
L|Graph.KG.NKGAccelTraversal.1|388|0|        Quit:node=""
L|Graph.KG.NKGAccelTraversal.1|389|0|        If useNKG {
L|Graph.KG.NKGAccelTraversal.1|390|0|            Set nodeStr = $Get(^NKG("$ND", node), node)
L|Graph.KG.NKGAccelTraversal.1|391|0|        } Else {
L|Graph.KG.NKGAccelTraversal.1|392|0|            Set nodeStr = node
L|Graph.KG.NKGAccelTraversal.1|393|0|        }
L|Graph.KG.NKGAccelTraversal.1|394|0|        Set ^ArnoKG("khop_r", tag, dist, nodeStr) = ""
L|Graph.KG.NKGAccelTraversal.1|395|0|    }
