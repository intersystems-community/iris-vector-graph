L|Graph.KG.NKGAccelCentrality.1|399|-9|    Set adjDir = $Select(direction="in": -2, 1: -1)
L|Graph.KG.NKGAccelCentrality.1|400|-9|    Set nid = ""
L|Graph.KG.NKGAccelCentrality.1|401|-9|    For {
