L|Graph.KG.NKGAccelAdjacency.1|16|0|    Kill ^||seedBFS
L|Graph.KG.NKGAccelAdjacency.1|17|0|    Set ^||seedBFS("frontier", seedIdx) = ""
L|Graph.KG.NKGAccelAdjacency.1|18|0|    Set ^||seedBFS("seen", seedIdx) = ""
L|Graph.KG.NKGAccelAdjacency.1|19|0|    For hop = 1:1:maxHops {
L|Graph.KG.NKGAccelAdjacency.1|20|0|        Kill ^||seedBFS("nextFrontier")
L|Graph.KG.NKGAccelAdjacency.1|21|0|        Set s = ""
L|Graph.KG.NKGAccelAdjacency.1|22|0|        For {
L|Graph.KG.NKGAccelAdjacency.1|23|0|            Set s = $Order(^||seedBFS("frontier", s))
L|Graph.KG.NKGAccelAdjacency.1|24|0|            Quit:s=""
L|Graph.KG.NKGAccelAdjacency.1|25|0|            Set pred = ""
L|Graph.KG.NKGAccelAdjacency.1|26|0|            For {
L|Graph.KG.NKGAccelAdjacency.1|27|0|                Set pred = $Order(^NKG(-1, s, pred))
L|Graph.KG.NKGAccelAdjacency.1|28|0|                Quit:pred=""
L|Graph.KG.NKGAccelAdjacency.1|29|0|                If $IsObject(preds) {
L|Graph.KG.NKGAccelAdjacency.1|30|0|                    Set allowed = 0
L|Graph.KG.NKGAccelAdjacency.1|31|0|                    Set predStr = $Get(^NKG("$LS", -pred - 1), "")
L|Graph.KG.NKGAccelAdjacency.1|32|0|                    For pi = 0:1:preds.%Size()-1 {
L|Graph.KG.NKGAccelAdjacency.1|33|0|                        If preds.%Get(pi) = predStr { Set allowed = 1 Quit }
L|Graph.KG.NKGAccelAdjacency.1|34|0|                    }
L|Graph.KG.NKGAccelAdjacency.1|35|0|                    If 'allowed Continue
L|Graph.KG.NKGAccelAdjacency.1|36|0|                }
L|Graph.KG.NKGAccelAdjacency.1|37|0|                Set dst = ""
L|Graph.KG.NKGAccelAdjacency.1|38|0|                For {
L|Graph.KG.NKGAccelAdjacency.1|39|0|                    Set dst = $Order(^NKG(-1, s, pred, dst))
L|Graph.KG.NKGAccelAdjacency.1|40|0|                    Quit:dst=""
L|Graph.KG.NKGAccelAdjacency.1|41|0|                    Set ^||seedBFS("nodes", s) = ""
L|Graph.KG.NKGAccelAdjacency.1|42|0|                    Set ^||seedBFS("nodes", dst) = ""
L|Graph.KG.NKGAccelAdjacency.1|43|0|                    If '$Data(^||seedBFS("seen", dst)) {
