L|Graph.KG.NKGAccelCentrality.1|80|-9|    If $Get(^NKG("$NI",seedId),-1) = -1 Quit "ERROR:seed node not found: "_seedId
L|Graph.KG.NKGAccelCentrality.1|81|-9|    Set hopsRaw = ##class(Graph.KG.NKGAccelTraversal).KHopNeighbors(seedId, hops, 1000000)
L|Graph.KG.NKGAccelCentrality.1|82|-9|    If $Extract(hopsRaw,1,7) = "ERROR: " Quit hopsRaw
L|Graph.KG.NKGAccelCentrality.1|83|-9|    If hopsRaw = "" Quit "ERROR:empty neighborhood"
L|Graph.KG.NKGAccelCentrality.1|84|-9|    // Parse node list from KHopNeighbors JSON response
L|Graph.KG.NKGAccelCentrality.1|85|-9|    Kill ^||nbhIdx, ^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|86|-9|    Set n = 0, parseErr = ""
L|Graph.KG.NKGAccelCentrality.1|87|-9|    Try {
L|Graph.KG.NKGAccelCentrality.1|88|-9|        Set obj = ##class(%Library.DynamicObject).%FromJSON(hopsRaw)
L|Graph.KG.NKGAccelCentrality.1|89|-9|        Set nodesArr = obj.nodes
L|Graph.KG.NKGAccelCentrality.1|90|-9|        If '$IsObject(nodesArr) { Set parseErr = "ERROR:no nodes in neighborhood" }
L|Graph.KG.NKGAccelCentrality.1|91|-9|        Else {
L|Graph.KG.NKGAccelCentrality.1|92|-9|            Set iter = nodesArr.%GetIterator()
L|Graph.KG.NKGAccelCentrality.1|93|-9|            While iter.%GetNext(.k, .nodeObj) {
L|Graph.KG.NKGAccelCentrality.1|94|-9|                Set nodeId = $Select($IsObject(nodeObj):nodeObj.id, 1:nodeObj)
L|Graph.KG.NKGAccelCentrality.1|95|-9|                Set idx = $Get(^NKG("$NI",nodeId),-1)
L|Graph.KG.NKGAccelCentrality.1|96|-9|                If idx >= 0 {
L|Graph.KG.NKGAccelCentrality.1|97|-9|                    Set ^||nbhIdx(idx) = ""
L|Graph.KG.NKGAccelCentrality.1|98|-9|                    Set ^||nbhNodes(n) = nodeId
L|Graph.KG.NKGAccelCentrality.1|99|-9|                    Set n = n + 1
L|Graph.KG.NKGAccelCentrality.1|100|-9|                }
L|Graph.KG.NKGAccelCentrality.1|101|-9|            }
L|Graph.KG.NKGAccelCentrality.1|102|-9|        }
L|Graph.KG.NKGAccelCentrality.1|103|-9|    } Catch ex {
L|Graph.KG.NKGAccelCentrality.1|104|-9|        Set parseErr = "ERROR:parse failed "_ex.DisplayString()
L|Graph.KG.NKGAccelCentrality.1|105|-9|    }
L|Graph.KG.NKGAccelCentrality.1|106|-9|    If parseErr '= "" Quit parseErr
L|Graph.KG.NKGAccelCentrality.1|107|-9|    If n = 0 Quit "ERROR:no valid nodes in neighborhood"
L|Graph.KG.NKGAccelCentrality.1|108|-9|    // Try arno fast path ? reuses BETWEENNESS_ADJ_CACHE, extracts subgraph in Rust
L|Graph.KG.NKGAccelCentrality.1|109|-9|    Try {
L|Graph.KG.NKGAccelCentrality.1|110|-9|        If ##class(Graph.KG.NKGAccelLoader).IsLoaded() {
L|Graph.KG.NKGAccelCentrality.1|111|-9|            Set dllid = $Get(^||NKGAccel("dllid"), 0)
L|Graph.KG.NKGAccelCentrality.1|112|-9|            If dllid '= 0 {
L|Graph.KG.NKGAccelCentrality.1|113|-9|                If '$Data(^ArnoKG("KG","nkg_adj")) { Do ##class(Graph.KG.NKGAccelLoader).WarmAdjCache() }
L|Graph.KG.NKGAccelCentrality.1|114|-9|                Set fnidN = $ZF(-4, 3, dllid, "kg_betweenness_neighborhood_v")
L|Graph.KG.NKGAccelCentrality.1|115|-9|                If fnidN > 0 {
L|Graph.KG.NKGAccelCentrality.1|116|-9|                    Set idxList = "", idx = ""
L|Graph.KG.NKGAccelCentrality.1|117|-9|                    For {
L|Graph.KG.NKGAccelCentrality.1|118|-9|                        Set idx = $Order(^||nbhIdx(idx))
L|Graph.KG.NKGAccelCentrality.1|119|-9|                        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|120|-9|                        Set:idxList'="" idxList = idxList_","
L|Graph.KG.NKGAccelCentrality.1|121|-9|                        Set idxList = idxList_idx
L|Graph.KG.NKGAccelCentrality.1|122|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|123|-9|                    Set nkgVer = +$Get(^NKG("$meta","version"),-1)
L|Graph.KG.NKGAccelCentrality.1|124|-9|                    Set fnidG = $ZF(-4, 3, dllid, "kg_betweenness_global_v")
L|Graph.KG.NKGAccelCentrality.1|125|-9|                    If fnidG > 0 {
L|Graph.KG.NKGAccelCentrality.1|126|-9|                        Set warmRaw = $ZF(-5, dllid, fnidG, "^NKG", 1, 1, nkgVer)
L|Graph.KG.NKGAccelCentrality.1|127|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|128|-9|                    Set raw = $ZF(-5, dllid, fnidN, "^NKG", idxList, sampleSize, topK, nkgVer)
L|Graph.KG.NKGAccelCentrality.1|129|-9|                    If $Extract(raw,1,3) = "OK:" {
L|Graph.KG.NKGAccelCentrality.1|130|-9|                        Kill ^||nbhIdx, ^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|131|-9|                        Return raw
L|Graph.KG.NKGAccelCentrality.1|132|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|133|-9|                }
L|Graph.KG.NKGAccelCentrality.1|134|-9|            }
L|Graph.KG.NKGAccelCentrality.1|135|-9|        }
L|Graph.KG.NKGAccelCentrality.1|136|-9|    } Catch ex {
L|Graph.KG.NKGAccelCentrality.1|137|-9|    }
L|Graph.KG.NKGAccelCentrality.1|138|-9|    // OS fallback: $BITLOGIC parallel Brandes on subgraph
L|Graph.KG.NKGAccelCentrality.1|139|-9|    Quit ..BetweennessNeighborhoodOS(n, sampleSize, topK) }
L|Graph.KG.NKGAccelCentrality.1|140|-9|BetweennessNeighborhoodOS(n,sampleSize,topK) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|141|-9|    If n = 0 Quit "ERROR:no nodes"
L|Graph.KG.NKGAccelCentrality.1|142|-9|    Set srcCount = $Select((sampleSize>0)&&(sampleSize<n):sampleSize, 1:n)
L|Graph.KG.NKGAccelCentrality.1|143|-9|    Set scale = +$Number(n/srcCount,15)
L|Graph.KG.NKGAccelCentrality.1|144|-9|    Set parentPid = $Job
L|Graph.KG.NKGAccelCentrality.1|145|-9|    Kill ^bcParSrc(parentPid), ^bcParScore(parentPid), ^bcBitAdj(parentPid)
L|Graph.KG.NKGAccelCentrality.1|146|-9|    // Build $BIT adjacency restricted to neighborhood
L|Graph.KG.NKGAccelCentrality.1|147|-9|    Set idx = "", pos = 0
L|Graph.KG.NKGAccelCentrality.1|148|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|149|-9|        Set idx = $Order(^||nbhIdx(idx))
L|Graph.KG.NKGAccelCentrality.1|150|-9|        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|151|-9|        Set negP = $Order(^NKG(-1,idx,""))
L|Graph.KG.NKGAccelCentrality.1|152|-9|        While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|153|-9|            Set dstIdx = $Order(^NKG(-1,idx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|154|-9|            While dstIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|155|-9|                If $Data(^||nbhIdx(dstIdx)) {
L|Graph.KG.NKGAccelCentrality.1|156|-9|                    Set $BIT(^bcBitAdj(parentPid,idx),dstIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|157|-9|                    Set $BIT(^bcBitAdj(parentPid,dstIdx),idx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|158|-9|                }
L|Graph.KG.NKGAccelCentrality.1|159|-9|                Set dstIdx = $Order(^NKG(-1,idx,negP,dstIdx))
L|Graph.KG.NKGAccelCentrality.1|160|-9|            }
L|Graph.KG.NKGAccelCentrality.1|161|-9|            Set negP = $Order(^NKG(-1,idx,negP))
L|Graph.KG.NKGAccelCentrality.1|162|-9|        }
L|Graph.KG.NKGAccelCentrality.1|163|-9|    }
L|Graph.KG.NKGAccelCentrality.1|164|-9|    For si = 0:1:srcCount-1 {
L|Graph.KG.NKGAccelCentrality.1|165|-9|        Set ^bcParSrc(parentPid,si) = ^||nbhNodes(si)
L|Graph.KG.NKGAccelCentrality.1|166|-9|    }
L|Graph.KG.NKGAccelCentrality.1|167|-9|    Set numJobs = $System.Util.NumberOfCPUs()
L|Graph.KG.NKGAccelCentrality.1|168|-9|    If numJobs > 8 { Set numJobs = 8 }
L|Graph.KG.NKGAccelCentrality.1|169|-9|    If numJobs > srcCount { Set numJobs = srcCount }
L|Graph.KG.NKGAccelCentrality.1|170|-9|    Set queue = ##class(%SYSTEM.WorkMgr).%New("",numJobs)
L|Graph.KG.NKGAccelCentrality.1|171|-9|    Set chunkSize = srcCount\numJobs, remainder = srcCount#numJobs, cursor = 0
L|Graph.KG.NKGAccelCentrality.1|172|-9|    For w = 1:1:numJobs {
L|Graph.KG.NKGAccelCentrality.1|173|-9|        Set wSize = chunkSize + $Select(w<=remainder:1,1:0)
L|Graph.KG.NKGAccelCentrality.1|174|-9|        Set sc = queue.Queue("##class(Graph.KG.NKGAccel).BetweennessWorker",parentPid,w,cursor,cursor+wSize-1,scale)
L|Graph.KG.NKGAccelCentrality.1|175|-9|        Set cursor = cursor + wSize
L|Graph.KG.NKGAccelCentrality.1|176|-9|        If ('sc) {
L|Graph.KG.NKGAccelCentrality.1|177|-9|            Kill ^bcParSrc(parentPid),^bcParScore(parentPid),^bcBitAdj(parentPid),^||nbhIdx,^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|178|-9|            Quit "ERROR:Queue failed"
L|Graph.KG.NKGAccelCentrality.1|179|-9|        }
L|Graph.KG.NKGAccelCentrality.1|180|-9|    }
L|Graph.KG.NKGAccelCentrality.1|181|-9|    Do queue.Sync()
L|Graph.KG.NKGAccelCentrality.1|182|-9|    Kill ^bcParSrc(parentPid), ^bcBitAdj(parentPid)
L|Graph.KG.NKGAccelCentrality.1|183|-9|    Set json = "[", sep = "", cnt = 0
L|Graph.KG.NKGAccelCentrality.1|184|-9|    Set idx = ""
L|Graph.KG.NKGAccelCentrality.1|185|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|186|-9|        Set idx = $Order(^||nbhIdx(idx))
L|Graph.KG.NKGAccelCentrality.1|187|-9|        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|188|-9|        Set nid = $Get(^NKG("$ND",idx),"")
L|Graph.KG.NKGAccelCentrality.1|189|-9|        If nid = "" Continue
L|Graph.KG.NKGAccelCentrality.1|190|-9|        Set total = 0
L|Graph.KG.NKGAccelCentrality.1|191|-9|        For w = 1:1:numJobs { Set total = total + $Get(^bcParScore(parentPid,w,idx),0) }
L|Graph.KG.NKGAccelCentrality.1|192|-9|        If total = 0 Continue
L|Graph.KG.NKGAccelCentrality.1|193|-9|        Set json = json_sep_"{""id"":"""_nid_""",""score"":"_total_"}"
L|Graph.KG.NKGAccelCentrality.1|194|-9|        Set sep = ","
L|Graph.KG.NKGAccelCentrality.1|195|-9|        Set cnt = cnt+1
L|Graph.KG.NKGAccelCentrality.1|196|-9|        If (topK>0)&&(cnt>=topK) Quit
L|Graph.KG.NKGAccelCentrality.1|197|-9|    }
L|Graph.KG.NKGAccelCentrality.1|198|-9|    Kill ^bcParScore(parentPid), ^||nbhIdx, ^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|199|-9|    Quit "OK:"_json_"]" }
L|Graph.KG.NKGAccelCentrality.1|200|-9|BetweennessWorker(parentPid,workerN,srcFirst,srcLast,scale) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|201|-9|    Set n = +$Get(^NKG("$meta","nodeCount"),0)
L|Graph.KG.NKGAccelCentrality.1|202|-9|    If n = 0 Return 1
L|Graph.KG.NKGAccelCentrality.1|203|-9|    Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack, ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|204|-9|    For si = srcFirst:1:srcLast {
L|Graph.KG.NKGAccelCentrality.1|205|-9|        Set srcNid = $Get(^bcParSrc(parentPid, si),"")
L|Graph.KG.NKGAccelCentrality.1|206|-9|        If srcNid = "" Continue
L|Graph.KG.NKGAccelCentrality.1|207|-9|        Set sIdx = $Get(^NKG("$NI",srcNid),-1)
L|Graph.KG.NKGAccelCentrality.1|208|-9|        If sIdx = -1 Continue
L|Graph.KG.NKGAccelCentrality.1|209|-9|        Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack
L|Graph.KG.NKGAccelCentrality.1|210|-9|        Set ^||bwSigma(sIdx)=1, ^||bwDist(sIdx)=0
L|Graph.KG.NKGAccelCentrality.1|211|-9|        Set frontier = ""
L|Graph.KG.NKGAccelCentrality.1|212|-9|        Set $BIT(frontier, sIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|213|-9|        Set visited = frontier
L|Graph.KG.NKGAccelCentrality.1|214|-9|        Set stackTop = 0, bfsLevel = 0
L|Graph.KG.NKGAccelCentrality.1|215|-9|        Set ^||bwStack(0) = sIdx
L|Graph.KG.NKGAccelCentrality.1|216|-9|        While $BITCOUNT(frontier,1) > 0 {
L|Graph.KG.NKGAccelCentrality.1|217|-9|            Set bfsLevel = bfsLevel + 1
L|Graph.KG.NKGAccelCentrality.1|218|-9|            Set candidates = ""
L|Graph.KG.NKGAccelCentrality.1|219|-9|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|220|-9|            For {
L|Graph.KG.NKGAccelCentrality.1|221|-9|                Set pos = $BITFIND(frontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|222|-9|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|223|-9|                Set v = pos-1
L|Graph.KG.NKGAccelCentrality.1|224|-9|                If $Data(^bcBitAdj(parentPid,v)) {
L|Graph.KG.NKGAccelCentrality.1|225|-9|                    Set candidates = $BITLOGIC(candidates | ^bcBitAdj(parentPid,v))
L|Graph.KG.NKGAccelCentrality.1|226|-9|                }
L|Graph.KG.NKGAccelCentrality.1|227|-9|            }
L|Graph.KG.NKGAccelCentrality.1|228|-9|            Set newFrontier = $BITLOGIC(candidates & ~visited)
L|Graph.KG.NKGAccelCentrality.1|229|-9|            Quit:$BITCOUNT(newFrontier,1)=0
L|Graph.KG.NKGAccelCentrality.1|230|-9|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|231|-9|            For {
L|Graph.KG.NKGAccelCentrality.1|232|-9|                Set pos = $BITFIND(newFrontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|233|-9|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|234|-9|                Set w = pos-1
L|Graph.KG.NKGAccelCentrality.1|235|-9|                Set ^||bwDist(w) = bfsLevel
L|Graph.KG.NKGAccelCentrality.1|236|-9|                Set ^||bwSigma(w) = 0
L|Graph.KG.NKGAccelCentrality.1|237|-9|                Set stackTop = stackTop+1
L|Graph.KG.NKGAccelCentrality.1|238|-9|                Set ^||bwStack(stackTop) = w
L|Graph.KG.NKGAccelCentrality.1|239|-9|            }
L|Graph.KG.NKGAccelCentrality.1|240|-9|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|241|-9|            For {
L|Graph.KG.NKGAccelCentrality.1|242|-9|                Set pos = $BITFIND(frontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|243|-9|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|244|-9|                Set v = pos-1
L|Graph.KG.NKGAccelCentrality.1|245|-9|                If $Data(^bcBitAdj(parentPid,v)) {
L|Graph.KG.NKGAccelCentrality.1|246|-9|                    Set vToNew = $BITLOGIC(^bcBitAdj(parentPid,v) & newFrontier)
L|Graph.KG.NKGAccelCentrality.1|247|-9|                    Set pos2 = 0
L|Graph.KG.NKGAccelCentrality.1|248|-9|                    For {
L|Graph.KG.NKGAccelCentrality.1|249|-9|                        Set pos2 = $BITFIND(vToNew, 1, pos2+1)
L|Graph.KG.NKGAccelCentrality.1|250|-9|                        Quit:pos2=0
L|Graph.KG.NKGAccelCentrality.1|251|-9|                        Set w = pos2-1
L|Graph.KG.NKGAccelCentrality.1|252|-9|                        Set ^||bwSigma(w) = +$Number($Get(^||bwSigma(w),0)+$Get(^||bwSigma(v),1),15)
L|Graph.KG.NKGAccelCentrality.1|253|-9|                        Set ^||bwPred(w,v) = ""
L|Graph.KG.NKGAccelCentrality.1|254|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|255|-9|                }
L|Graph.KG.NKGAccelCentrality.1|256|-9|            }
L|Graph.KG.NKGAccelCentrality.1|257|-9|            Set visited = $BITLOGIC(visited | newFrontier)
L|Graph.KG.NKGAccelCentrality.1|258|-9|            Set frontier = newFrontier
L|Graph.KG.NKGAccelCentrality.1|259|-9|        }
L|Graph.KG.NKGAccelCentrality.1|260|-9|        Kill ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|261|-9|        Set wi = stackTop
L|Graph.KG.NKGAccelCentrality.1|262|-9|        While wi >= 0 {
L|Graph.KG.NKGAccelCentrality.1|263|-9|            Set wIdx = ^||bwStack(wi), wi = wi-1
L|Graph.KG.NKGAccelCentrality.1|264|-9|            Set v2 = $Order(^||bwPred(wIdx,""))
L|Graph.KG.NKGAccelCentrality.1|265|-9|            While v2 '= "" {
L|Graph.KG.NKGAccelCentrality.1|266|-9|                Set sv = +$Number($Get(^||bwSigma(v2),1),15)
L|Graph.KG.NKGAccelCentrality.1|267|-9|                Set sw = +$Number($Get(^||bwSigma(wIdx),1),15)
L|Graph.KG.NKGAccelCentrality.1|268|-9|                If sw > 0 {
L|Graph.KG.NKGAccelCentrality.1|269|-9|                    Set dv = +$Number($Get(^||bwDelta(v2),0),15)
L|Graph.KG.NKGAccelCentrality.1|270|-9|                    Set dw = +$Number($Get(^||bwDelta(wIdx),0),15)
L|Graph.KG.NKGAccelCentrality.1|271|-9|                    Set r  = +$Number(sv/sw,15)
L|Graph.KG.NKGAccelCentrality.1|272|-9|                    Set c  = +$Number(r*(1+dw),15)
L|Graph.KG.NKGAccelCentrality.1|273|-9|                    Set ^||bwDelta(v2) = +$Number(dv+c,15)
L|Graph.KG.NKGAccelCentrality.1|274|-9|                }
L|Graph.KG.NKGAccelCentrality.1|275|-9|                Set v2 = $Order(^||bwPred(wIdx,v2))
L|Graph.KG.NKGAccelCentrality.1|276|-9|            }
L|Graph.KG.NKGAccelCentrality.1|277|-9|            If wIdx '= sIdx {
L|Graph.KG.NKGAccelCentrality.1|278|-9|                Set d   = +$Number($Get(^||bwDelta(wIdx),0),15)
L|Graph.KG.NKGAccelCentrality.1|279|-9|                Set cur = $Get(^bcParScore(parentPid,workerN,wIdx),0)
L|Graph.KG.NKGAccelCentrality.1|280|-9|                Set ^bcParScore(parentPid,workerN,wIdx) = +$Number(cur + +$Number(d*scale,15),15)
L|Graph.KG.NKGAccelCentrality.1|281|-9|            }
L|Graph.KG.NKGAccelCentrality.1|282|-9|        }
L|Graph.KG.NKGAccelCentrality.1|283|-9|    }
L|Graph.KG.NKGAccelCentrality.1|284|-9|    Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack, ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|285|-9|    Return 1 }
L|Graph.KG.NKGAccelCentrality.1|286|-9|BuildBitAdj(parentPid) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|287|-9|    Kill ^bcBitAdj(parentPid)
L|Graph.KG.NKGAccelCentrality.1|288|-9|    Set srcIdx = ""
L|Graph.KG.NKGAccelCentrality.1|289|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|290|-9|        Set srcIdx = $Order(^NKG(-3,srcIdx))
L|Graph.KG.NKGAccelCentrality.1|291|-9|        Quit:srcIdx=""
L|Graph.KG.NKGAccelCentrality.1|292|-9|        Set negP = $Order(^NKG(-1,srcIdx,""))
L|Graph.KG.NKGAccelCentrality.1|293|-9|        While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|294|-9|            Set dstIdx = $Order(^NKG(-1,srcIdx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|295|-9|            While dstIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|296|-9|                Set $BIT(^bcBitAdj(parentPid,srcIdx), dstIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|297|-9|                Set dstIdx = $Order(^NKG(-1,srcIdx,negP,dstIdx))
L|Graph.KG.NKGAccelCentrality.1|298|-9|            }
L|Graph.KG.NKGAccelCentrality.1|299|-9|            Set negP = $Order(^NKG(-1,srcIdx,negP))
L|Graph.KG.NKGAccelCentrality.1|300|-9|        }
L|Graph.KG.NKGAccelCentrality.1|301|-9|    } }
L|Graph.KG.NKGAccelCentrality.1|302|-9|ClosenessGlobal(formula="harmonic",direction="out",maxHops=0,topK=10000) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|303|-9|    Set firstNode = $Order(^NKG("$NI",""))
L|Graph.KG.NKGAccelCentrality.1|304|-9|    If firstNode = "" Quit "ERROR:^NKG not built"
L|Graph.KG.NKGAccelCentrality.1|305|-9|    Set n = 0
L|Graph.KG.NKGAccelCentrality.1|306|-9|    Set nidTmp = ""
L|Graph.KG.NKGAccelCentrality.1|307|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|308|-9|        Set nidTmp = $Order(^NKG("$NI",nidTmp))
L|Graph.KG.NKGAccelCentrality.1|309|-9|        Quit:nidTmp=""
L|Graph.KG.NKGAccelCentrality.1|310|-9|        Set n = n + 1
L|Graph.KG.NKGAccelCentrality.1|311|-9|    }
L|Graph.KG.NKGAccelCentrality.1|312|-9|    If n = 0 { Quit "ERROR:^NKG nodeCount=0" }
L|Graph.KG.NKGAccelCentrality.1|313|-9|    Set json = "["
L|Graph.KG.NKGAccelCentrality.1|314|-9|    Set sep = ""
L|Graph.KG.NKGAccelCentrality.1|315|-9|    Set emitted = 0
L|Graph.KG.NKGAccelCentrality.1|316|-9|    Set nid = ""
L|Graph.KG.NKGAccelCentrality.1|317|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|318|-9|        Set nid = $Order(^NKG("$NI",nid))
L|Graph.KG.NKGAccelCentrality.1|319|-9|        Quit:nid=""
L|Graph.KG.NKGAccelCentrality.1|320|-9|        Set sIdx = ^NKG("$NI",nid)
L|Graph.KG.NKGAccelCentrality.1|321|-9|        Kill ^||bfsDist
L|Graph.KG.NKGAccelCentrality.1|322|-9|        Set ^||bfsDist(sIdx) = 0
L|Graph.KG.NKGAccelCentrality.1|323|-9|        Set queue = sIdx _ ","
L|Graph.KG.NKGAccelCentrality.1|324|-9|        Set qStart = 1, qLen = 1
L|Graph.KG.NKGAccelCentrality.1|325|-9|        Set hop = 0
L|Graph.KG.NKGAccelCentrality.1|326|-9|        While (qLen > 0) && ((maxHops = 0) || (hop < maxHops)) {
L|Graph.KG.NKGAccelCentrality.1|327|-9|            Set hop = hop + 1
L|Graph.KG.NKGAccelCentrality.1|328|-9|            Set newQueue = "", newLen = 0
L|Graph.KG.NKGAccelCentrality.1|329|-9|            For qi = 1:1:qLen {
L|Graph.KG.NKGAccelCentrality.1|330|-9|                Set vIdx = $Piece(queue,",",qi)
L|Graph.KG.NKGAccelCentrality.1|331|-9|                If direction = "in" {
L|Graph.KG.NKGAccelCentrality.1|332|-9|                    Set negP = $Order(^NKG(-2,vIdx,""))
L|Graph.KG.NKGAccelCentrality.1|333|-9|                    While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|334|-9|                        Set oIdx = $Order(^NKG(-2,vIdx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|335|-9|                        While oIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|336|-9|                            If '$Data(^||bfsDist(oIdx)) {
L|Graph.KG.NKGAccelCentrality.1|337|-9|                                Set ^||bfsDist(oIdx) = hop
L|Graph.KG.NKGAccelCentrality.1|338|-9|                                Set newQueue = newQueue_oIdx_","
L|Graph.KG.NKGAccelCentrality.1|339|-9|                                Set newLen = newLen + 1
L|Graph.KG.NKGAccelCentrality.1|340|-9|                            }
L|Graph.KG.NKGAccelCentrality.1|341|-9|                            Set oIdx = $Order(^NKG(-2,vIdx,negP,oIdx))
L|Graph.KG.NKGAccelCentrality.1|342|-9|                        }
L|Graph.KG.NKGAccelCentrality.1|343|-9|                        Set negP = $Order(^NKG(-2,vIdx,negP))
L|Graph.KG.NKGAccelCentrality.1|344|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|345|-9|                } Else {
L|Graph.KG.NKGAccelCentrality.1|346|-9|                    Set negP = $Order(^NKG(-1,vIdx,""))
L|Graph.KG.NKGAccelCentrality.1|347|-9|                    While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|348|-9|                        Set oIdx = $Order(^NKG(-1,vIdx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|349|-9|                        While oIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|350|-9|                            If '$Data(^||bfsDist(oIdx)) {
L|Graph.KG.NKGAccelCentrality.1|351|-9|                                Set ^||bfsDist(oIdx) = hop
L|Graph.KG.NKGAccelCentrality.1|352|-9|                                Set newQueue = newQueue_oIdx_","
L|Graph.KG.NKGAccelCentrality.1|353|-9|                                Set newLen = newLen + 1
L|Graph.KG.NKGAccelCentrality.1|354|-9|                            }
L|Graph.KG.NKGAccelCentrality.1|355|-9|                            Set oIdx = $Order(^NKG(-1,vIdx,negP,oIdx))
L|Graph.KG.NKGAccelCentrality.1|356|-9|                        }
L|Graph.KG.NKGAccelCentrality.1|357|-9|                        Set negP = $Order(^NKG(-1,vIdx,negP))
L|Graph.KG.NKGAccelCentrality.1|358|-9|                    }
L|Graph.KG.NKGAccelCentrality.1|359|-9|                }
L|Graph.KG.NKGAccelCentrality.1|360|-9|            }
L|Graph.KG.NKGAccelCentrality.1|361|-9|            Set queue = newQueue, qLen = newLen
L|Graph.KG.NKGAccelCentrality.1|362|-9|        }
L|Graph.KG.NKGAccelCentrality.1|363|-9|        Set sumDist = 0, sumInv = 0, reached = 0
L|Graph.KG.NKGAccelCentrality.1|364|-9|        Set uIdx = ""
L|Graph.KG.NKGAccelCentrality.1|365|-9|        For {
L|Graph.KG.NKGAccelCentrality.1|366|-9|            Set uIdx = $Order(^||bfsDist(uIdx))
L|Graph.KG.NKGAccelCentrality.1|367|-9|            Quit:uIdx=""
L|Graph.KG.NKGAccelCentrality.1|368|-9|            If uIdx = sIdx Continue
L|Graph.KG.NKGAccelCentrality.1|369|-9|            Set d = ^||bfsDist(uIdx)
L|Graph.KG.NKGAccelCentrality.1|370|-9|            Set sumDist = sumDist + d
L|Graph.KG.NKGAccelCentrality.1|371|-9|            Set sumInv = sumInv + (1 / d)
L|Graph.KG.NKGAccelCentrality.1|372|-9|            Set reached = reached + 1
L|Graph.KG.NKGAccelCentrality.1|373|-9|        }
L|Graph.KG.NKGAccelCentrality.1|374|-9|        If formula = "classical" {
L|Graph.KG.NKGAccelCentrality.1|375|-9|            // Classical (Bavelas) closeness is defined only when the node reaches
L|Graph.KG.NKGAccelCentrality.1|376|-9|            // every other node (reached = n-1). On a disconnected graph no node
L|Graph.KG.NKGAccelCentrality.1|377|-9|            // reaches the full graph, so score is 0 ? matches the standard
L|Graph.KG.NKGAccelCentrality.1|378|-9|            // (non-Wasserman-Faust) definition.
L|Graph.KG.NKGAccelCentrality.1|379|-9|            Set score = $Select((sumDist > 0) && (reached = (n - 1)): reached / sumDist, 1: 0)
L|Graph.KG.NKGAccelCentrality.1|380|-9|        } Else {
L|Graph.KG.NKGAccelCentrality.1|381|-9|            // Harmonic centrality: raw sum of 1/d ? matches networkx.harmonic_centrality default
L|Graph.KG.NKGAccelCentrality.1|382|-9|            Set score = $Select(reached > 0: sumInv, 1: 0)
L|Graph.KG.NKGAccelCentrality.1|383|-9|        }
L|Graph.KG.NKGAccelCentrality.1|384|-9|        If $Extract(score)="." Set score = "0"_score
L|Graph.KG.NKGAccelCentrality.1|385|-9|        If $Extract(score,1,2)="-." Set score = "-0"_$Extract(score,2,*)
L|Graph.KG.NKGAccelCentrality.1|386|-9|        Set json = json_sep_"{""id"":"""_nid_""",""score"":"_score_"}"
L|Graph.KG.NKGAccelCentrality.1|387|-9|        Set sep = ","
L|Graph.KG.NKGAccelCentrality.1|388|-9|        Set emitted = emitted + 1
L|Graph.KG.NKGAccelCentrality.1|389|-9|        If (topK > 0) && (emitted >= topK) Quit
L|Graph.KG.NKGAccelCentrality.1|390|-9|    }
L|Graph.KG.NKGAccelCentrality.1|391|-9|    Kill ^||bfsDist
L|Graph.KG.NKGAccelCentrality.1|392|-9|    Quit "OK:"_json_"]" }
L|Graph.KG.NKGAccelCentrality.1|393|-9|ClosenessGlobalMSBFS(formula="harmonic",direction="out",maxHops=0,topK=10000) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|394|-9|    Set firstNode = $Order(^NKG("$NI",""))
