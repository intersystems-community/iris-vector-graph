L|Graph.KG.TraversalBFS.1|315|0|            Set s = $ListGet(lb, 1)
L|Graph.KG.TraversalBFS.1|316|0|            Set p = $ListGet(lb, 2)
L|Graph.KG.TraversalBFS.1|317|0|            Set w = +$ListGet(lb, 3)
L|Graph.KG.TraversalBFS.1|318|0|            Set result = result _ "{""s"":"""_..jsonEsc(s)_""",""p"":"""_..jsonEsc(p)_""",""o"":"""_..jsonEsc(o)_""",""w"":"_..jsonNum(w)_",""step"":"_step_"}"
L|Graph.KG.TraversalBFS.1|319|0|        }
