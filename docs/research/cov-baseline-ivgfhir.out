L|Graph.KG.TraversalBFS.1|323|0|TraverseAllPredicates(pGraph,s,hop,maxHops,nextP,dstLabel,pathId,results,nextFrontier,seen) methodimpl {
L|Graph.KG.TraversalBFS.1|324|0|    Set p = ""
L|Graph.KG.TraversalBFS.1|325|0|    For {
L|Graph.KG.TraversalBFS.1|326|0|        Set p = $Order(^KG("out", pGraph, s, p))
L|Graph.KG.TraversalBFS.1|327|0|        If p = "" Quit
L|Graph.KG.TraversalBFS.1|328|0|        Do ..TraverseWithPredicate(pGraph, s, p, hop, maxHops, nextP, dstLabel, .pathId, results, .nextFrontier, .seen)
L|Graph.KG.TraversalBFS.1|329|0|    } }
L|Graph.KG.TraversalBFS.1|330|0|TraverseAllPredicatesFast(pGraph,s,hop,maxHops,nextP,dstLabel,count,nextFrontier,seen) methodimpl {
