L|Graph.KG.LedgerApply.1|451|-9|    If $Data(^KG("in", tGKey, pO, pP, pS)) Set ^KG("in", tGKey, pO, pP, pS) = tW
L|Graph.KG.LedgerApply.1|452|-9|    Set tmp = $Increment(^KG("__version"))
