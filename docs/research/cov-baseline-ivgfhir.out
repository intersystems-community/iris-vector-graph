L|Graph.KG.TemporalIndex.1|646|-9|			If o = "" Quit
L|Graph.KG.TemporalIndex.1|647|-9|			If target '= "" { If o '= target { Continue } }
L|Graph.KG.TemporalIndex.1|648|-9|			Set p = ""
L|Graph.KG.TemporalIndex.1|649|-9|			While 1 {
L|Graph.KG.TemporalIndex.1|650|-9|				Set p = $Order(^KG("tin", tGKey, ts, o, p))
L|Graph.KG.TemporalIndex.1|651|-9|				If p = "" Quit
L|Graph.KG.TemporalIndex.1|652|-9|				If predicate '= "" { If p '= predicate { Continue } }
L|Graph.KG.TemporalIndex.1|653|-9|				Set s = ""
L|Graph.KG.TemporalIndex.1|654|-9|				While 1 {
L|Graph.KG.TemporalIndex.1|655|-9|					Set s = $Order(^KG("tin", tGKey, ts, o, p, s), 1, w)
L|Graph.KG.TemporalIndex.1|656|-9|					If s = "" Quit
L|Graph.KG.TemporalIndex.1|657|-9|					If 'first Set result = result _ ","
L|Graph.KG.TemporalIndex.1|658|-9|					Set first = 0
L|Graph.KG.TemporalIndex.1|659|-9|					Set result = result _ "{""s"":""" _ ..jsonEsc(s) _ """,""p"":""" _ ..jsonEsc(p) _ """,""o"":""" _ ..jsonEsc(o) _ """,""ts"":" _ ts _ ",""w"":" _ ..jsonNum(w) _ "}"
L|Graph.KG.TemporalIndex.1|660|-9|				}
L|Graph.KG.TemporalIndex.1|661|-9|			}
L|Graph.KG.TemporalIndex.1|662|-9|		}
L|Graph.KG.TemporalIndex.1|663|-9|	}
L|Graph.KG.TemporalIndex.1|664|-9|	Return result _ "]" }
L|Graph.KG.TemporalIndex.1|665|-9|QueryWindowSources(graphId="",predicate,tsStart,tsEnd) methodimpl {
L|Graph.KG.TemporalIndex.1|666|-9|	Set tGKey = ##class(Graph.KG.GraphKey).ForIndex(graphId)
L|Graph.KG.TemporalIndex.1|667|-9|	Set tsStart = +tsStart
L|Graph.KG.TemporalIndex.1|668|-9|	Set tsEnd = +tsEnd
L|Graph.KG.TemporalIndex.1|669|-9|	Kill dedup
L|Graph.KG.TemporalIndex.1|670|-9|	Set ts = tsStart - 1
L|Graph.KG.TemporalIndex.1|671|-9|	While 1 {
L|Graph.KG.TemporalIndex.1|672|-9|		Set ts = $Order(^KG("tout", tGKey, ts))
L|Graph.KG.TemporalIndex.1|673|-9|		If ts = "" Quit
L|Graph.KG.TemporalIndex.1|674|-9|		If ts > tsEnd Quit
L|Graph.KG.TemporalIndex.1|675|-9|		Set s = ""
L|Graph.KG.TemporalIndex.1|676|-9|		While 1 {
L|Graph.KG.TemporalIndex.1|677|-9|			Set s = $Order(^KG("tout", tGKey, ts, s))
L|Graph.KG.TemporalIndex.1|678|-9|			If s = "" Quit
L|Graph.KG.TemporalIndex.1|679|-9|			If predicate = "" {
L|Graph.KG.TemporalIndex.1|680|-9|				Set dedup(s) = 1
L|Graph.KG.TemporalIndex.1|681|-9|			} Else {
L|Graph.KG.TemporalIndex.1|682|-9|				If $Data(^KG("tout", tGKey, ts, s, predicate)) Set dedup(s) = 1
L|Graph.KG.TemporalIndex.1|683|-9|			}
L|Graph.KG.TemporalIndex.1|684|-9|		}
L|Graph.KG.TemporalIndex.1|685|-9|	}
L|Graph.KG.TemporalIndex.1|686|-9|	Set result = "[", first = 1, src = ""
L|Graph.KG.TemporalIndex.1|687|-9|	For {
L|Graph.KG.TemporalIndex.1|688|-9|		Set src = $Order(dedup(src))
L|Graph.KG.TemporalIndex.1|689|-9|		Quit:(src = "")
L|Graph.KG.TemporalIndex.1|690|-9|		If 'first { Set result = result _ "," }
L|Graph.KG.TemporalIndex.1|691|-9|		Set first = 0
L|Graph.KG.TemporalIndex.1|692|-9|		Set result = result _ """" _ ..jsonEsc(src) _ """"
L|Graph.KG.TemporalIndex.1|693|-9|	}
L|Graph.KG.TemporalIndex.1|694|-9|	Return result _ "]" }
L|Graph.KG.TemporalIndex.1|695|-9|RebuildBucket(pGKey,pBucket) methodimpl {
L|Graph.KG.TemporalIndex.1|696|-9|	Set tDiv = $Select(..#TSUNIT="ms": ..#BUCKETMS, 1: ..#BUCKET)
L|Graph.KG.TemporalIndex.1|697|-9|	Set tFrom = pBucket * tDiv
L|Graph.KG.TemporalIndex.1|698|-9|	Set tTo = tFrom + tDiv - 1
L|Graph.KG.TemporalIndex.1|699|-9|	Kill ^KG("bucket", pGKey, pBucket)
L|Graph.KG.TemporalIndex.1|700|-9|	Kill ^KG("tagg", pGKey, pBucket)
L|Graph.KG.TemporalIndex.1|701|-9|	Set tTs = tFrom - 1
L|Graph.KG.TemporalIndex.1|702|-9|	For {
L|Graph.KG.TemporalIndex.1|703|-9|		Set tTs = $Order(^KG("tout", pGKey, tTs))
L|Graph.KG.TemporalIndex.1|704|-9|		Quit:tTs=""
L|Graph.KG.TemporalIndex.1|705|-9|		Quit:tTs>tTo
L|Graph.KG.TemporalIndex.1|706|-9|		Set tS = ""
L|Graph.KG.TemporalIndex.1|707|-9|		For {
L|Graph.KG.TemporalIndex.1|708|-9|			Set tS = $Order(^KG("tout", pGKey, tTs, tS))
L|Graph.KG.TemporalIndex.1|709|-9|			Quit:tS=""
L|Graph.KG.TemporalIndex.1|710|-9|			Set tP = ""
L|Graph.KG.TemporalIndex.1|711|-9|			For {
L|Graph.KG.TemporalIndex.1|712|-9|				Set tP = $Order(^KG("tout", pGKey, tTs, tS, tP))
L|Graph.KG.TemporalIndex.1|713|-9|				Quit:tP=""
L|Graph.KG.TemporalIndex.1|714|-9|				Set tO = ""
L|Graph.KG.TemporalIndex.1|715|-9|				For {
L|Graph.KG.TemporalIndex.1|716|-9|					Set tO = $Order(^KG("tout", pGKey, tTs, tS, tP, tO), 1, tW)
L|Graph.KG.TemporalIndex.1|717|-9|					Quit:tO=""
L|Graph.KG.TemporalIndex.1|718|-9|					Set tmp = $Increment(^KG("bucket", pGKey, pBucket, tS))
L|Graph.KG.TemporalIndex.1|719|-9|					Set tmp = $Increment(^KG("tagg", pGKey, pBucket, tS, tP, "count"))
L|Graph.KG.TemporalIndex.1|720|-9|					Set tmp = $Increment(^KG("tagg", pGKey, pBucket, tS, tP, "sum"), tW)
L|Graph.KG.TemporalIndex.1|721|-9|					If '$Data(^KG("tagg", pGKey, pBucket, tS, tP, "min")) || (tW < ^KG("tagg", pGKey, pBucket, tS, tP, "min")) {
L|Graph.KG.TemporalIndex.1|722|-9|						Set ^KG("tagg", pGKey, pBucket, tS, tP, "min") = tW
L|Graph.KG.TemporalIndex.1|723|-9|					}
L|Graph.KG.TemporalIndex.1|724|-9|					If '$Data(^KG("tagg", pGKey, pBucket, tS, tP, "max")) || (tW > ^KG("tagg", pGKey, pBucket, tS, tP, "max")) {
L|Graph.KG.TemporalIndex.1|725|-9|						Set ^KG("tagg", pGKey, pBucket, tS, tP, "max") = tW
L|Graph.KG.TemporalIndex.1|726|-9|					}
L|Graph.KG.TemporalIndex.1|727|-9|					Do ..UpdateHLL(pGKey, pBucket, tS, tP, tO)
L|Graph.KG.TemporalIndex.1|728|-9|				}
L|Graph.KG.TemporalIndex.1|729|-9|			}
L|Graph.KG.TemporalIndex.1|730|-9|		}
L|Graph.KG.TemporalIndex.1|731|-9|	}
L|Graph.KG.TemporalIndex.1|732|-9|	Quit }
L|Graph.KG.TemporalIndex.1|733|-9|RebuildBucketAggregate(pGraphKey,pBucket,pSource,pPredicate) methodimpl {
L|Graph.KG.TemporalIndex.1|734|-9|	Set tBucketDiv = $Select(..#TSUNIT="ms": ..#BUCKETMS, 1: ..#BUCKET)
L|Graph.KG.TemporalIndex.1|735|-9|	Set tTSLow = pBucket * tBucketDiv
L|Graph.KG.TemporalIndex.1|736|-9|	Set tTSHigh = tTSLow + tBucketDiv - 1
L|Graph.KG.TemporalIndex.1|737|-9|	Set tCount = 0, tSum = 0, tMin = "", tMax = ""
L|Graph.KG.TemporalIndex.1|738|-9|	Set tHLL = ..HLLEmpty()
L|Graph.KG.TemporalIndex.1|739|-9|	Set tTS = tTSLow - 1
L|Graph.KG.TemporalIndex.1|740|-9|	For {
L|Graph.KG.TemporalIndex.1|741|-9|		Set tTS = $Order(^KG("tout", pGraphKey, tTS))
L|Graph.KG.TemporalIndex.1|742|-9|		Quit:(tTS = "")||(tTS > tTSHigh)
L|Graph.KG.TemporalIndex.1|743|-9|		Set tO = ""
L|Graph.KG.TemporalIndex.1|744|-9|		For {
L|Graph.KG.TemporalIndex.1|745|-9|			Set tO = $Order(^KG("tout", pGraphKey, tTS, pSource, pPredicate, tO), 1, tW)
L|Graph.KG.TemporalIndex.1|746|-9|			Quit:tO=""
L|Graph.KG.TemporalIndex.1|747|-9|			Set tCount = tCount + 1
L|Graph.KG.TemporalIndex.1|748|-9|			Set tSum = tSum + tW
L|Graph.KG.TemporalIndex.1|749|-9|			If (tMin = "") || (+tW < tMin) { Set tMin = +tW }
L|Graph.KG.TemporalIndex.1|750|-9|			If (tMax = "") || (+tW > tMax) { Set tMax = +tW }
L|Graph.KG.TemporalIndex.1|751|-9|			Do ..HLLAdd(.tHLL, tO)
L|Graph.KG.TemporalIndex.1|752|-9|		}
L|Graph.KG.TemporalIndex.1|753|-9|	}
L|Graph.KG.TemporalIndex.1|754|-9|	If tCount = 0 {
L|Graph.KG.TemporalIndex.1|755|-9|		Kill ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate)
L|Graph.KG.TemporalIndex.1|756|-9|		Quit
L|Graph.KG.TemporalIndex.1|757|-9|	}
L|Graph.KG.TemporalIndex.1|758|-9|	Set ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate, "count") = tCount
L|Graph.KG.TemporalIndex.1|759|-9|	Set ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate, "sum") = tSum
L|Graph.KG.TemporalIndex.1|760|-9|	Set ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate, "min") = tMin
L|Graph.KG.TemporalIndex.1|761|-9|	Set ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate, "max") = tMax
L|Graph.KG.TemporalIndex.1|762|-9|	Set ^KG("tagg", pGraphKey, pBucket, pSource, pPredicate, "hll") = tHLL }
L|Graph.KG.TemporalIndex.1|763|-9|ResolveLabelSet(hash) methodimpl {
L|Graph.KG.TemporalIndex.1|764|-9|	Return $Get(^KG("labelset", hash), "") }
L|Graph.KG.TemporalIndex.1|765|-9|UpdateHLL(graphKey,bucket,source,predicate,value) methodimpl {
L|Graph.KG.TemporalIndex.1|766|-9|	Set hll = $Get(^KG("tagg", graphKey, bucket, source, predicate, "hll"), ..HLLEmpty())
L|Graph.KG.TemporalIndex.1|767|-9|	Set before = hll
L|Graph.KG.TemporalIndex.1|768|-9|	Do ..HLLAdd(.hll, value)
L|Graph.KG.TemporalIndex.1|769|-9|	If hll '= before {
L|Graph.KG.TemporalIndex.1|770|-9|		Set ^KG("tagg", graphKey, bucket, source, predicate, "hll") = hll
L|Graph.KG.TemporalIndex.1|771|-9|	} }
L|Graph.KG.TemporalIndex.1|772|-9|WriteStores(pGKey,pTs,pS,pP,pO,pW,pSuppR=0,pMode="insert",pAttrs="") methodimpl {
L|Graph.KG.TemporalIndex.1|773|-9|	If pMode = "skip" && $Data(^KG("tout", pGKey, pTs, pS, pP, pO)) { Return 0 }
L|Graph.KG.TemporalIndex.1|774|-9|	If pMode = "update" {
L|Graph.KG.TemporalIndex.1|775|-9|		Kill ^KG("edgeprop", pGKey, pTs, pS, pP, pO)
L|Graph.KG.TemporalIndex.1|776|-9|	}
L|Graph.KG.TemporalIndex.1|777|-9|	Set ^KG("tout", pGKey, pTs, pS, pP, pO) = pW
L|Graph.KG.TemporalIndex.1|778|-9|	If 'pSuppR { Set ^KG("tin", pGKey, pTs, pO, pP, pS) = pW }
L|Graph.KG.TemporalIndex.1|779|-9|	Set tBucketDiv = $Select(..#TSUNIT="ms": ..#BUCKETMS, 1: ..#BUCKET)
L|Graph.KG.TemporalIndex.1|780|-9|	Set tBucket = pTs \ tBucketDiv
L|Graph.KG.TemporalIndex.1|781|-9|	Set tmp = $Increment(^KG("bucket", pGKey, tBucket, pS))
L|Graph.KG.TemporalIndex.1|782|-9|	// Structural adjacency shadow, in this graph, so BFS and traversal see the
L|Graph.KG.TemporalIndex.1|783|-9|	// edge. Owned by EdgeScan: writing the four stores here incremented
L|Graph.KG.TemporalIndex.1|784|-9|	// ^KG("deg") once per timestamp against a single ^KG("out") entry, so the
L|Graph.KG.TemporalIndex.1|785|-9|	// degree over-counted every triple carrying more than one timestamp, and
L|Graph.KG.TemporalIndex.1|786|-9|	// ^KG("degp") was never written at all.
L|Graph.KG.TemporalIndex.1|787|-9|	Do ##class(Graph.KG.EdgeScan).WriteAdjacencyShadow(pS, pP, pO, pW, pGKey)
L|Graph.KG.TemporalIndex.1|788|-9|	// count and sum are atomic via $Increment
L|Graph.KG.TemporalIndex.1|789|-9|	Set tmp = $Increment(^KG("tagg", pGKey, tBucket, pS, pP, "count"))
L|Graph.KG.TemporalIndex.1|790|-9|	Set tmp = $Increment(^KG("tagg", pGKey, tBucket, pS, pP, "sum"), pW)
L|Graph.KG.TemporalIndex.1|791|-9|	If '$Data(^KG("tagg", pGKey, tBucket, pS, pP, "min")) || (pW < ^KG("tagg", pGKey, tBucket, pS, pP, "min")) {
L|Graph.KG.TemporalIndex.1|792|-9|		Set ^KG("tagg", pGKey, tBucket, pS, pP, "min") = pW
L|Graph.KG.TemporalIndex.1|793|-9|	}
L|Graph.KG.TemporalIndex.1|794|-9|	If '$Data(^KG("tagg", pGKey, tBucket, pS, pP, "max")) || (pW > ^KG("tagg", pGKey, tBucket, pS, pP, "max")) {
L|Graph.KG.TemporalIndex.1|795|-9|		Set ^KG("tagg", pGKey, tBucket, pS, pP, "max") = pW
L|Graph.KG.TemporalIndex.1|796|-9|	}
L|Graph.KG.TemporalIndex.1|797|-9|	Do ..UpdateHLL(pGKey, tBucket, pS, pP, pO)
L|Graph.KG.TemporalIndex.1|798|-9|	If $IsObject(pAttrs) {
L|Graph.KG.TemporalIndex.1|799|-9|		Set iter = pAttrs.%GetIterator()
L|Graph.KG.TemporalIndex.1|800|-9|		While iter.%GetNext(.key, .val) {
L|Graph.KG.TemporalIndex.1|801|-9|			Set ^KG("edgeprop", pGKey, pTs, pS, pP, pO, key) = val
L|Graph.KG.TemporalIndex.1|802|-9|		}
L|Graph.KG.TemporalIndex.1|803|-9|	}
L|Graph.KG.TemporalIndex.1|804|-9|	Return 1 }
L|Graph.KG.TemporalIndex.1|805|-9|jsonEsc(pValue) methodimpl {
L|Graph.KG.TemporalIndex.1|806|-9|	// RFC 8259 ?7: U+0000?U+001F must be escaped. Named escapes for the 5
L|Graph.KG.TemporalIndex.1|807|-9|	// common ones; \uXXXX for the rest (NUL, SOH ? ETB, EM ? US).
L|Graph.KG.TemporalIndex.1|808|-9|	Set result = $Replace(pValue, "\", "\\")
L|Graph.KG.TemporalIndex.1|809|-9|	Set result = $Replace(result, """", "\""")
