L|Graph.KG.NKGAccelCentrality.1|441|-9|                Set w = wpos-1
L|Graph.KG.NKGAccelCentrality.1|442|-9|                Set nxw = $Get(^||msNext(w))
L|Graph.KG.NKGAccelCentrality.1|443|-9|                Set ^||msNext(w) = $BITLOGIC(nxw|vb)
L|Graph.KG.NKGAccelCentrality.1|444|-9|                Set anyFrontier = 1
