L|Graph.KG.LedgerApply.1|249|-9|    }
L|Graph.KG.LedgerApply.1|250|-9|    If tRS.%SQLCODE < 0 Return "insert relationship failed: " _ tRS.%Message
L|Graph.KG.LedgerApply.1|251|-9|    Set tStmt = ..AllocStmt(tSeq, tS, tP, tO, tG, .pFirst, .pLast)
