L|Graph.KG.NKGAccelAdjacency.1|95|0|ExportAdjacencyKG() methodimpl {
L|Graph.KG.NKGAccelAdjacency.1|96|0|    // Pass 1: assign integer indices to all nodes
L|Graph.KG.NKGAccelAdjacency.1|97|0|    Kill ^||nodeIdx
L|Graph.KG.NKGAccelAdjacency.1|98|0|    Set n = 0, node = ""
L|Graph.KG.NKGAccelAdjacency.1|99|0|    For {
L|Graph.KG.NKGAccelAdjacency.1|100|0|        Set node = $Order(^KG("deg", node))
L|Graph.KG.NKGAccelAdjacency.1|101|0|        Quit:node=""
L|Graph.KG.NKGAccelAdjacency.1|102|0|        Set ^||nodeIdx(node) = n
L|Graph.KG.NKGAccelAdjacency.1|103|0|        Set ^||nodeMap(n) = node
