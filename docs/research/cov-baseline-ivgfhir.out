L|Graph.KG.Communities.1|315|-9|        If (topK > 0) && (emitted >= topK) Quit
L|Graph.KG.Communities.1|316|-9|    }
L|Graph.KG.Communities.1|317|-9|    Kill ^||ccIndex, ^||ccLow, ^||ccOnStk, ^||ccSccStk, ^||ccComp, ^||ccFrame, ^||ccCompSort, ^||ccNbr, ^||ccNbrN
L|Graph.KG.Communities.1|318|-9|    Quit "OK:" _ json _ "]" }
L|Graph.KG.Communities.1|319|-9|TriangleCountJson(topK=10000) methodimpl {
L|Graph.KG.Communities.1|320|-9|    If $Order(^NKG("$NI", "")) = "" Return "ERROR:^NKG not built"
L|Graph.KG.Communities.1|321|-9|    Do ..BuildSymAdj()
L|Graph.KG.Communities.1|322|-9|    Kill ^||ccTri
L|Graph.KG.Communities.1|323|-9|    Set idx = ""
L|Graph.KG.Communities.1|324|-9|    For {
L|Graph.KG.Communities.1|325|-9|        Set idx = $Order(^||ccAdj(idx))
L|Graph.KG.Communities.1|326|-9|        Quit:idx=""
L|Graph.KG.Communities.1|327|-9|        Set deg = 0, tri = 0
L|Graph.KG.Communities.1|328|-9|        Set v = ""
L|Graph.KG.Communities.1|329|-9|        For {
L|Graph.KG.Communities.1|330|-9|            Set v = $Order(^||ccAdj(idx, v))
L|Graph.KG.Communities.1|331|-9|            Quit:v=""
L|Graph.KG.Communities.1|332|-9|            Set deg = deg + 1
L|Graph.KG.Communities.1|333|-9|        }
L|Graph.KG.Communities.1|334|-9|        Set v = ""
L|Graph.KG.Communities.1|335|-9|        For {
L|Graph.KG.Communities.1|336|-9|            Set v = $Order(^||ccAdj(idx, v))
L|Graph.KG.Communities.1|337|-9|            Quit:v=""
L|Graph.KG.Communities.1|338|-9|            Set w = ""
L|Graph.KG.Communities.1|339|-9|            For {
L|Graph.KG.Communities.1|340|-9|                Set w = $Order(^||ccAdj(idx, w))
L|Graph.KG.Communities.1|341|-9|                Quit:w=""
L|Graph.KG.Communities.1|342|-9|                If w '> v Continue
L|Graph.KG.Communities.1|343|-9|                If $Data(^||ccAdj(v, w)) Set tri = tri + 1
L|Graph.KG.Communities.1|344|-9|            }
L|Graph.KG.Communities.1|345|-9|        }
L|Graph.KG.Communities.1|346|-9|        Set lcc = 0
L|Graph.KG.Communities.1|347|-9|        If deg > 1 Set lcc = +$Number((2 * tri) / (deg * (deg - 1)), 15)
L|Graph.KG.Communities.1|348|-9|        Set ^||ccTri(-tri, idx) = $LB(tri, lcc, deg)
L|Graph.KG.Communities.1|349|-9|    }
L|Graph.KG.Communities.1|350|-9|    Set json = "[", sep = "", emitted = 0
L|Graph.KG.Communities.1|351|-9|    Set negTri = ""
L|Graph.KG.Communities.1|352|-9|    For {
L|Graph.KG.Communities.1|353|-9|        Set negTri = $Order(^||ccTri(negTri))
