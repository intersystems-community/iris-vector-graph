L|Graph.KG.NKGAccelTraversal.1|126|0|            // Graph.KG.TraversalBuild builds the scoped store per graph from
L|Graph.KG.NKGAccelTraversal.1|127|0|            // ^KG("out", graph, ...) instead.
L|Graph.KG.NKGAccelTraversal.1|128|0|            Set ^KG("deg2p_exact_merged", s, p) = cnt
L|Graph.KG.NKGAccelTraversal.1|129|0|        }
L|Graph.KG.NKGAccelTraversal.1|130|0|     }
L|Graph.KG.NKGAccelTraversal.1|131|0|     Return 1 }
