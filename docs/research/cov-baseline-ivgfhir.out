L|Graph.KG.Communities.1|212|-9|MaterializeNbrs(idx) methodimpl {
L|Graph.KG.Communities.1|213|-9|    If $Data(^||ccNbrN(idx)) Quit
L|Graph.KG.Communities.1|214|-9|    Set k = 0
L|Graph.KG.Communities.1|215|-9|    Set negP = ""
L|Graph.KG.Communities.1|216|-9|    For {
L|Graph.KG.Communities.1|217|-9|        Set negP = $Order(^NKG(-1, idx, negP))
