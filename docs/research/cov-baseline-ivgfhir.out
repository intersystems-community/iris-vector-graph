L|Graph.KG.Communities.1|112|-9|        }
L|Graph.KG.Communities.1|113|-9|        Set ^||ccKi(idx) = ki
L|Graph.KG.Communities.1|114|-9|        Set ^||ccComm(idx) = idx
L|Graph.KG.Communities.1|115|-9|        Set ^||ccCommTot(idx) = ki
L|Graph.KG.Communities.1|116|-9|        Set m2 = m2 + ki
L|Graph.KG.Communities.1|117|-9|    }
L|Graph.KG.Communities.1|118|-9|    If m2 = 0 {
L|Graph.KG.Communities.1|119|-9|        Set json = "[", sep = "", emitted = 0
L|Graph.KG.Communities.1|120|-9|        Set idx = ""
L|Graph.KG.Communities.1|121|-9|        For {
L|Graph.KG.Communities.1|122|-9|            Set idx = $Order(^NKG("$NI", idx), 1, ix)
L|Graph.KG.Communities.1|123|-9|            Quit:idx=""
L|Graph.KG.Communities.1|124|-9|            Set json = json _ sep _ "{""id"":""" _ idx _ """,""community"":0,""size"":1}"
L|Graph.KG.Communities.1|125|-9|            Set sep = ","
L|Graph.KG.Communities.1|126|-9|        }
L|Graph.KG.Communities.1|127|-9|        Kill ^||ccAdj, ^||ccComm, ^||ccKi, ^||ccCommTot
L|Graph.KG.Communities.1|128|-9|        Quit "OK:" _ json _ "]"
L|Graph.KG.Communities.1|129|-9|    }
L|Graph.KG.Communities.1|130|-9|    Set level = 0, changed = 1
L|Graph.KG.Communities.1|131|-9|    While (level < maxLevels) && changed {
L|Graph.KG.Communities.1|132|-9|        Set level = level + 1, changed = 0
L|Graph.KG.Communities.1|133|-9|        Set idx = ""
L|Graph.KG.Communities.1|134|-9|        For {
L|Graph.KG.Communities.1|135|-9|            Set idx = $Order(^||ccAdj(idx))
L|Graph.KG.Communities.1|136|-9|            Quit:idx=""
L|Graph.KG.Communities.1|137|-9|            Set curComm = ^||ccComm(idx)
L|Graph.KG.Communities.1|138|-9|            Set ki = ^||ccKi(idx)
L|Graph.KG.Communities.1|139|-9|            Kill ^||ccLinks
L|Graph.KG.Communities.1|140|-9|            Set v = ""
L|Graph.KG.Communities.1|141|-9|            For {
L|Graph.KG.Communities.1|142|-9|                Set v = $Order(^||ccAdj(idx, v))
L|Graph.KG.Communities.1|143|-9|                Quit:v=""
L|Graph.KG.Communities.1|144|-9|                Set vc = ^||ccComm(v)
L|Graph.KG.Communities.1|145|-9|                Set ^||ccLinks(vc) = +$Get(^||ccLinks(vc), 0) + 1
L|Graph.KG.Communities.1|146|-9|            }
L|Graph.KG.Communities.1|147|-9|            Set ^||ccCommTot(curComm) = ^||ccCommTot(curComm) - ki
L|Graph.KG.Communities.1|148|-9|            Set bestComm = curComm, bestGain = 0
L|Graph.KG.Communities.1|149|-9|            Set kiInCur = +$Get(^||ccLinks(curComm), 0)
L|Graph.KG.Communities.1|150|-9|            Set vc = ""
L|Graph.KG.Communities.1|151|-9|            For {
L|Graph.KG.Communities.1|152|-9|                Set vc = $Order(^||ccLinks(vc), 1, kiIn)
L|Graph.KG.Communities.1|153|-9|                Quit:vc=""
L|Graph.KG.Communities.1|154|-9|                Set totC = +$Get(^||ccCommTot(vc), 0)
L|Graph.KG.Communities.1|155|-9|                Set gain = +$Number(kiIn - (gamma * ki * totC / m2), 15)
L|Graph.KG.Communities.1|156|-9|                If gain > bestGain {
L|Graph.KG.Communities.1|157|-9|                    Set bestGain = gain
L|Graph.KG.Communities.1|158|-9|                    Set bestComm = vc
L|Graph.KG.Communities.1|159|-9|                }
L|Graph.KG.Communities.1|160|-9|            }
L|Graph.KG.Communities.1|161|-9|            Set ^||ccCommTot(bestComm) = +$Get(^||ccCommTot(bestComm), 0) + ki
L|Graph.KG.Communities.1|162|-9|            If bestComm '= curComm {
L|Graph.KG.Communities.1|163|-9|                Set ^||ccComm(idx) = bestComm
L|Graph.KG.Communities.1|164|-9|                Set changed = 1
L|Graph.KG.Communities.1|165|-9|            }
L|Graph.KG.Communities.1|166|-9|        }
L|Graph.KG.Communities.1|167|-9|    }
