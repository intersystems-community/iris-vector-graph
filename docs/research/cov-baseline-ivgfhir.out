L|Graph.KG.Communities.1|355|-9|        Set idx = ""
L|Graph.KG.Communities.1|356|-9|        For {
L|Graph.KG.Communities.1|357|-9|            Set idx = $Order(^||ccTri(negTri, idx), 1, data)
L|Graph.KG.Communities.1|358|-9|            Quit:idx=""
L|Graph.KG.Communities.1|359|-9|            Set nid = $Get(^NKG("$ND", idx), idx)
L|Graph.KG.Communities.1|360|-9|            Set tri = $List(data, 1), lcc = $List(data, 2)
L|Graph.KG.Communities.1|361|-9|            Set json = json _ sep _ "{""id"":""" _ nid _ """,""triangles"":" _ tri _ ",""lcc"":" _ lcc _ "}"
L|Graph.KG.Communities.1|362|-9|            Set sep = ","
L|Graph.KG.Communities.1|363|-9|            Set emitted = emitted + 1
