L|Graph.KG.NKGAccelCentrality.1|483|-9|            Set fdist = $Get(^||msFar(sIdx),0)
L|Graph.KG.NKGAccelCentrality.1|484|-9|            Set score = $Select((fdist>0)&&(reached=(n-1)): reached/fdist, 1: 0)
L|Graph.KG.NKGAccelCentrality.1|485|-9|        } Else {
L|Graph.KG.NKGAccelCentrality.1|486|-9|            Set score = $Get(^||msFar(sIdx),0)
L|Graph.KG.NKGAccelCentrality.1|487|-9|        }
L|Graph.KG.NKGAccelCentrality.1|488|-9|        If $Extract(score)="." Set score = "0"_score
L|Graph.KG.NKGAccelCentrality.1|489|-9|        If $Extract(score,1,2)="-." Set score = "-0"_$Extract(score,2,*)
L|Graph.KG.NKGAccelCentrality.1|490|-9|        Set json = json_sep_"{""id"":"""_snid_""",""score"":"_score_"}"
L|Graph.KG.NKGAccelCentrality.1|491|-9|        Set sep = ","
