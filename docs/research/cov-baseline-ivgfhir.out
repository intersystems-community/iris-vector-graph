L|Graph.KG.TraversalBFS.1|257|0|ReadBFSPage(tag,cursorStep,cursorO,pageSize=500) methodimpl {
L|Graph.KG.TraversalBFS.1|258|0|    Set result = ""
L|Graph.KG.TraversalBFS.1|259|0|    Set count = 0
L|Graph.KG.TraversalBFS.1|260|0|    Set nextStep = ""
L|Graph.KG.TraversalBFS.1|261|0|    Set nextO = ""
L|Graph.KG.TraversalBFS.1|262|0|    Set step = cursorStep
L|Graph.KG.TraversalBFS.1|263|0|    Set o = cursorO
L|Graph.KG.TraversalBFS.1|264|0|    If step = "" {
L|Graph.KG.TraversalBFS.1|265|0|        Set step = $Order(^ArnoKG("bfs_r", tag, ""))
L|Graph.KG.TraversalBFS.1|266|0|        Set o = ""
L|Graph.KG.TraversalBFS.1|267|0|    }
L|Graph.KG.TraversalBFS.1|268|0|    If step = "" {
L|Graph.KG.TraversalBFS.1|269|0|        Kill ^ArnoKG("bfs_r", tag)
L|Graph.KG.TraversalBFS.1|270|0|        Return "{""items"":[],""next_step"":-1,""next_o"":"""",""done"":true}"
L|Graph.KG.TraversalBFS.1|271|0|    }
L|Graph.KG.TraversalBFS.1|272|0|    For {
L|Graph.KG.TraversalBFS.1|273|0|        Quit:step=""
L|Graph.KG.TraversalBFS.1|274|0|        Set o = $Order(^ArnoKG("bfs_r", tag, step, o), 1, lb)
L|Graph.KG.TraversalBFS.1|275|0|        If o = "" {
L|Graph.KG.TraversalBFS.1|276|0|            Set step = $Order(^ArnoKG("bfs_r", tag, step))
L|Graph.KG.TraversalBFS.1|277|0|            Set o = ""
L|Graph.KG.TraversalBFS.1|278|0|            Continue
L|Graph.KG.TraversalBFS.1|279|0|        }
L|Graph.KG.TraversalBFS.1|280|0|        Set s = $ListGet(lb, 1)
L|Graph.KG.TraversalBFS.1|281|0|        Set p = $ListGet(lb, 2)
L|Graph.KG.TraversalBFS.1|282|0|        Set w = +$ListGet(lb, 3)
L|Graph.KG.TraversalBFS.1|283|0|        Set entry = "{""s"":"""_..jsonEsc(s)_""",""p"":"""_..jsonEsc(p)_""",""o"":"""_..jsonEsc(o)_""",""w"":"_..jsonNum(w)_",""step"":"_step_"}"
L|Graph.KG.TraversalBFS.1|284|0|        If result '= "" Set result = result _ ","
L|Graph.KG.TraversalBFS.1|285|0|        Set result = result _ entry
L|Graph.KG.TraversalBFS.1|286|0|        Set count = count + 1
L|Graph.KG.TraversalBFS.1|287|0|        If count >= pageSize {
L|Graph.KG.TraversalBFS.1|288|0|            Set nextO = $Order(^ArnoKG("bfs_r", tag, step, o))
L|Graph.KG.TraversalBFS.1|289|0|            If nextO = "" {
L|Graph.KG.TraversalBFS.1|290|0|                Set nextStep = $Order(^ArnoKG("bfs_r", tag, step))
L|Graph.KG.TraversalBFS.1|291|0|                Set nextO = ""
L|Graph.KG.TraversalBFS.1|292|0|            } Else {
L|Graph.KG.TraversalBFS.1|293|0|                Set nextStep = step
L|Graph.KG.TraversalBFS.1|294|0|            }
L|Graph.KG.TraversalBFS.1|295|0|            Set stepVal = $Select(nextStep="":"-1",1:nextStep)
L|Graph.KG.TraversalBFS.1|296|0|            Set oVal = """"_$Replace(nextO,"""","\""")_""""
L|Graph.KG.TraversalBFS.1|297|0|            Return "{""items"":["_result_"],""next_step"":"_stepVal_",""next_o"":"_oVal_",""done"":false}"
L|Graph.KG.TraversalBFS.1|298|0|        }
L|Graph.KG.TraversalBFS.1|299|0|    }
L|Graph.KG.TraversalBFS.1|300|0|    Kill ^ArnoKG("bfs_r", tag)
L|Graph.KG.TraversalBFS.1|301|0|    Return "{""items"":["_result_"],""next_step"":-1,""next_o"":"""",""done"":true}" }
L|Graph.KG.TraversalBFS.1|302|0|ReadBFSResults(tag) methodimpl {
L|Graph.KG.TraversalBFS.1|303|0|    Set result = "["
L|Graph.KG.TraversalBFS.1|304|0|    Set first = 1
