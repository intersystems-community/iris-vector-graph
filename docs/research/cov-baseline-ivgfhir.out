L|Graph.KG.NKGAccelCentrality.1|452|-9|            Quit:w=""
L|Graph.KG.NKGAccelCentrality.1|453|-9|            Set nb = ^||msNext(w)
L|Graph.KG.NKGAccelCentrality.1|454|-9|            Set seenw = $Get(^||msSeen(w))
L|Graph.KG.NKGAccelCentrality.1|455|-9|            Set new = $BITLOGIC(nb&~seenw)
L|Graph.KG.NKGAccelCentrality.1|456|-9|            If $BITCOUNT(new,1)=0 Continue
