L|Graph.KG.NKGAccelCentrality.1|479|-9|        Quit:sIdx=""
L|Graph.KG.NKGAccelCentrality.1|480|-9|        Set snid = ^||msIdxNid(sIdx)
L|Graph.KG.NKGAccelCentrality.1|481|-9|        If formula = "classical" {
