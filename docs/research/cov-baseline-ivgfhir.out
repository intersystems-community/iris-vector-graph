L|Graph.KG.NKGAccelTraversal.1|401|0|PPRJson(seedId,alpha,maxIter=20) methodimpl { s:'($d(alpha)#2) alpha=0.85
L|Graph.KG.NKGAccelTraversal.1|402|0|    Return ##class(Graph.KG.NKGAccelAdjacency).StoreLargeOut("PPR", ..PPRNative(seedId, alpha, maxIter))
L|Graph.KG.NKGAccelTraversal.1|403|0|}
L|Graph.KG.NKGAccelTraversal.1|404|0|PPRNative(seedId,alpha,maxIter=20,topK=20) methodimpl { s:'($d(alpha)#2) alpha=0.85
L|Graph.KG.NKGAccelTraversal.1|405|0|    Set useNKG = ##class(Graph.KG.NKGAccelLoader).UseNKG()
L|Graph.KG.NKGAccelTraversal.1|406|0|    // Initialize: collect seed's local neighborhood (2-hop)
L|Graph.KG.NKGAccelTraversal.1|407|0|    // and run PPR only on the subgraph
L|Graph.KG.NKGAccelTraversal.1|408|0|    Set khJson = ..KHopNeighbors(seedId, 2, 5000)
L|Graph.KG.NKGAccelTraversal.1|409|0|    Set kh = ##class(%Library.DynamicObject).%FromJSON(khJson)
L|Graph.KG.NKGAccelTraversal.1|410|0|    If kh.%IsDefined("error") Return khJson
L|Graph.KG.NKGAccelTraversal.1|411|0|    // Build local adjacency from the visited nodes
L|Graph.KG.NKGAccelTraversal.1|412|0|    Kill ^||pprAdj, ^||pprScore, ^||pprNext
L|Graph.KG.NKGAccelTraversal.1|413|0|    Set nodes = kh.nodes
L|Graph.KG.NKGAccelTraversal.1|414|0|    Set n = nodes.%Size()
L|Graph.KG.NKGAccelTraversal.1|415|0|    // Index the local nodes
L|Graph.KG.NKGAccelTraversal.1|416|0|    Kill ^||localIdx
L|Graph.KG.NKGAccelTraversal.1|417|0|    For i = 0:1:n-1 {
L|Graph.KG.NKGAccelTraversal.1|418|0|        Set nodeId = nodes.%Get(i).id
L|Graph.KG.NKGAccelTraversal.1|419|0|        Set ^||localIdx(nodeId) = i
L|Graph.KG.NKGAccelTraversal.1|420|0|    }
L|Graph.KG.NKGAccelTraversal.1|421|0|    // Build local adjacency
L|Graph.KG.NKGAccelTraversal.1|422|0|    For i = 0:1:n-1 {
L|Graph.KG.NKGAccelTraversal.1|423|0|        Set nodeId = nodes.%Get(i).id
L|Graph.KG.NKGAccelTraversal.1|424|0|        Set deg = 0
L|Graph.KG.NKGAccelTraversal.1|425|0|        If useNKG {
L|Graph.KG.NKGAccelTraversal.1|426|0|            Set nkgIdx = $Get(^NKG("$NI", nodeId), "")
L|Graph.KG.NKGAccelTraversal.1|427|0|            If nkgIdx '= "" {
L|Graph.KG.NKGAccelTraversal.1|428|0|                Set pred = -99999999
L|Graph.KG.NKGAccelTraversal.1|429|0|                For {
L|Graph.KG.NKGAccelTraversal.1|430|0|                    Set pred = $Order(^NKG(-1, nkgIdx, pred))
L|Graph.KG.NKGAccelTraversal.1|431|0|                    Quit:(pred="")!(pred>=0)
L|Graph.KG.NKGAccelTraversal.1|432|0|                    Set dst = ""
L|Graph.KG.NKGAccelTraversal.1|433|0|                    For {
L|Graph.KG.NKGAccelTraversal.1|434|0|                        Set dst = $Order(^NKG(-1, nkgIdx, pred, dst))
L|Graph.KG.NKGAccelTraversal.1|435|0|                        Quit:dst=""
L|Graph.KG.NKGAccelTraversal.1|436|0|                        Set dstStr = $Get(^NKG("$ND", dst), "")
L|Graph.KG.NKGAccelTraversal.1|437|0|                        If $Data(^||localIdx(dstStr)) {
L|Graph.KG.NKGAccelTraversal.1|438|0|                            Set ^||pprAdj(i, deg) = ^||localIdx(dstStr)
L|Graph.KG.NKGAccelTraversal.1|439|0|                            Set deg = deg + 1
L|Graph.KG.NKGAccelTraversal.1|440|0|                        }
L|Graph.KG.NKGAccelTraversal.1|441|0|                    }
L|Graph.KG.NKGAccelTraversal.1|442|0|                }
L|Graph.KG.NKGAccelTraversal.1|443|0|            }
L|Graph.KG.NKGAccelTraversal.1|444|0|        } Else {
L|Graph.KG.NKGAccelTraversal.1|445|0|            Set pred = ""
L|Graph.KG.NKGAccelTraversal.1|446|0|            For {
L|Graph.KG.NKGAccelTraversal.1|447|0|                Set pred = $Order(^KG("out", nodeId, pred))
L|Graph.KG.NKGAccelTraversal.1|448|0|                Quit:pred=""
L|Graph.KG.NKGAccelTraversal.1|449|0|                Set dst = ""
L|Graph.KG.NKGAccelTraversal.1|450|0|                For {
L|Graph.KG.NKGAccelTraversal.1|451|0|                    Set dst = $Order(^KG("out", nodeId, pred, dst))
L|Graph.KG.NKGAccelTraversal.1|452|0|                    Quit:dst=""
L|Graph.KG.NKGAccelTraversal.1|453|0|                    If $Data(^||localIdx(dst)) {
L|Graph.KG.NKGAccelTraversal.1|454|0|                        Set ^||pprAdj(i, deg) = ^||localIdx(dst)
L|Graph.KG.NKGAccelTraversal.1|455|0|                        Set deg = deg + 1
L|Graph.KG.NKGAccelTraversal.1|456|0|                    }
L|Graph.KG.NKGAccelTraversal.1|457|0|                }
L|Graph.KG.NKGAccelTraversal.1|458|0|            }
L|Graph.KG.NKGAccelTraversal.1|459|0|        }
L|Graph.KG.NKGAccelTraversal.1|460|0|        Set ^||pprAdj(i) = deg
L|Graph.KG.NKGAccelTraversal.1|461|0|    }
L|Graph.KG.NKGAccelTraversal.1|462|0|    // Find seed index
L|Graph.KG.NKGAccelTraversal.1|463|0|    Set seedLocalIdx = $Get(^||localIdx(seedId), 0)
L|Graph.KG.NKGAccelTraversal.1|464|0|    // Initialize scores: teleport vector = 1 for seed, 0 for others
L|Graph.KG.NKGAccelTraversal.1|465|0|    For i = 0:1:n-1 { Set ^||pprScore(i) = 0 }
L|Graph.KG.NKGAccelTraversal.1|466|0|    Set ^||pprScore(seedLocalIdx) = 1
L|Graph.KG.NKGAccelTraversal.1|467|0|    // Power iteration
L|Graph.KG.NKGAccelTraversal.1|468|0|    For iter = 1:1:maxIter {
L|Graph.KG.NKGAccelTraversal.1|469|0|        For i = 0:1:n-1 { Set ^||pprNext(i) = 0 }
L|Graph.KG.NKGAccelTraversal.1|470|0|        For i = 0:1:n-1 {
L|Graph.KG.NKGAccelTraversal.1|471|0|            Set deg = $Get(^||pprAdj(i), 0)
L|Graph.KG.NKGAccelTraversal.1|472|0|            If deg = 0 Continue
L|Graph.KG.NKGAccelTraversal.1|473|0|            Set contrib = ^||pprScore(i) / deg
L|Graph.KG.NKGAccelTraversal.1|474|0|            For j = 0:1:deg-1 {
L|Graph.KG.NKGAccelTraversal.1|475|0|                Set nbr = ^||pprAdj(i, j)
L|Graph.KG.NKGAccelTraversal.1|476|0|                Set ^||pprNext(nbr) = ^||pprNext(nbr) + (alpha * contrib)
L|Graph.KG.NKGAccelTraversal.1|477|0|            }
L|Graph.KG.NKGAccelTraversal.1|478|0|        }
L|Graph.KG.NKGAccelTraversal.1|479|0|        // Add teleport
L|Graph.KG.NKGAccelTraversal.1|480|0|        For i = 0:1:n-1 {
L|Graph.KG.NKGAccelTraversal.1|481|0|            Set ^||pprNext(i) = ^||pprNext(i) + ((1 - alpha) * $Select(i=seedLocalIdx:1, 1:0))
L|Graph.KG.NKGAccelTraversal.1|482|0|        }
L|Graph.KG.NKGAccelTraversal.1|483|0|        // Swap
L|Graph.KG.NKGAccelTraversal.1|484|0|        For i = 0:1:n-1 { Set ^||pprScore(i) = ^||pprNext(i) }
L|Graph.KG.NKGAccelTraversal.1|485|0|    }
L|Graph.KG.NKGAccelTraversal.1|486|0|    // Collect top-K by score (simple selection)
L|Graph.KG.NKGAccelTraversal.1|487|0|    Kill ^||ranked
L|Graph.KG.NKGAccelTraversal.1|488|0|    For i = 0:1:n-1 {
L|Graph.KG.NKGAccelTraversal.1|489|0|        Set score = ^||pprScore(i)
L|Graph.KG.NKGAccelTraversal.1|490|0|        Set ^||ranked(-score, i) = ""
L|Graph.KG.NKGAccelTraversal.1|491|0|    }
L|Graph.KG.NKGAccelTraversal.1|492|0|    Set result = "{""seed"":"""_seedId_""",""alpha"":"_alpha_",""iterations"":"_maxIter_",""scores"":["
L|Graph.KG.NKGAccelTraversal.1|493|0|    Set first = 1, count = 0
L|Graph.KG.NKGAccelTraversal.1|494|0|    Set sk = ""
L|Graph.KG.NKGAccelTraversal.1|495|0|    For {
L|Graph.KG.NKGAccelTraversal.1|496|0|        Set sk = $Order(^||ranked(sk))
L|Graph.KG.NKGAccelTraversal.1|497|0|        Quit:sk=""
L|Graph.KG.NKGAccelTraversal.1|498|0|        Set idx = ""
L|Graph.KG.NKGAccelTraversal.1|499|0|        For {
L|Graph.KG.NKGAccelTraversal.1|500|0|            Set idx = $Order(^||ranked(sk, idx))
L|Graph.KG.NKGAccelTraversal.1|501|0|            Quit:idx=""
L|Graph.KG.NKGAccelTraversal.1|502|0|            Set nodeId = nodes.%Get(idx).id
L|Graph.KG.NKGAccelTraversal.1|503|0|            Set score = -sk
L|Graph.KG.NKGAccelTraversal.1|504|0|            Set:'first result = result _ ","
L|Graph.KG.NKGAccelTraversal.1|505|0|            Set first = 0
L|Graph.KG.NKGAccelTraversal.1|506|0|            Set result = result _ "{""id"":"""_nodeId_""",""score"":"_$FNumber(score,"",6)_"}"
L|Graph.KG.NKGAccelTraversal.1|507|0|            Set count = count + 1
L|Graph.KG.NKGAccelTraversal.1|508|0|            If topK > 0 && count >= topK Goto PPRDone
L|Graph.KG.NKGAccelTraversal.1|509|0|        }
L|Graph.KG.NKGAccelTraversal.1|510|0|    }
L|Graph.KG.NKGAccelTraversal.1|511|0|PPRDone
L|Graph.KG.NKGAccelTraversal.1|512|0|    Set result = result _ "]}"
L|Graph.KG.NKGAccelTraversal.1|513|0|    Return result }
L|Graph.KG.NKGAccelTraversal.1|514|0|RandomWalkJson(seedId,walkLength=20,numWalks=10) methodimpl {
L|Graph.KG.NKGAccelTraversal.1|515|0|    Set useNKG = ##class(Graph.KG.NKGAccelLoader).UseNKG()
L|Graph.KG.NKGAccelTraversal.1|516|0|    Set result = "["
L|Graph.KG.NKGAccelTraversal.1|517|0|    For w = 1:1:numWalks {
L|Graph.KG.NKGAccelTraversal.1|518|0|        Set:'(w=1) result = result _ ","
L|Graph.KG.NKGAccelTraversal.1|519|0|        Set result = result _ "["
L|Graph.KG.NKGAccelTraversal.1|520|0|        Set current = seedId
L|Graph.KG.NKGAccelTraversal.1|521|0|        If useNKG { Set currentIdx = $Get(^NKG("$NI", seedId), "") }
L|Graph.KG.NKGAccelTraversal.1|522|0|        Set result = result _ """" _ seedId _ """"
L|Graph.KG.NKGAccelTraversal.1|523|0|        For step = 1:1:walkLength {
L|Graph.KG.NKGAccelTraversal.1|524|0|            // Collect neighbors
L|Graph.KG.NKGAccelTraversal.1|525|0|            Kill ^||walkNbrs
L|Graph.KG.NKGAccelTraversal.1|526|0|            Set nbrCount = 0
L|Graph.KG.NKGAccelTraversal.1|527|0|            If useNKG && (currentIdx '= "") {
L|Graph.KG.NKGAccelTraversal.1|528|0|                Set pred = -99999999  For { Set pred=$Order(^NKG(-1,currentIdx,pred)) Quit:(pred="")||(pred>=0)  Set dst="" For { Set dst=$Order(^NKG(-1,currentIdx,pred,dst)) Quit:dst=""  Set nbrCount=nbrCount+1, ^||walkNbrs(nbrCount)=dst } }
L|Graph.KG.NKGAccelTraversal.1|529|0|            } Else {
L|Graph.KG.NKGAccelTraversal.1|530|0|                Set pred="" For { Set pred=$Order(^KG("out",current,pred)) Quit:pred=""  Set dst="" For { Set dst=$Order(^KG("out",current,pred,dst)) Quit:dst=""  Set nbrCount=nbrCount+1, ^||walkNbrs(nbrCount)=dst } }
L|Graph.KG.NKGAccelTraversal.1|531|0|            }
L|Graph.KG.NKGAccelTraversal.1|532|0|            If nbrCount = 0 Quit
L|Graph.KG.NKGAccelTraversal.1|533|0|            // Pick random neighbor
L|Graph.KG.NKGAccelTraversal.1|534|0|            Set pick = $Random(nbrCount) + 1
L|Graph.KG.NKGAccelTraversal.1|535|0|            If useNKG {
L|Graph.KG.NKGAccelTraversal.1|536|0|                Set currentIdx = ^||walkNbrs(pick)
L|Graph.KG.NKGAccelTraversal.1|537|0|                Set current = $Get(^NKG("$ND", currentIdx), currentIdx)
L|Graph.KG.NKGAccelTraversal.1|538|0|            } Else {
L|Graph.KG.NKGAccelTraversal.1|539|0|                Set current = ^||walkNbrs(pick)
L|Graph.KG.NKGAccelTraversal.1|540|0|            }
L|Graph.KG.NKGAccelTraversal.1|541|0|            Set result = result _ ",""" _ current _ """"
L|Graph.KG.NKGAccelTraversal.1|542|0|        }
L|Graph.KG.NKGAccelTraversal.1|543|0|        Set result = result _ "]"
L|Graph.KG.NKGAccelTraversal.1|544|0|    }
L|Graph.KG.NKGAccelTraversal.1|545|0|    Set result = result _ "]"
L|Graph.KG.NKGAccelTraversal.1|546|0|    Return ##class(Graph.KG.NKGAccelAdjacency).StoreLargeOut("RW", result)
L|Graph.KG.NKGAccelTraversal.1|547|0|}
L|Graph.KG.NKGAccelTraversal.1|548|0|ShortestPathNKG(srcId,dstId,maxHops=10) methodimpl {
L|Graph.KG.NKGAccelTraversal.1|549|0|    If srcId = "" || dstId = "" { Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|550|0|    Set srcIdx = $Get(^NKG("$NI", srcId), "")
L|Graph.KG.NKGAccelTraversal.1|551|0|    Set dstIdx = $Get(^NKG("$NI", dstId), "")
L|Graph.KG.NKGAccelTraversal.1|552|0|    If srcIdx = "" { Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|553|0|    If dstIdx = "" { Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|554|0|    If srcIdx = dstIdx { Return "{""hops"":0}" }
L|Graph.KG.NKGAccelTraversal.1|555|0|    Kill ^||BF, ^||BB, ^||SF, ^||SB, ^||NF, ^||NB
L|Graph.KG.NKGAccelTraversal.1|556|0|    Set ^||BF(srcIdx) = "", ^||SF(srcIdx) = 0
L|Graph.KG.NKGAccelTraversal.1|557|0|    Set ^||BB(dstIdx) = "", ^||SB(dstIdx) = 0
L|Graph.KG.NKGAccelTraversal.1|558|0|    For fHop = 1:1:maxHops {
L|Graph.KG.NKGAccelTraversal.1|559|0|        Kill ^||NF
L|Graph.KG.NKGAccelTraversal.1|560|0|        Set ni = ""
L|Graph.KG.NKGAccelTraversal.1|561|0|        For {
L|Graph.KG.NKGAccelTraversal.1|562|0|            Set ni = $Order(^||BF(ni))
L|Graph.KG.NKGAccelTraversal.1|563|0|            Quit:ni=""
L|Graph.KG.NKGAccelTraversal.1|564|0|            Set pred = -99999999
L|Graph.KG.NKGAccelTraversal.1|565|0|            For {
L|Graph.KG.NKGAccelTraversal.1|566|0|                Set pred = $Order(^NKG(-1, ni, pred))
L|Graph.KG.NKGAccelTraversal.1|567|0|                Quit:(pred="")!(pred>=0)
L|Graph.KG.NKGAccelTraversal.1|568|0|                Set di = ""
L|Graph.KG.NKGAccelTraversal.1|569|0|                For {
L|Graph.KG.NKGAccelTraversal.1|570|0|                    Set di = $Order(^NKG(-1, ni, pred, di))
L|Graph.KG.NKGAccelTraversal.1|571|0|                    Quit:di=""
L|Graph.KG.NKGAccelTraversal.1|572|0|                    If $Data(^||SB(di)) {
L|Graph.KG.NKGAccelTraversal.1|573|0|                        Set result = fHop + ^||SB(di)
L|Graph.KG.NKGAccelTraversal.1|574|0|                        Kill ^||BF,^||BB,^||SF,^||SB,^||NF,^||NB
L|Graph.KG.NKGAccelTraversal.1|575|0|                        Return "{""hops"":"_result_"}"
L|Graph.KG.NKGAccelTraversal.1|576|0|                    }
L|Graph.KG.NKGAccelTraversal.1|577|0|                    If '$Data(^||SF(di)) { Set ^||SF(di) = fHop, ^||NF(di) = "" }
L|Graph.KG.NKGAccelTraversal.1|578|0|                }
L|Graph.KG.NKGAccelTraversal.1|579|0|            }
L|Graph.KG.NKGAccelTraversal.1|580|0|        }
L|Graph.KG.NKGAccelTraversal.1|581|0|        If '$Data(^||NF) { Kill ^||BF,^||BB,^||SF,^||SB,^||NF,^||NB  Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|582|0|        Kill ^||BF  Merge ^||BF = ^||NF
L|Graph.KG.NKGAccelTraversal.1|583|0|        Kill ^||NB
L|Graph.KG.NKGAccelTraversal.1|584|0|        Set bHop = fHop
L|Graph.KG.NKGAccelTraversal.1|585|0|        Set ni = ""
L|Graph.KG.NKGAccelTraversal.1|586|0|        For {
L|Graph.KG.NKGAccelTraversal.1|587|0|            Set ni = $Order(^||BB(ni))
L|Graph.KG.NKGAccelTraversal.1|588|0|            Quit:ni=""
L|Graph.KG.NKGAccelTraversal.1|589|0|            Set pred = -99999999
L|Graph.KG.NKGAccelTraversal.1|590|0|            For {
L|Graph.KG.NKGAccelTraversal.1|591|0|                Set pred = $Order(^NKG(-2, ni, pred))
L|Graph.KG.NKGAccelTraversal.1|592|0|                Quit:(pred="")!(pred>=0)
L|Graph.KG.NKGAccelTraversal.1|593|0|                Set si = ""
L|Graph.KG.NKGAccelTraversal.1|594|0|                For {
L|Graph.KG.NKGAccelTraversal.1|595|0|                    Set si = $Order(^NKG(-2, ni, pred, si))
L|Graph.KG.NKGAccelTraversal.1|596|0|                    Quit:si=""
L|Graph.KG.NKGAccelTraversal.1|597|0|                    If $Data(^||SF(si)) {
L|Graph.KG.NKGAccelTraversal.1|598|0|                        Set result = ^||SF(si) + bHop
L|Graph.KG.NKGAccelTraversal.1|599|0|                        Kill ^||BF,^||BB,^||SF,^||SB,^||NF,^||NB
L|Graph.KG.NKGAccelTraversal.1|600|0|                        Return "{""hops"":"_result_"}"
L|Graph.KG.NKGAccelTraversal.1|601|0|                    }
L|Graph.KG.NKGAccelTraversal.1|602|0|                    If '$Data(^||SB(si)) { Set ^||SB(si) = bHop, ^||NB(si) = "" }
L|Graph.KG.NKGAccelTraversal.1|603|0|                }
L|Graph.KG.NKGAccelTraversal.1|604|0|            }
L|Graph.KG.NKGAccelTraversal.1|605|0|        }
L|Graph.KG.NKGAccelTraversal.1|606|0|        If '$Data(^||NB) { Kill ^||BF,^||BB,^||SF,^||SB,^||NF,^||NB  Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|607|0|        Kill ^||BB  Merge ^||BB = ^||NB
L|Graph.KG.NKGAccelTraversal.1|608|0|    }
L|Graph.KG.NKGAccelTraversal.1|609|0|    Kill ^||BF,^||BB,^||SF,^||SB,^||NF,^||NB
L|Graph.KG.NKGAccelTraversal.1|610|0|    Return "{""hops"":-1}" }
L|Graph.KG.NKGAccelTraversal.1|611|0|StructuralGuard(nodeIdx,requiredPreds) methodimpl {
L|Graph.KG.NKGAccelTraversal.1|612|0|    Set len = $ListLength(requiredPreds)
L|Graph.KG.NKGAccelTraversal.1|613|0|    If len = 0 Return 1
L|Graph.KG.NKGAccelTraversal.1|614|0|    For i = 1:1:len {
L|Graph.KG.NKGAccelTraversal.1|615|0|        Set predIdx = $List(requiredPreds, i)
L|Graph.KG.NKGAccelTraversal.1|616|0|        // NKG stores pred keys as -(pIdx+1) to keep them negative (sort before "")
L|Graph.KG.NKGAccelTraversal.1|617|0|        If '$Data(^NKG(-1, nodeIdx, -(predIdx+1))) Return 0
L|Graph.KG.NKGAccelTraversal.1|618|0|    }
L|Graph.KG.NKGAccelTraversal.1|619|0|    Return 1 }
