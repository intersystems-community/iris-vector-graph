L|Graph.KG.LedgerApply.1|306|-9|    Set tMode = ##class(Graph.KG.Ledger).MetaGet(pOp, "mode", "strict")
L|Graph.KG.LedgerApply.1|307|-9|    If $Data(pCtx("deletedNode", tId)) Return "node '" _ tId _ "' was deleted earlier in this changeset"
L|Graph.KG.LedgerApply.1|308|-9|    If '..NodeExists(tSchema, tId) Return "node_not_found: '" _ tId _ "'"
L|Graph.KG.LedgerApply.1|309|-9|    // incident live relationships
L|Graph.KG.LedgerApply.1|310|-9|    Kill tSort
L|Graph.KG.LedgerApply.1|311|-9|    Set tRS = ..Run("SELECT %ID, s, p, o_id, graph_id, qualifiers FROM " _ tSchema _ ".rdf_edges WHERE s = ? OR o_id = ?", tId, tId)
L|Graph.KG.LedgerApply.1|312|-9|    If tRS.%SQLCODE < 0 Return "incident lookup failed: " _ tRS.%Message
L|Graph.KG.LedgerApply.1|313|-9|    Set tCount = 0
L|Graph.KG.LedgerApply.1|314|-9|    While tRS.%Next() {
