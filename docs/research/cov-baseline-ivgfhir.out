L|Graph.KG.Benchmark.1|5|-9|Run(srcId="alice",maxHops=2) methodimpl {
L|Graph.KG.Benchmark.1|6|-9|    // 1. Standard BFS (Object Bottleneck)
L|Graph.KG.Benchmark.1|7|-9|    Set start = $Piece($ZTimestamp, ",", 2)
L|Graph.KG.Benchmark.1|8|-9|    Set results = ##class(Graph.KG.Traversal).BFS(srcId, "", maxHops)
L|Graph.KG.Benchmark.1|9|-9|    Set end = $Piece($ZTimestamp, ",", 2)
L|Graph.KG.Benchmark.1|10|-9|    Set duration = end - start
L|Graph.KG.Benchmark.1|11|-9|    If duration < 0 Set duration = duration + 86400
L|Graph.KG.Benchmark.1|12|-9|    Write "Standard BFS (Objects): ", duration, "s | Count: ", results.%Size(), !
L|Graph.KG.Benchmark.1|13|-9|    // 2. Fast BFS (PPG + ListBuild)
L|Graph.KG.Benchmark.1|14|-9|    Set start = $Piece($ZTimestamp, ",", 2)
L|Graph.KG.Benchmark.1|15|-9|    Set count = ##class(Graph.KG.Traversal).BFSFast(srcId, "", maxHops)
L|Graph.KG.Benchmark.1|16|-9|    Set end = $Piece($ZTimestamp, ",", 2)
L|Graph.KG.Benchmark.1|17|-9|    Set durationF = end - start
L|Graph.KG.Benchmark.1|18|-9|    If durationF < 0 Set durationF = durationF + 86400
L|Graph.KG.Benchmark.1|19|-9|    Write "Fast BFS (PPG):      ", durationF, "s | Count: ", count, !
L|Graph.KG.Benchmark.1|20|-9|    If durationF > 0 Write "Improvement: ", $Fnumber((duration - durationF) / duration * 100, "", 2), "%", !
L|Graph.KG.Benchmark.1|21|-9|    Return durationF }
