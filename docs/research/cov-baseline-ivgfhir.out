L|Graph.KG.BM25Index.1|5|0|Build(name,propsCSV,k1=1.5,b,pGraph="") methodimpl { s:'($d(b)#2) b=0.75
L|Graph.KG.BM25Index.1|6|0|    Kill ^BM25Idx(name)
L|Graph.KG.BM25Index.1|7|0|    // Build an IN-list literal from propsCSV for the single batch query.
L|Graph.KG.BM25Index.1|8|0|    // e.g. "name,definition" ? "'name','definition'"
L|Graph.KG.BM25Index.1|9|0|    Set inList = ""
L|Graph.KG.BM25Index.1|10|0|    Set nProps = $LENGTH(propsCSV, ",")
L|Graph.KG.BM25Index.1|11|0|    For pi = 1:1:nProps {
L|Graph.KG.BM25Index.1|12|0|        Set propKey = $ZSTRIP($PIECE(propsCSV, ",", pi), "<>W")
L|Graph.KG.BM25Index.1|13|0|        If propKey = "" Continue
L|Graph.KG.BM25Index.1|14|0|        Set escaped = $Replace(propKey, "'", "''")
L|Graph.KG.BM25Index.1|15|0|        Set inList = inList _ $Select(inList="":"", 1:",") _ "'" _ escaped _ "'"
L|Graph.KG.BM25Index.1|16|0|    }
L|Graph.KG.BM25Index.1|17|0|    If inList = "" Return "{""indexed"":0,""avgdl"":0,""vocab_size"":0}"
L|Graph.KG.BM25Index.1|18|0|    // One query fetches all (node_id, val) pairs for the requested properties.
L|Graph.KG.BM25Index.1|19|0|    // Ordered by node_id so we can accumulate per-doc by scanning in sequence.
L|Graph.KG.BM25Index.1|20|0|    //
L|Graph.KG.BM25Index.1|21|0|    // Both sides of the join carry the graph. Restricting only the driving table
L|Graph.KG.BM25Index.1|22|0|    // would still pull the other graph's property rows onto this graph's node,
L|Graph.KG.BM25Index.1|23|0|    // because a node_id is unique per graph and not per namespace since 227.
L|Graph.KG.BM25Index.1|24|0|    //
L|Graph.KG.BM25Index.1|25|0|    // COALESCE on both sides of each comparison: graph_id is nullable on an
L|Graph.KG.BM25Index.1|26|0|    // installation upgraded by ADD COLUMN, and an empty parameter reaches IRIS as
L|Graph.KG.BM25Index.1|27|0|    // SQL NULL, so a bare `= ?` for the default graph matches nothing.
L|Graph.KG.BM25Index.1|28|0|    Set sql = "SELECT n.node_id, p.val FROM Graph_KG.nodes n "
L|Graph.KG.BM25Index.1|29|0|            _ "LEFT JOIN Graph_KG.rdf_props p ON p.s = n.node_id "
L|Graph.KG.BM25Index.1|30|0|            _ "AND COALESCE(p.graph_id, '') = COALESCE(n.graph_id, '') "
L|Graph.KG.BM25Index.1|31|0|            _ "AND p.key IN ("_inList_") "
L|Graph.KG.BM25Index.1|32|0|            _ "WHERE COALESCE(n.graph_id, '') = COALESCE(?, '') "
L|Graph.KG.BM25Index.1|33|0|            _ "ORDER BY n.node_id"
L|Graph.KG.BM25Index.1|34|0|    Set stmt = ##class(%SQL.Statement).%New()
L|Graph.KG.BM25Index.1|35|0|    Do stmt.%Prepare(sql)
L|Graph.KG.BM25Index.1|36|0|    Set rs = stmt.%Execute(pGraph)
L|Graph.KG.BM25Index.1|37|0|    Set N = 0
L|Graph.KG.BM25Index.1|38|0|    Set totalLen = 0
L|Graph.KG.BM25Index.1|39|0|    Set vocabSize = 0
L|Graph.KG.BM25Index.1|40|0|    Set curDoc = ""
L|Graph.KG.BM25Index.1|41|0|    Set docText = ""
L|Graph.KG.BM25Index.1|42|0|    While rs.%Next() {
L|Graph.KG.BM25Index.1|43|0|        Set docId = rs.%Get("node_id")
L|Graph.KG.BM25Index.1|44|0|        Set val = rs.%GetData(2)  // p.val (NULL when no matching prop row)
L|Graph.KG.BM25Index.1|45|0|        If docId '= curDoc {
L|Graph.KG.BM25Index.1|46|0|            // Flush previous doc
L|Graph.KG.BM25Index.1|47|0|            If curDoc '= "" {
L|Graph.KG.BM25Index.1|48|0|                Do ..IndexDoc(name, curDoc, docText, .N, .totalLen, .vocabSize)
L|Graph.KG.BM25Index.1|49|0|            }
L|Graph.KG.BM25Index.1|50|0|            Set curDoc = docId
L|Graph.KG.BM25Index.1|51|0|            Set docText = $Select(val="":"", 1:val)
L|Graph.KG.BM25Index.1|52|0|        } Else {
L|Graph.KG.BM25Index.1|53|0|            If val '= "" Set docText = docText _ " " _ val
L|Graph.KG.BM25Index.1|54|0|        }
L|Graph.KG.BM25Index.1|55|0|    }
L|Graph.KG.BM25Index.1|56|0|    // Flush last doc
L|Graph.KG.BM25Index.1|57|0|    If curDoc '= "" {
L|Graph.KG.BM25Index.1|58|0|        Do ..IndexDoc(name, curDoc, docText, .N, .totalLen, .vocabSize)
L|Graph.KG.BM25Index.1|59|0|    }
L|Graph.KG.BM25Index.1|60|0|    // df and doc were written as each document was indexed; nothing is recounted here.
L|Graph.KG.BM25Index.1|61|0|    Set ^BM25Idx(name, "cfg", "N") = N
L|Graph.KG.BM25Index.1|62|0|    Set ^BM25Idx(name, "cfg", "totalLen") = totalLen
L|Graph.KG.BM25Index.1|63|0|    Set ^BM25Idx(name, "cfg", "k1") = k1
L|Graph.KG.BM25Index.1|64|0|    Set ^BM25Idx(name, "cfg", "b") = b
L|Graph.KG.BM25Index.1|65|0|    Set ^BM25Idx(name, "cfg", "vocab_size") = vocabSize
L|Graph.KG.BM25Index.1|66|0|    // The global is keyed by index name alone, so the graph an index covers is
L|Graph.KG.BM25Index.1|67|0|    // recoverable only from here ? Info reports it, and a caller comparing two
L|Graph.KG.BM25Index.1|68|0|    // indexes has no other way to tell which graph each one answers for.
L|Graph.KG.BM25Index.1|69|0|    Set ^BM25Idx(name, "cfg", "graph") = pGraph
L|Graph.KG.BM25Index.1|70|0|    // Last: a reader that sees schema 2 finds everything schema 2 promises.
L|Graph.KG.BM25Index.1|71|0|    Set ^BM25Idx(name, "cfg", "schema") = 2
L|Graph.KG.BM25Index.1|72|0|    Set avgdl = $Select(N > 0: totalLen / N, 1: 0)
L|Graph.KG.BM25Index.1|73|0|    Set graphJSON = $Replace($Replace(pGraph, "\", "\\"), """", "\""")
L|Graph.KG.BM25Index.1|74|0|    Return "{""indexed"":"_N_",""avgdl"":"_avgdl_",""vocab_size"":"_vocabSize_",""graph"":"""_graphJSON_"""}" }
L|Graph.KG.BM25Index.1|75|0|Delete(name,docId) methodimpl {
L|Graph.KG.BM25Index.1|76|0|    If '$Data(^BM25Idx(name, "cfg", "N")) Return 0
L|Graph.KG.BM25Index.1|77|0|    Do ..RequireWritable(name)
L|Graph.KG.BM25Index.1|78|0|    Do ..LockWrite(name)
L|Graph.KG.BM25Index.1|79|0|    Set removed = 0
L|Graph.KG.BM25Index.1|80|0|    Try {
L|Graph.KG.BM25Index.1|81|0|        Do ..RequireWritable(name)
L|Graph.KG.BM25Index.1|82|0|        TStart
L|Graph.KG.BM25Index.1|83|0|        Set removed = ..RemoveDoc(name, docId)
L|Graph.KG.BM25Index.1|84|0|        TCommit
L|Graph.KG.BM25Index.1|85|0|    } Catch ex {
L|Graph.KG.BM25Index.1|86|0|        If $TLevel > 0 TRollback
L|Graph.KG.BM25Index.1|87|0|        Lock -^BM25Idx(name, "lock")
L|Graph.KG.BM25Index.1|88|0|        Throw ex
L|Graph.KG.BM25Index.1|89|0|    }
L|Graph.KG.BM25Index.1|90|0|    Lock -^BM25Idx(name, "lock")
L|Graph.KG.BM25Index.1|91|0|    Return removed }
L|Graph.KG.BM25Index.1|92|0|Drop(name) methodimpl {
L|Graph.KG.BM25Index.1|93|0|    Kill ^BM25Idx(name)
L|Graph.KG.BM25Index.1|94|0|    Return 1 }
L|Graph.KG.BM25Index.1|95|0|IndexDoc(name,docId,docText,N,totalLen,vocabSize) methodimpl {
L|Graph.KG.BM25Index.1|96|0|    Set tokens = ..Tokenize(docText)
L|Graph.KG.BM25Index.1|97|0|    Set docLen = $LISTLENGTH(tokens)
L|Graph.KG.BM25Index.1|98|0|    If docLen = 0 Return
L|Graph.KG.BM25Index.1|99|0|    Kill tfMap
L|Graph.KG.BM25Index.1|100|0|    Set tIdx = 0
L|Graph.KG.BM25Index.1|101|0|    While $LISTNEXT(tokens, tIdx, tok) {
L|Graph.KG.BM25Index.1|102|0|        If tok = "" Continue
L|Graph.KG.BM25Index.1|103|0|        Set tfMap(tok) = $Get(tfMap(tok), 0) + 1
L|Graph.KG.BM25Index.1|104|0|    }
L|Graph.KG.BM25Index.1|105|0|    Set rec = ""
L|Graph.KG.BM25Index.1|106|0|    Set tok = ""
L|Graph.KG.BM25Index.1|107|0|    For {
L|Graph.KG.BM25Index.1|108|0|        Set tok = $Order(tfMap(tok))
L|Graph.KG.BM25Index.1|109|0|        Quit:tok=""
L|Graph.KG.BM25Index.1|110|0|        Set ^BM25Idx(name, "tf", tok, docId) = tfMap(tok)
L|Graph.KG.BM25Index.1|111|0|        Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|112|0|        If df = 0 Set vocabSize = vocabSize + 1
L|Graph.KG.BM25Index.1|113|0|        Set ^BM25Idx(name, "df", tok) = df + 1
L|Graph.KG.BM25Index.1|114|0|        Set rec = rec _ $LISTBUILD(tok)
L|Graph.KG.BM25Index.1|115|0|    }
L|Graph.KG.BM25Index.1|116|0|    Set ^BM25Idx(name, "doc", docId) = rec
L|Graph.KG.BM25Index.1|117|0|    Set ^BM25Idx(name, "len", docId) = docLen
L|Graph.KG.BM25Index.1|118|0|    Set N = N + 1
L|Graph.KG.BM25Index.1|119|0|    Set totalLen = totalLen + docLen }
L|Graph.KG.BM25Index.1|120|0|Info(name) methodimpl {
L|Graph.KG.BM25Index.1|121|0|    Set N = $Get(^BM25Idx(name, "cfg", "N"), "")
L|Graph.KG.BM25Index.1|122|0|    If N = "" Return "{}"
L|Graph.KG.BM25Index.1|123|0|    Set schema = +$Get(^BM25Idx(name, "cfg", "schema"), 1)
L|Graph.KG.BM25Index.1|124|0|    If schema >= 2 {
L|Graph.KG.BM25Index.1|125|0|        Set avgdl = $Select(N > 0: +$Get(^BM25Idx(name, "cfg", "totalLen"), 0) / N, 1: 0)
L|Graph.KG.BM25Index.1|126|0|    } Else {
L|Graph.KG.BM25Index.1|127|0|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "avgdl"), 0)
L|Graph.KG.BM25Index.1|128|0|    }
L|Graph.KG.BM25Index.1|129|0|    Set vocabSize = +$Get(^BM25Idx(name, "cfg", "vocab_size"), 0)
L|Graph.KG.BM25Index.1|130|0|    // An index left over from a pre-230 build has no graph subscript and covered
L|Graph.KG.BM25Index.1|131|0|    // every graph in the namespace. It reports "" ? the same value the default
L|Graph.KG.BM25Index.1|132|0|    // graph reports ? so a stale index is indistinguishable here; rebuild it
L|Graph.KG.BM25Index.1|133|0|    // rather than reading a graph off it.
L|Graph.KG.BM25Index.1|134|0|    Set graph = $Get(^BM25Idx(name, "cfg", "graph"), "")
L|Graph.KG.BM25Index.1|135|0|    Set graphJSON = $Replace($Replace(graph, "\", "\\"), """", "\""")
L|Graph.KG.BM25Index.1|136|0|    Return "{""N"":"_N_",""avgdl"":"_avgdl_",""vocab_size"":"_vocabSize_",""graph"":"""_graphJSON_""",""schema"":"_schema_"}" }
L|Graph.KG.BM25Index.1|137|0|InitStopwords() methodimpl {
L|Graph.KG.BM25Index.1|138|0|    If $Data(^BM25Idx("__stop__", "the")) Return
L|Graph.KG.BM25Index.1|139|0|    Set words = "a,an,the,and,or,but,in,on,at,to,for,of,with,by,from,is,are,was,were,be,been,being,have,has,had,do,does,did,will,would,could,should,may,might,shall,this,that,these,those,it,its,i,we,you,he,she,they,them,their,our,your,his,her,not,no,nor,so,yet,both,either,neither,each,all,any,such,as,if,than,then,there,here,when,where,which,who,what,how"
L|Graph.KG.BM25Index.1|140|0|    Set n = $LENGTH(words, ",")
L|Graph.KG.BM25Index.1|141|0|    For i = 1:1:n {
L|Graph.KG.BM25Index.1|142|0|        Set w = $PIECE(words, ",", i)
L|Graph.KG.BM25Index.1|143|0|        Set ^BM25Idx("__stop__", w) = 1
L|Graph.KG.BM25Index.1|144|0|    } }
L|Graph.KG.BM25Index.1|145|0|Insert(name,docId,text) methodimpl {
L|Graph.KG.BM25Index.1|146|0|    Do ..RequireWritable(name)
L|Graph.KG.BM25Index.1|147|0|    // Tokenize outside the lock: it is the only CPU-heavy part.
L|Graph.KG.BM25Index.1|148|0|    Set tokens = ..Tokenize(text)
L|Graph.KG.BM25Index.1|149|0|    Set docLen = $LISTLENGTH(tokens)
L|Graph.KG.BM25Index.1|150|0|    Kill tfMap
L|Graph.KG.BM25Index.1|151|0|    Set tIdx = 0
L|Graph.KG.BM25Index.1|152|0|    While $LISTNEXT(tokens, tIdx, tok) {
L|Graph.KG.BM25Index.1|153|0|        If tok = "" Continue
L|Graph.KG.BM25Index.1|154|0|        Set tfMap(tok) = $Get(tfMap(tok), 0) + 1
L|Graph.KG.BM25Index.1|155|0|    }
L|Graph.KG.BM25Index.1|156|0|    Do ..LockWrite(name)
L|Graph.KG.BM25Index.1|157|0|    Try {
L|Graph.KG.BM25Index.1|158|0|        // Checked again under the lock: Upgrade may have started while this waited.
L|Graph.KG.BM25Index.1|159|0|        Do ..RequireWritable(name)
L|Graph.KG.BM25Index.1|160|0|        TStart
L|Graph.KG.BM25Index.1|161|0|        If '$Data(^BM25Idx(name, "cfg", "N")) {
L|Graph.KG.BM25Index.1|162|0|            Set ^BM25Idx(name, "cfg", "N") = 0
L|Graph.KG.BM25Index.1|163|0|            Set ^BM25Idx(name, "cfg", "totalLen") = 0
L|Graph.KG.BM25Index.1|164|0|            Set ^BM25Idx(name, "cfg", "vocab_size") = 0
L|Graph.KG.BM25Index.1|165|0|            Set ^BM25Idx(name, "cfg", "schema") = 2
L|Graph.KG.BM25Index.1|166|0|        }
L|Graph.KG.BM25Index.1|167|0|        Do ..RemoveDoc(name, docId)
L|Graph.KG.BM25Index.1|168|0|        If docLen > 0 {
L|Graph.KG.BM25Index.1|169|0|            Set rec = ""
L|Graph.KG.BM25Index.1|170|0|            Set tok = ""
L|Graph.KG.BM25Index.1|171|0|            For {
L|Graph.KG.BM25Index.1|172|0|                Set tok = $Order(tfMap(tok))
L|Graph.KG.BM25Index.1|173|0|                Quit:tok=""
L|Graph.KG.BM25Index.1|174|0|                Set ^BM25Idx(name, "tf", tok, docId) = tfMap(tok)
L|Graph.KG.BM25Index.1|175|0|                Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|176|0|                If df = 0 Set ^BM25Idx(name, "cfg", "vocab_size") = +$Get(^BM25Idx(name, "cfg", "vocab_size"), 0) + 1
L|Graph.KG.BM25Index.1|177|0|                Set ^BM25Idx(name, "df", tok) = df + 1
L|Graph.KG.BM25Index.1|178|0|                Set rec = rec _ $LISTBUILD(tok)
L|Graph.KG.BM25Index.1|179|0|            }
L|Graph.KG.BM25Index.1|180|0|            Set ^BM25Idx(name, "doc", docId) = rec
L|Graph.KG.BM25Index.1|181|0|            Set ^BM25Idx(name, "len", docId) = docLen
L|Graph.KG.BM25Index.1|182|0|            Set ^BM25Idx(name, "cfg", "N") = ^BM25Idx(name, "cfg", "N") + 1
L|Graph.KG.BM25Index.1|183|0|            Set ^BM25Idx(name, "cfg", "totalLen") = ^BM25Idx(name, "cfg", "totalLen") + docLen
L|Graph.KG.BM25Index.1|184|0|        }
L|Graph.KG.BM25Index.1|185|0|        TCommit
L|Graph.KG.BM25Index.1|186|0|    } Catch ex {
L|Graph.KG.BM25Index.1|187|0|        If $TLevel > 0 TRollback
L|Graph.KG.BM25Index.1|188|0|        Lock -^BM25Idx(name, "lock")
L|Graph.KG.BM25Index.1|189|0|        Throw ex
L|Graph.KG.BM25Index.1|190|0|    }
L|Graph.KG.BM25Index.1|191|0|    Lock -^BM25Idx(name, "lock")
L|Graph.KG.BM25Index.1|192|0|    Return $Select(docLen > 0: 1, 1: 0) }
L|Graph.KG.BM25Index.1|193|0|List() methodimpl {
L|Graph.KG.BM25Index.1|194|115|	Set result = "", name = ""
L|Graph.KG.BM25Index.1|195|115|	For { Set name = $Order(^BM25Idx(name)) Quit:name=""  Set result = result _ $Select(result="":"", 1:",") _ name }
L|Graph.KG.BM25Index.1|196|115|	Return result }
L|Graph.KG.BM25Index.1|197|0|LockTimeout(name) methodimpl {
L|Graph.KG.BM25Index.1|198|0|    Return +$Get(^BM25Idx(name, "cfg", "lock_timeout"), ..#LOCKTIMEOUT)
L|Graph.KG.BM25Index.1|199|0|}
L|Graph.KG.BM25Index.1|200|0|LockWrite(name) methodimpl {
L|Graph.KG.BM25Index.1|201|0|    Set wait = ..LockTimeout(name)
L|Graph.KG.BM25Index.1|202|0|    Lock +^BM25Idx(name, "lock"):wait
L|Graph.KG.BM25Index.1|203|0|    If '$Test {
L|Graph.KG.BM25Index.1|204|0|        Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5001, "BM25 index '"_name_"' is locked by another writer (waited "_wait_" s)"))
L|Graph.KG.BM25Index.1|205|0|    } }
L|Graph.KG.BM25Index.1|206|0|RemoveDoc(name,docId) methodimpl {
L|Graph.KG.BM25Index.1|207|0|    If '$Data(^BM25Idx(name, "len", docId)) && '$Data(^BM25Idx(name, "doc", docId)) Return 0
L|Graph.KG.BM25Index.1|208|0|    Set oldLen = +$Get(^BM25Idx(name, "len", docId), 0)
L|Graph.KG.BM25Index.1|209|0|    Set rec = $Get(^BM25Idx(name, "doc", docId))
L|Graph.KG.BM25Index.1|210|0|    Set p = 0
L|Graph.KG.BM25Index.1|211|0|    While $LISTNEXT(rec, p, tok) {
L|Graph.KG.BM25Index.1|212|0|        Kill ^BM25Idx(name, "tf", tok, docId)
L|Graph.KG.BM25Index.1|213|0|        Set df = +$Get(^BM25Idx(name, "df", tok), 0) - 1
L|Graph.KG.BM25Index.1|214|0|        If df <= 0 {
L|Graph.KG.BM25Index.1|215|0|            Kill ^BM25Idx(name, "df", tok)
L|Graph.KG.BM25Index.1|216|0|            Set ^BM25Idx(name, "cfg", "vocab_size") = +$Get(^BM25Idx(name, "cfg", "vocab_size"), 0) - 1
L|Graph.KG.BM25Index.1|217|0|        } Else {
L|Graph.KG.BM25Index.1|218|0|            Set ^BM25Idx(name, "df", tok) = df
L|Graph.KG.BM25Index.1|219|0|        }
L|Graph.KG.BM25Index.1|220|0|    }
L|Graph.KG.BM25Index.1|221|0|    Kill ^BM25Idx(name, "doc", docId)
L|Graph.KG.BM25Index.1|222|0|    Kill ^BM25Idx(name, "len", docId)
L|Graph.KG.BM25Index.1|223|0|    Set ^BM25Idx(name, "cfg", "N") = +$Get(^BM25Idx(name, "cfg", "N"), 0) - 1
L|Graph.KG.BM25Index.1|224|0|    Set ^BM25Idx(name, "cfg", "totalLen") = +$Get(^BM25Idx(name, "cfg", "totalLen"), 0) - oldLen
L|Graph.KG.BM25Index.1|225|0|    Return 1 }
L|Graph.KG.BM25Index.1|226|0|RequireWritable(name) methodimpl {
L|Graph.KG.BM25Index.1|227|0|    If '$Data(^BM25Idx(name, "cfg", "N")) Return
L|Graph.KG.BM25Index.1|228|0|    If +$Get(^BM25Idx(name, "cfg", "upgrading"), 0) {
L|Graph.KG.BM25Index.1|229|0|        Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5001, "BM25 index '"_name_"' is being upgraded: writes are refused until Upgrade finishes"))
L|Graph.KG.BM25Index.1|230|0|    }
L|Graph.KG.BM25Index.1|231|0|    If +$Get(^BM25Idx(name, "cfg", "schema"), 1) < 2 {
L|Graph.KG.BM25Index.1|232|0|        Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5001, "BM25 index '"_name_"' is schema 1: run Graph.KG.BM25Index.Upgrade(name) before writing to it"))
L|Graph.KG.BM25Index.1|233|0|    } }
L|Graph.KG.BM25Index.1|234|0|Search(name,queryText,k=10) methodimpl {
L|Graph.KG.BM25Index.1|235|0|    // Load config
L|Graph.KG.BM25Index.1|236|0|    Set N = +$Get(^BM25Idx(name, "cfg", "N"), 0)
L|Graph.KG.BM25Index.1|237|0|    If N = 0 || (queryText = "") Return "[]"
L|Graph.KG.BM25Index.1|238|0|    // Schema 2 derives avgdl and IDF from N, totalLen and df; schema 1 reads what Build
L|Graph.KG.BM25Index.1|239|0|    // and Insert stored. The schema is read once, before anything else, so a Search never
L|Graph.KG.BM25Index.1|240|0|    // mixes the two shapes (Upgrade sets it last).
L|Graph.KG.BM25Index.1|241|0|    Set schema = +$Get(^BM25Idx(name, "cfg", "schema"), 1)
L|Graph.KG.BM25Index.1|242|0|    If schema >= 2 {
L|Graph.KG.BM25Index.1|243|0|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "totalLen"), 0) / N
L|Graph.KG.BM25Index.1|244|0|    } Else {
L|Graph.KG.BM25Index.1|245|0|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "avgdl"), 1)
L|Graph.KG.BM25Index.1|246|0|    }
L|Graph.KG.BM25Index.1|247|0|    If avgdl <= 0 Set avgdl = 1
L|Graph.KG.BM25Index.1|248|0|    Set k1 = +$Get(^BM25Idx(name, "cfg", "k1"), 1.5)
L|Graph.KG.BM25Index.1|249|0|    Set b = +$Get(^BM25Idx(name, "cfg", "b"), 0.75)
L|Graph.KG.BM25Index.1|250|0|    // Tokenize query
L|Graph.KG.BM25Index.1|251|0|    Set queryTokens = ..Tokenize(queryText)
L|Graph.KG.BM25Index.1|252|0|    If $LISTLENGTH(queryTokens) = 0 Return "[]"
L|Graph.KG.BM25Index.1|253|0|    // Accumulate BM25 scores per doc in process-private array
L|Graph.KG.BM25Index.1|254|0|    Kill ^||bm25scores
L|Graph.KG.BM25Index.1|255|0|    Set tIdx = 0
L|Graph.KG.BM25Index.1|256|0|    While $LISTNEXT(queryTokens, tIdx, tok) {
L|Graph.KG.BM25Index.1|257|0|        If tok = "" Continue
L|Graph.KG.BM25Index.1|258|0|        If schema >= 2 {
L|Graph.KG.BM25Index.1|259|0|            Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|260|0|            If df = 0 Continue
L|Graph.KG.BM25Index.1|261|0|            Set idf = $ZLN((N - df + 0.5) / (df + 0.5) + 1)
L|Graph.KG.BM25Index.1|262|0|        } Else {
L|Graph.KG.BM25Index.1|263|0|            Set idf = +$Get(^BM25Idx(name, "idf", tok), 0)
L|Graph.KG.BM25Index.1|264|0|            If idf = 0 {
L|Graph.KG.BM25Index.1|265|0|                // Upgrade removes the stored idf after it sets schema 2; a Search that
L|Graph.KG.BM25Index.1|266|0|                // began on schema 1 finishes with the same numbers computed from df.
L|Graph.KG.BM25Index.1|267|0|                Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|268|0|                If df = 0 || (+$Get(^BM25Idx(name, "cfg", "schema"), 1) < 2) Continue
L|Graph.KG.BM25Index.1|269|0|                Set idf = $ZLN((N - df + 0.5) / (df + 0.5) + 1)
L|Graph.KG.BM25Index.1|270|0|            }
L|Graph.KG.BM25Index.1|271|0|        }
L|Graph.KG.BM25Index.1|272|0|        // Iterate posting list for this term
L|Graph.KG.BM25Index.1|273|0|        Set docId = ""
L|Graph.KG.BM25Index.1|274|0|        For {
L|Graph.KG.BM25Index.1|275|0|            Set docId = $Order(^BM25Idx(name, "tf", tok, docId), 1, tf)
L|Graph.KG.BM25Index.1|276|0|            Quit:docId=""
L|Graph.KG.BM25Index.1|277|0|            Set docLen = +$Get(^BM25Idx(name, "len", docId), 1)
L|Graph.KG.BM25Index.1|278|0|            // BM25 score contribution
L|Graph.KG.BM25Index.1|279|0|            // Parenthesised because ObjectScript evaluates strictly left to right. Written
L|Graph.KG.BM25Index.1|280|0|            // as `tf + k1 * (1 - b + b * docLen / avgdl)` this was
L|Graph.KG.BM25Index.1|281|0|            // `(tf + k1) * (((1 - b) + b) * docLen / avgdl)`, which equals BM25 only when
L|Graph.KG.BM25Index.1|282|0|            // every document has the average length.
L|Graph.KG.BM25Index.1|283|0|            Set numer = tf * (k1 + 1)
L|Graph.KG.BM25Index.1|284|0|            Set denom = tf + (k1 * ((1 - b) + (b * (docLen / avgdl))))
L|Graph.KG.BM25Index.1|285|0|            Set contrib = idf * numer / denom
L|Graph.KG.BM25Index.1|286|0|            Set ^||bm25scores(docId) = $Get(^||bm25scores(docId), 0) + contrib
L|Graph.KG.BM25Index.1|287|0|        }
L|Graph.KG.BM25Index.1|288|0|    }
L|Graph.KG.BM25Index.1|289|0|    // Sort by score descending ? collect top k
L|Graph.KG.BM25Index.1|290|0|    // Scale score to a 12-decimal fixed-point integer subscript so $Order
L|Graph.KG.BM25Index.1|291|0|    // gives ascending-numeric order; we iterate in reverse with $Order(...,-1).
L|Graph.KG.BM25Index.1|292|0|    // This avoids the "10M offset" overflow that breaks when BM25 scores exceed it.
L|Graph.KG.BM25Index.1|293|0|    Kill ^||bm25sorted
L|Graph.KG.BM25Index.1|294|0|    Set docId = ""
L|Graph.KG.BM25Index.1|295|0|    For {
L|Graph.KG.BM25Index.1|296|0|        Set docId = $Order(^||bm25scores(docId), 1, score)
L|Graph.KG.BM25Index.1|297|0|        Quit:docId=""
L|Graph.KG.BM25Index.1|298|0|        // Multiply by 1e12 and round to integer ? subscript safe for any BM25 score
L|Graph.KG.BM25Index.1|299|0|        Set sortKey = $NUMBER(score * 1000000000000, 0)
L|Graph.KG.BM25Index.1|300|0|        Set ^||bm25sorted(sortKey, docId) = score
L|Graph.KG.BM25Index.1|301|0|    }
L|Graph.KG.BM25Index.1|302|0|    // Walk in descending order using $Order with direction -1
L|Graph.KG.BM25Index.1|303|0|    Set result = "["
L|Graph.KG.BM25Index.1|304|0|    Set count = 0
L|Graph.KG.BM25Index.1|305|0|    Set sortKey = ""
L|Graph.KG.BM25Index.1|306|0|    For {
L|Graph.KG.BM25Index.1|307|0|        If count >= k Quit
L|Graph.KG.BM25Index.1|308|0|        Set sortKey = $Order(^||bm25sorted(sortKey), -1)
L|Graph.KG.BM25Index.1|309|0|        Quit:sortKey=""
L|Graph.KG.BM25Index.1|310|0|        Set docId = ""
L|Graph.KG.BM25Index.1|311|0|        For {
L|Graph.KG.BM25Index.1|312|0|            If count >= k Quit
L|Graph.KG.BM25Index.1|313|0|            Set docId = $Order(^||bm25sorted(sortKey, docId), 1, score)
L|Graph.KG.BM25Index.1|314|0|            Quit:docId=""
L|Graph.KG.BM25Index.1|315|0|            If count > 0 Set result = result_","
L|Graph.KG.BM25Index.1|316|0|            Set safeId = $Replace(docId, """", "\""")
L|Graph.KG.BM25Index.1|317|0|            // ObjectScript writes 0.5 as ".5", which is not JSON; a score under 1 was
L|Graph.KG.BM25Index.1|318|0|            // unparseable by every caller.
L|Graph.KG.BM25Index.1|319|0|            Set scoreText = $Select($Extract(score) = ".": "0"_score, 1: score)
L|Graph.KG.BM25Index.1|320|0|            Set result = result_"{""id"":"""_safeId_""",""score"":"_scoreText_"}"
L|Graph.KG.BM25Index.1|321|0|            Set count = count + 1
L|Graph.KG.BM25Index.1|322|0|        }
