L|Graph.KG.Communities.1|228|-9|SCCJson(topK=10000) methodimpl {
L|Graph.KG.Communities.1|229|-9|    If $Order(^NKG("$NI", "")) = "" Return "ERROR:^NKG not built"
L|Graph.KG.Communities.1|230|-9|    Kill ^||ccIndex, ^||ccLow, ^||ccOnStk, ^||ccSccStk, ^||ccComp, ^||ccFrame, ^||ccNbr, ^||ccNbrN
L|Graph.KG.Communities.1|231|-9|    Set counter = 0, sccStkTop = 0, compId = 0
L|Graph.KG.Communities.1|232|-9|    Set startNid = ""
L|Graph.KG.Communities.1|233|-9|    For {
L|Graph.KG.Communities.1|234|-9|        Set startNid = $Order(^NKG("$NI", startNid), 1, startIdx)
L|Graph.KG.Communities.1|235|-9|        Quit:startNid=""
L|Graph.KG.Communities.1|236|-9|        If $Data(^||ccIndex(startIdx)) Continue
L|Graph.KG.Communities.1|237|-9|        Set frameTop = 1
L|Graph.KG.Communities.1|238|-9|        Set ^||ccFrame(frameTop, "v") = startIdx
L|Graph.KG.Communities.1|239|-9|        Set ^||ccFrame(frameTop, "ci") = 0
L|Graph.KG.Communities.1|240|-9|        Set ^||ccIndex(startIdx) = counter, ^||ccLow(startIdx) = counter
L|Graph.KG.Communities.1|241|-9|        Set counter = counter + 1
L|Graph.KG.Communities.1|242|-9|        Set sccStkTop = sccStkTop + 1, ^||ccSccStk(sccStkTop) = startIdx, ^||ccOnStk(startIdx) = 1
L|Graph.KG.Communities.1|243|-9|        Do ..MaterializeNbrs(startIdx)
L|Graph.KG.Communities.1|244|-9|        While frameTop > 0 {
L|Graph.KG.Communities.1|245|-9|            Set v = ^||ccFrame(frameTop, "v")
L|Graph.KG.Communities.1|246|-9|            Set ci = ^||ccFrame(frameTop, "ci")
L|Graph.KG.Communities.1|247|-9|            Set nbrN = +$Get(^||ccNbrN(v), 0)
L|Graph.KG.Communities.1|248|-9|            Set advanced = 0
L|Graph.KG.Communities.1|249|-9|            While ci < nbrN {
L|Graph.KG.Communities.1|250|-9|                Set ci = ci + 1
L|Graph.KG.Communities.1|251|-9|                Set dst = ^||ccNbr(v, ci)
L|Graph.KG.Communities.1|252|-9|                If dst = v Continue
L|Graph.KG.Communities.1|253|-9|                If '$Data(^||ccIndex(dst)) {
L|Graph.KG.Communities.1|254|-9|                    Set ^||ccFrame(frameTop, "ci") = ci
L|Graph.KG.Communities.1|255|-9|                    Set frameTop = frameTop + 1
L|Graph.KG.Communities.1|256|-9|                    Set ^||ccFrame(frameTop, "v") = dst
L|Graph.KG.Communities.1|257|-9|                    Set ^||ccFrame(frameTop, "ci") = 0
L|Graph.KG.Communities.1|258|-9|                    Set ^||ccIndex(dst) = counter, ^||ccLow(dst) = counter
L|Graph.KG.Communities.1|259|-9|                    Set counter = counter + 1
L|Graph.KG.Communities.1|260|-9|                    Set sccStkTop = sccStkTop + 1, ^||ccSccStk(sccStkTop) = dst, ^||ccOnStk(dst) = 1
L|Graph.KG.Communities.1|261|-9|                    Do ..MaterializeNbrs(dst)
L|Graph.KG.Communities.1|262|-9|                    Set advanced = 1
L|Graph.KG.Communities.1|263|-9|                    Quit
L|Graph.KG.Communities.1|264|-9|                } ElseIf $Data(^||ccOnStk(dst)) {
L|Graph.KG.Communities.1|265|-9|                    If ^||ccIndex(dst) < ^||ccLow(v) Set ^||ccLow(v) = ^||ccIndex(dst)
L|Graph.KG.Communities.1|266|-9|                }
L|Graph.KG.Communities.1|267|-9|            }
L|Graph.KG.Communities.1|268|-9|            If advanced Continue
L|Graph.KG.Communities.1|269|-9|            If ^||ccLow(v) = ^||ccIndex(v) {
L|Graph.KG.Communities.1|270|-9|                Set members = "", msize = 0
L|Graph.KG.Communities.1|271|-9|                For {
L|Graph.KG.Communities.1|272|-9|                    Set w = ^||ccSccStk(sccStkTop)
L|Graph.KG.Communities.1|273|-9|                    Set sccStkTop = sccStkTop - 1
L|Graph.KG.Communities.1|274|-9|                    Kill ^||ccOnStk(w)
