L|Graph.KG.NKGAccelCentrality.1|495|-9|    Kill ^||msAdj, ^||msVisit, ^||msNext, ^||msSeen, ^||msFar, ^||msReach, ^||msIdxNid
L|Graph.KG.NKGAccelCentrality.1|496|-9|    Quit "OK:"_json_"]" }
L|Graph.KG.NKGAccelCentrality.1|497|-9|EigenvectorGlobal(maxIter=30,tol,topK=10000) methodimpl { s:'($d(tol)#2) tol=0.0001
L|Graph.KG.NKGAccelCentrality.1|498|-9|    Set firstNode = $Order(^NKG("$NI",""))
L|Graph.KG.NKGAccelCentrality.1|499|-9|    If firstNode = "" Quit "ERROR:^NKG not built"
L|Graph.KG.NKGAccelCentrality.1|500|-9|    Kill ^||x, ^||xNew, ^||nodeList
L|Graph.KG.NKGAccelCentrality.1|501|-9|    Set n = 0, nid = ""
L|Graph.KG.NKGAccelCentrality.1|502|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|503|-9|        Set nid = $Order(^NKG("$NI",nid))
L|Graph.KG.NKGAccelCentrality.1|504|-9|        Quit:nid=""
L|Graph.KG.NKGAccelCentrality.1|505|-9|        Set idx = ^NKG("$NI",nid)
L|Graph.KG.NKGAccelCentrality.1|506|-9|        Set ^||x(idx) = 1
L|Graph.KG.NKGAccelCentrality.1|507|-9|        Set ^||nodeList(idx) = nid
L|Graph.KG.NKGAccelCentrality.1|508|-9|        Set n = n + 1
L|Graph.KG.NKGAccelCentrality.1|509|-9|    }
L|Graph.KG.NKGAccelCentrality.1|510|-9|    If n = 0 Quit "ERROR:no nodes"
L|Graph.KG.NKGAccelCentrality.1|511|-9|    For i = 0:1:n-1 { Set ^||x(i) = 1/n }
L|Graph.KG.NKGAccelCentrality.1|512|-9|    For iter = 1:1:maxIter {
L|Graph.KG.NKGAccelCentrality.1|513|-9|        Set normSq = 0
L|Graph.KG.NKGAccelCentrality.1|514|-9|        For i = 0:1:n-1 { Set ^||xNew(i) = 0 }
L|Graph.KG.NKGAccelCentrality.1|515|-9|        Set src = ""
L|Graph.KG.NKGAccelCentrality.1|516|-9|        For {
L|Graph.KG.NKGAccelCentrality.1|517|-9|            Set src = $Order(^NKG("$NI",src))
L|Graph.KG.NKGAccelCentrality.1|518|-9|            Quit:src=""
L|Graph.KG.NKGAccelCentrality.1|519|-9|            Set sIdx = ^NKG("$NI",src)
L|Graph.KG.NKGAccelCentrality.1|520|-9|            Set xSrc = $Get(^||x(sIdx),0)
L|Graph.KG.NKGAccelCentrality.1|521|-9|            If xSrc = 0 Continue
L|Graph.KG.NKGAccelCentrality.1|522|-9|            Set negP = $Order(^NKG(-1,sIdx,""))
L|Graph.KG.NKGAccelCentrality.1|523|-9|            While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|524|-9|                Set oIdx = $Order(^NKG(-1,sIdx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|525|-9|                While oIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|526|-9|                    Set ^||xNew(oIdx) = $Get(^||xNew(oIdx),0) + xSrc
L|Graph.KG.NKGAccelCentrality.1|527|-9|                    Set oIdx = $Order(^NKG(-1,sIdx,negP,oIdx))
L|Graph.KG.NKGAccelCentrality.1|528|-9|                }
L|Graph.KG.NKGAccelCentrality.1|529|-9|                Set negP = $Order(^NKG(-1,sIdx,negP))
L|Graph.KG.NKGAccelCentrality.1|530|-9|            }
L|Graph.KG.NKGAccelCentrality.1|531|-9|        }
L|Graph.KG.NKGAccelCentrality.1|532|-9|        For i = 0:1:n-1 { Set normSq = normSq + ($Get(^||xNew(i),0) * $Get(^||xNew(i),0)) }
L|Graph.KG.NKGAccelCentrality.1|533|-9|        If normSq <= 0 Quit
L|Graph.KG.NKGAccelCentrality.1|534|-9|        Set norm = $ZSqr(normSq)
L|Graph.KG.NKGAccelCentrality.1|535|-9|        Set maxDelta = 0
L|Graph.KG.NKGAccelCentrality.1|536|-9|        For i = 0:1:n-1 {
L|Graph.KG.NKGAccelCentrality.1|537|-9|            Set newVal = $Get(^||xNew(i),0) / norm
L|Graph.KG.NKGAccelCentrality.1|538|-9|            Set delta = $ZAbs(newVal - $Get(^||x(i),0))
L|Graph.KG.NKGAccelCentrality.1|539|-9|            If delta > maxDelta Set maxDelta = delta
L|Graph.KG.NKGAccelCentrality.1|540|-9|            Set ^||x(i) = newVal
L|Graph.KG.NKGAccelCentrality.1|541|-9|        }
L|Graph.KG.NKGAccelCentrality.1|542|-9|        If maxDelta < tol Quit
L|Graph.KG.NKGAccelCentrality.1|543|-9|    }
L|Graph.KG.NKGAccelCentrality.1|544|-9|    Set json = "[", sep = "", cnt = 0
L|Graph.KG.NKGAccelCentrality.1|545|-9|    Set idx = -1
L|Graph.KG.NKGAccelCentrality.1|546|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|547|-9|        Set idx = $Order(^||nodeList(idx))
L|Graph.KG.NKGAccelCentrality.1|548|-9|        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|549|-9|        Set nid2 = ^||nodeList(idx)
