L|Graph.KG.NKGAccelAdjacency.1|62|0|                        Set ^||seedBFS("nextFrontier", dst) = ""
L|Graph.KG.NKGAccelAdjacency.1|63|0|                    }
L|Graph.KG.NKGAccelAdjacency.1|64|0|                }
L|Graph.KG.NKGAccelAdjacency.1|65|0|            }
L|Graph.KG.NKGAccelAdjacency.1|66|0|        }
L|Graph.KG.NKGAccelAdjacency.1|67|0|        If '$Data(^||seedBFS("nextFrontier")) Quit
