L|Graph.KG.NKGAccelCentrality.1|416|-9|    Set sIdx = ""
L|Graph.KG.NKGAccelCentrality.1|417|-9|    For {
L|Graph.KG.NKGAccelCentrality.1|418|-9|        Set sIdx = $Order(^||msIdxNid(sIdx))
L|Graph.KG.NKGAccelCentrality.1|419|-9|        Quit:sIdx=""
