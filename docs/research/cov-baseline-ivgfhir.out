L|Graph.KG.NKGAccelAdjacency.1|112|0|            Set ^||nodeIdx(node) = n
L|Graph.KG.NKGAccelAdjacency.1|113|0|            Set ^||nodeMap(n) = node
L|Graph.KG.NKGAccelAdjacency.1|114|0|            Set n = n + 1
L|Graph.KG.NKGAccelAdjacency.1|115|0|        }
L|Graph.KG.NKGAccelAdjacency.1|116|0|    }
L|Graph.KG.NKGAccelAdjacency.1|117|0|    // Pass 2: build adjacency
L|Graph.KG.NKGAccelAdjacency.1|118|0|    Set result = "", chunk = "", chunkNum = 0
L|Graph.KG.NKGAccelAdjacency.1|119|0|    Set src = ""
L|Graph.KG.NKGAccelAdjacency.1|120|0|    For {
L|Graph.KG.NKGAccelAdjacency.1|121|0|        Set src = $Order(^KG("out", src))
L|Graph.KG.NKGAccelAdjacency.1|122|0|        Quit:src=""
L|Graph.KG.NKGAccelAdjacency.1|123|0|        Set sIdx = $Get(^||nodeIdx(src))
L|Graph.KG.NKGAccelAdjacency.1|124|0|        If sIdx = "" Continue
L|Graph.KG.NKGAccelAdjacency.1|125|0|        Set nbrs = "", pred = ""
L|Graph.KG.NKGAccelAdjacency.1|126|0|        For {
L|Graph.KG.NKGAccelAdjacency.1|127|0|            Set pred = $Order(^KG("out", src, pred))
L|Graph.KG.NKGAccelAdjacency.1|128|0|            Quit:pred=""
