L|Graph.KG.NKGAccelCentrality.1|462|-9|                Quit:spos=0
L|Graph.KG.NKGAccelCentrality.1|463|-9|                Set s = spos-1
L|Graph.KG.NKGAccelCentrality.1|464|-9|                If formula = "classical" {
L|Graph.KG.NKGAccelCentrality.1|465|-9|                    Set ^||msFar(s) = $Get(^||msFar(s),0) + hop
L|Graph.KG.NKGAccelCentrality.1|466|-9|                    Set ^||msReach(s) = $Get(^||msReach(s),0) + 1
L|Graph.KG.NKGAccelCentrality.1|467|-9|                } Else {
L|Graph.KG.NKGAccelCentrality.1|468|-9|                    Set ^||msFar(s) = $Get(^||msFar(s),0) + (1/hop)
L|Graph.KG.NKGAccelCentrality.1|469|-9|                }
L|Graph.KG.NKGAccelCentrality.1|470|-9|            }
L|Graph.KG.NKGAccelCentrality.1|471|-9|        }
L|Graph.KG.NKGAccelCentrality.1|472|-9|    }
L|Graph.KG.NKGAccelCentrality.1|473|-9|    Set json = "["
L|Graph.KG.NKGAccelCentrality.1|474|-9|    Set sep = ""
L|Graph.KG.NKGAccelCentrality.1|475|-9|    Set emitted = 0
L|Graph.KG.NKGAccelCentrality.1|476|-9|    Set sIdx = ""
