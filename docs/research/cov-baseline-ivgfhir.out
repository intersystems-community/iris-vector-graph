L|Graph.KG.LedgerApply.1|283|-9|    Set tS  = ##class(Graph.KG.Ledger).MetaGet(tTuple, "s", "")
L|Graph.KG.LedgerApply.1|284|-9|    Set tP  = ##class(Graph.KG.Ledger).MetaGet(tTuple, "p", "")
