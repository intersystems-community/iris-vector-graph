L|Graph.KG.NKGAccelCentrality.1|409|-9|            While oIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|410|-9|                Set $BIT(^||msAdj(vIdx), oIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|411|-9|                Set oIdx = $Order(^NKG(adjDir,vIdx,negP,oIdx))
L|Graph.KG.NKGAccelCentrality.1|412|-9|            }
L|Graph.KG.NKGAccelCentrality.1|413|-9|            Set negP = $Order(^NKG(adjDir,vIdx,negP))
