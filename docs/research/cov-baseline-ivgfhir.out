L|Graph.KG.TraversalBFS.1|343|0|    } }
L|Graph.KG.TraversalBFS.1|344|0|TraverseWithPredicate(pGraph,s,p,hop,maxHops,nextP,dstLabel,pathId,results,nextFrontier,seen) methodimpl {
L|Graph.KG.TraversalBFS.1|345|0|    Set o = ""
L|Graph.KG.TraversalBFS.1|346|0|    For {
L|Graph.KG.TraversalBFS.1|347|0|        Set o = $Order(^KG("out", pGraph, s, p, o))
L|Graph.KG.TraversalBFS.1|348|0|        If o = "" Quit
L|Graph.KG.TraversalBFS.1|349|0|        // Filter by label if requested
L|Graph.KG.TraversalBFS.1|350|0|        If (dstLabel '= "") && ('$Data(^KG("label", pGraph, dstLabel, o))) Continue
L|Graph.KG.TraversalBFS.1|351|0|        // T014: O(1) Hop Rejection
L|Graph.KG.TraversalBFS.1|352|0|        If (hop < maxHops) && (nextP '= "") && ('$Data(^KG("degp", pGraph, o, nextP))) Continue
L|Graph.KG.TraversalBFS.1|353|0|        Set pathId = pathId + 1
L|Graph.KG.TraversalBFS.1|354|0|        Set obj = ##class(%Library.DynamicObject).%New()
L|Graph.KG.TraversalBFS.1|355|0|        Set obj.id = pathId
L|Graph.KG.TraversalBFS.1|356|0|        Set obj.step = hop
L|Graph.KG.TraversalBFS.1|357|0|        Set obj.s = s
L|Graph.KG.TraversalBFS.1|358|0|        Set obj.p = p
L|Graph.KG.TraversalBFS.1|359|0|        Set obj.o = o
L|Graph.KG.TraversalBFS.1|360|0|        Set obj.w = $Get(^KG("out", pGraph, s, p, o), 1.0)
L|Graph.KG.TraversalBFS.1|361|0|        Do results.%Push(obj)
L|Graph.KG.TraversalBFS.1|362|0|        If '$Data(seen(o)) Set nextFrontier(o) = ""
L|Graph.KG.TraversalBFS.1|363|0|    } }
L|Graph.KG.TraversalBFS.1|364|0|TraverseWithPredicateFast(pGraph,s,p,hop,maxHops,nextP,dstLabel,count,nextFrontier,seen) methodimpl {
L|Graph.KG.TraversalBFS.1|365|0|    Set o = ""
L|Graph.KG.TraversalBFS.1|366|0|    For {
L|Graph.KG.TraversalBFS.1|367|0|        Set o = $Order(^KG("out", pGraph, s, p, o))
L|Graph.KG.TraversalBFS.1|368|0|        If o = "" Quit
L|Graph.KG.TraversalBFS.1|369|0|        If (dstLabel '= "") && ('$Data(^KG("label", pGraph, dstLabel, o))) Continue
L|Graph.KG.TraversalBFS.1|370|0|        // Always record this hop's result ? leaf nodes at hop N are valid results
L|Graph.KG.TraversalBFS.1|371|0|        // even when hop N < maxHops.
L|Graph.KG.TraversalBFS.1|372|0|        Set count = count + 1
L|Graph.KG.TraversalBFS.1|373|0|        Set ^||BFS.Results(count) = $ListBuild(s, p, o, $Get(^KG("out", pGraph, s, p, o), 1.0), hop)
L|Graph.KG.TraversalBFS.1|374|0|        // Only add to nextFrontier if the node can continue on the next hop.
L|Graph.KG.TraversalBFS.1|375|0|        // The nextP lookahead prunes the frontier, not the result set.
L|Graph.KG.TraversalBFS.1|376|0|        If '$Data(seen(o)) {
L|Graph.KG.TraversalBFS.1|377|0|            If (hop < maxHops) && (nextP '= "") && ('$Data(^KG("degp", pGraph, o, nextP))) {
L|Graph.KG.TraversalBFS.1|378|0|                // Node has no next-hop edges ? don't add to frontier, but result was recorded.
L|Graph.KG.TraversalBFS.1|379|0|            } Else {
L|Graph.KG.TraversalBFS.1|380|0|                Set nextFrontier(o) = ""
L|Graph.KG.TraversalBFS.1|381|0|            }
L|Graph.KG.TraversalBFS.1|382|0|        }
L|Graph.KG.TraversalBFS.1|383|0|    } }
L|Graph.KG.TraversalBFS.1|384|0|TraverseWithPredicateFastInboun(pGraph,s,p,hop,count,nextFrontier,seen) methodimpl {
