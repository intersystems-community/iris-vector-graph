L|Graph.KG.NKGAccelTraversal.1|187|0|                        }
L|Graph.KG.NKGAccelTraversal.1|188|0|                    }
L|Graph.KG.NKGAccelTraversal.1|189|0|                }
L|Graph.KG.NKGAccelTraversal.1|190|0|            }
L|Graph.KG.NKGAccelTraversal.1|191|0|            If direction = "in" || (direction = "both") {
L|Graph.KG.NKGAccelTraversal.1|192|0|                Set pIdx2 = -99999999
L|Graph.KG.NKGAccelTraversal.1|193|0|                For {
L|Graph.KG.NKGAccelTraversal.1|194|0|                    Set pIdx2 = $Order(^NKG(-2, s, pIdx2))
L|Graph.KG.NKGAccelTraversal.1|195|0|                    Quit:(pIdx2="")!(pIdx2>=0)
L|Graph.KG.NKGAccelTraversal.1|196|0|                    If $IsObject(predsIdxArr) {
L|Graph.KG.NKGAccelTraversal.1|197|0|                        Set matched = 0
L|Graph.KG.NKGAccelTraversal.1|198|0|                        For pi = 0:1:(predsIdxArr.%Size()-1) {
L|Graph.KG.NKGAccelTraversal.1|199|0|                            If -(pIdx2+1) = predsIdxArr.%Get(pi) { Set matched = 1  Quit }
L|Graph.KG.NKGAccelTraversal.1|200|0|                        }
L|Graph.KG.NKGAccelTraversal.1|201|0|                        If 'matched Continue
L|Graph.KG.NKGAccelTraversal.1|202|0|                    }
L|Graph.KG.NKGAccelTraversal.1|203|0|                    Set oIdx = ""
L|Graph.KG.NKGAccelTraversal.1|204|0|                    For {
L|Graph.KG.NKGAccelTraversal.1|205|0|                        Set oIdx = $Order(^NKG(-2, s, pIdx2, oIdx))
L|Graph.KG.NKGAccelTraversal.1|206|0|                        Quit:oIdx=""
L|Graph.KG.NKGAccelTraversal.1|207|0|                        If '$Data(seen(oIdx)) {
L|Graph.KG.NKGAccelTraversal.1|208|0|                            Set seen(oIdx) = ""
L|Graph.KG.NKGAccelTraversal.1|209|0|                            Set nextFrontier(oIdx) = ""
L|Graph.KG.NKGAccelTraversal.1|210|0|                        }
L|Graph.KG.NKGAccelTraversal.1|211|0|                    }
L|Graph.KG.NKGAccelTraversal.1|212|0|                }
L|Graph.KG.NKGAccelTraversal.1|213|0|            }
