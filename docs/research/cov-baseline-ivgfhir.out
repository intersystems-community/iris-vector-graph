L|Graph.KG.TraversalBFS.1|140|0|    If (predsJson '= "") && (predsJson '= "null") {
L|Graph.KG.TraversalBFS.1|141|0|        Try {
L|Graph.KG.TraversalBFS.1|142|0|            Set preds = ##class(%Library.DynamicArray).%FromJSON(predsJson)
L|Graph.KG.TraversalBFS.1|143|0|        } Catch {
L|Graph.KG.TraversalBFS.1|144|0|            Set preds = ""
L|Graph.KG.TraversalBFS.1|145|0|        }
L|Graph.KG.TraversalBFS.1|146|0|    }
L|Graph.KG.TraversalBFS.1|147|0|    // Run BFSFast -- writes to ^||BFS.Results(i) = $ListBuild(s,p,o,w,step)
L|Graph.KG.TraversalBFS.1|148|0|    Set count = ..BFSFast(srcId, preds, maxHops, dstLabel, direction, 0, graph)
L|Graph.KG.TraversalBFS.1|149|0|    If count = 0 Return "[]"
L|Graph.KG.TraversalBFS.1|150|0|    // Build JSON array from ^||BFS.Results
L|Graph.KG.TraversalBFS.1|151|0|    Set result = ##class(%Library.DynamicArray).%New()
L|Graph.KG.TraversalBFS.1|152|0|    For i = 1:1:count {
L|Graph.KG.TraversalBFS.1|153|0|        Set lb = $Get(^||BFS.Results(i))
L|Graph.KG.TraversalBFS.1|154|0|        If lb = "" Continue
L|Graph.KG.TraversalBFS.1|155|0|        Set obj = ##class(%Library.DynamicObject).%New()
L|Graph.KG.TraversalBFS.1|156|0|        Do obj.%Set("s",    $ListGet(lb, 1))
L|Graph.KG.TraversalBFS.1|157|0|        Do obj.%Set("p",    $ListGet(lb, 2))
L|Graph.KG.TraversalBFS.1|158|0|        Do obj.%Set("o",    $ListGet(lb, 3))
L|Graph.KG.TraversalBFS.1|159|0|        Do obj.%Set("w",    +$ListGet(lb, 4))
L|Graph.KG.TraversalBFS.1|160|0|        Do obj.%Set("step", +$ListGet(lb, 5))
L|Graph.KG.TraversalBFS.1|161|0|        Do result.%Push(obj)
L|Graph.KG.TraversalBFS.1|162|0|    }
L|Graph.KG.TraversalBFS.1|163|0|    Return result.%ToJSON() }
L|Graph.KG.TraversalBFS.1|164|0|BFSFastJsonChunked(srcId,predsJson="",maxHops=2,dstLabel="",direction="out",maxResults=0,graph="") methodimpl {
L|Graph.KG.TraversalBFS.1|165|0|    Set preds = ""
L|Graph.KG.TraversalBFS.1|166|0|    If (predsJson '= "") && (predsJson '= "null") {
L|Graph.KG.TraversalBFS.1|167|0|        Try {
L|Graph.KG.TraversalBFS.1|168|0|            Set preds = ##class(%Library.DynamicArray).%FromJSON(predsJson)
L|Graph.KG.TraversalBFS.1|169|0|        } Catch {
L|Graph.KG.TraversalBFS.1|170|0|            Set preds = ""
L|Graph.KG.TraversalBFS.1|171|0|        }
L|Graph.KG.TraversalBFS.1|172|0|    }
L|Graph.KG.TraversalBFS.1|173|0|    Set count = ..BFSFast(srcId, preds, maxHops, dstLabel, direction, maxResults, graph)
L|Graph.KG.TraversalBFS.1|174|0|    If count = 0 Return "CHUNKED:0"
L|Graph.KG.TraversalBFS.1|175|0|    If (maxResults > 0) && (count > maxResults) Set count = maxResults
L|Graph.KG.TraversalBFS.1|176|0|    Set tag = $TR($ZHex($Now())_$ZHex($RANDOM(999999)),":.","__")
L|Graph.KG.TraversalBFS.1|177|0|    Set chunkSize = 9000
L|Graph.KG.TraversalBFS.1|178|0|    Set chunk = ""
L|Graph.KG.TraversalBFS.1|179|0|    Set chunkNum = 0
L|Graph.KG.TraversalBFS.1|180|0|    Set first = 1
L|Graph.KG.TraversalBFS.1|181|0|    For i = 1:1:count {
L|Graph.KG.TraversalBFS.1|182|0|        Set lb = $Get(^||BFS.Results(i))
L|Graph.KG.TraversalBFS.1|183|0|        If lb = "" Continue
L|Graph.KG.TraversalBFS.1|184|0|        Set obj = "{""s"":"""_..jsonEsc($ListGet(lb,1))_""",""p"":"""_..jsonEsc($ListGet(lb,2))_""",""o"":"""_..jsonEsc($ListGet(lb,3))_""",""w"":"_..jsonNum($ListGet(lb,4))_",""step"":"_(+$ListGet(lb,5))_"}"
L|Graph.KG.TraversalBFS.1|185|0|        If 'first Set obj = "," _ obj
L|Graph.KG.TraversalBFS.1|186|0|        Set first = 0
L|Graph.KG.TraversalBFS.1|187|0|        Set chunk = chunk _ obj
L|Graph.KG.TraversalBFS.1|188|0|        If $Length(chunk) > chunkSize {
L|Graph.KG.TraversalBFS.1|189|0|            Set chunkNum = chunkNum + 1
L|Graph.KG.TraversalBFS.1|190|0|            Set ^ArnoKG("bfs_chunk", tag, chunkNum) = chunk
L|Graph.KG.TraversalBFS.1|191|0|            Set chunk = ""
L|Graph.KG.TraversalBFS.1|192|0|        }
L|Graph.KG.TraversalBFS.1|193|0|    }
L|Graph.KG.TraversalBFS.1|194|0|    If chunk '= "" {
L|Graph.KG.TraversalBFS.1|195|0|        Set chunkNum = chunkNum + 1
L|Graph.KG.TraversalBFS.1|196|0|        Set ^ArnoKG("bfs_chunk", tag, chunkNum) = chunk
L|Graph.KG.TraversalBFS.1|197|0|    }
L|Graph.KG.TraversalBFS.1|198|0|    Return "CHUNKED:" _ tag _ ":" _ chunkNum }
L|Graph.KG.TraversalBFS.1|199|0|BFSFastJsonDirect(srcId,predsJson="",maxHops=2,dstLabel="",direction="out",graph="") methodimpl {
L|Graph.KG.TraversalBFS.1|200|0|    Set preds = ""
L|Graph.KG.TraversalBFS.1|201|0|    If (predsJson '= "") && (predsJson '= "null") {
L|Graph.KG.TraversalBFS.1|202|0|        Try { Set preds = ##class(%Library.DynamicArray).%FromJSON(predsJson) } Catch { Set preds = "" }
L|Graph.KG.TraversalBFS.1|203|0|    }
L|Graph.KG.TraversalBFS.1|204|0|    Set count = ..BFSFast(srcId, preds, maxHops, dstLabel, direction, 0, graph)
L|Graph.KG.TraversalBFS.1|205|0|    If count = 0 Return "[]"
L|Graph.KG.TraversalBFS.1|206|0|    // Build JSON without per-row %DynamicObject allocation.
L|Graph.KG.TraversalBFS.1|207|0|    // NOTE: wins at hops=1 (small row counts); at hops>=2 %DynamicArray's C-level
L|Graph.KG.TraversalBFS.1|208|0|    // internal builder is faster than ObjectScript string concat regardless of strategy.
L|Graph.KG.TraversalBFS.1|209|0|    // Beating it for large result sets requires a C callout (libarno or similar).
L|Graph.KG.TraversalBFS.1|210|0|    Set result = "["
L|Graph.KG.TraversalBFS.1|211|0|    Set first = 1
L|Graph.KG.TraversalBFS.1|212|0|    For i = 1:1:count {
L|Graph.KG.TraversalBFS.1|213|0|        Set lb = $Get(^||BFS.Results(i))
L|Graph.KG.TraversalBFS.1|214|0|        If lb = "" Continue
L|Graph.KG.TraversalBFS.1|215|0|        If 'first Set result = result _ ","
L|Graph.KG.TraversalBFS.1|216|0|        Set first = 0
L|Graph.KG.TraversalBFS.1|217|0|        Set s = $ListGet(lb, 1)
L|Graph.KG.TraversalBFS.1|218|0|        Set p = $ListGet(lb, 2)
L|Graph.KG.TraversalBFS.1|219|0|        Set o = $ListGet(lb, 3)
L|Graph.KG.TraversalBFS.1|220|0|        If $Find(s, """") Set s = $Replace(s, """", "\""")
L|Graph.KG.TraversalBFS.1|221|0|        If $Find(p, """") Set p = $Replace(p, """", "\""")
L|Graph.KG.TraversalBFS.1|222|0|        If $Find(o, """") Set o = $Replace(o, """", "\""")
L|Graph.KG.TraversalBFS.1|223|0|        Set result = result
L|Graph.KG.TraversalBFS.1|224|0|            _ "{""s"":""" _ ..jsonEsc(s) _ """,""p"":""" _ ..jsonEsc(p) _ """,""o"":""" _ ..jsonEsc(o) _ """,""w"":" _ ..jsonNum($ListGet(lb, 4)) _ ",""step"":" _ +$ListGet(lb, 5) _ "}"
L|Graph.KG.TraversalBFS.1|225|0|    }
L|Graph.KG.TraversalBFS.1|226|0|    Return result _ "]" }
