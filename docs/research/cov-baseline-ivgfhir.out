L|Graph.KG.NKGAccelAdjacency.1|45|0|                        Set ^||seedBFS("nextFrontier", dst) = ""
L|Graph.KG.NKGAccelAdjacency.1|46|0|                    }
L|Graph.KG.NKGAccelAdjacency.1|47|0|                }
L|Graph.KG.NKGAccelAdjacency.1|48|0|            }
L|Graph.KG.NKGAccelAdjacency.1|49|0|            // Inbound traversal for undirected
L|Graph.KG.NKGAccelAdjacency.1|50|0|            Set pred = ""
L|Graph.KG.NKGAccelAdjacency.1|51|0|            For {
L|Graph.KG.NKGAccelAdjacency.1|52|0|                Set pred = $Order(^NKG(-2, s, pred))
L|Graph.KG.NKGAccelAdjacency.1|53|0|                Quit:pred=""
L|Graph.KG.NKGAccelAdjacency.1|54|0|                Set dst = ""
L|Graph.KG.NKGAccelAdjacency.1|55|0|                For {
L|Graph.KG.NKGAccelAdjacency.1|56|0|                    Set dst = $Order(^NKG(-2, s, pred, dst))
L|Graph.KG.NKGAccelAdjacency.1|57|0|                    Quit:dst=""
L|Graph.KG.NKGAccelAdjacency.1|58|0|                    Set ^||seedBFS("nodes", s) = ""
L|Graph.KG.NKGAccelAdjacency.1|59|0|                    Set ^||seedBFS("nodes", dst) = ""
L|Graph.KG.NKGAccelAdjacency.1|60|0|                    If '$Data(^||seedBFS("seen", dst)) {
