L|Graph.KG.Communities.1|276|-9|                    Quit:w=v
L|Graph.KG.Communities.1|277|-9|                }
L|Graph.KG.Communities.1|278|-9|                Set ^||ccComp(compId) = $LB(msize, members)
L|Graph.KG.Communities.1|279|-9|                Set compId = compId + 1
L|Graph.KG.Communities.1|280|-9|            }
L|Graph.KG.Communities.1|281|-9|            Set frameTop = frameTop - 1
L|Graph.KG.Communities.1|282|-9|            If frameTop > 0 {
L|Graph.KG.Communities.1|283|-9|                Set parent = ^||ccFrame(frameTop, "v")
L|Graph.KG.Communities.1|284|-9|                If ^||ccLow(v) < ^||ccLow(parent) Set ^||ccLow(parent) = ^||ccLow(v)
L|Graph.KG.Communities.1|285|-9|            }
L|Graph.KG.Communities.1|286|-9|        }
L|Graph.KG.Communities.1|287|-9|    }
L|Graph.KG.Communities.1|288|-9|    Kill ^||ccCompSort
L|Graph.KG.Communities.1|289|-9|    Set c = ""
L|Graph.KG.Communities.1|290|-9|    For {
L|Graph.KG.Communities.1|291|-9|        Set c = $Order(^||ccComp(c), 1, cdata)
L|Graph.KG.Communities.1|292|-9|        Quit:c=""
L|Graph.KG.Communities.1|293|-9|        Set ^||ccCompSort(-$List(cdata, 1), c) = cdata
L|Graph.KG.Communities.1|294|-9|    }
L|Graph.KG.Communities.1|295|-9|    Set json = "[", sep = "", emitted = 0, newId = 0
L|Graph.KG.Communities.1|296|-9|    Set negSize = ""
L|Graph.KG.Communities.1|297|-9|    For {
L|Graph.KG.Communities.1|298|-9|        Set negSize = $Order(^||ccCompSort(negSize))
L|Graph.KG.Communities.1|299|-9|        Quit:negSize=""
L|Graph.KG.Communities.1|300|-9|        Set c = ""
L|Graph.KG.Communities.1|301|-9|        For {
L|Graph.KG.Communities.1|302|-9|            Set c = $Order(^||ccCompSort(negSize, c), 1, cdata)
L|Graph.KG.Communities.1|303|-9|            Quit:c=""
L|Graph.KG.Communities.1|304|-9|            Set msize = $List(cdata, 1), members = $List(cdata, 2)
L|Graph.KG.Communities.1|305|-9|            For mi = 1:1:$Length(members, ",") - 1 {
L|Graph.KG.Communities.1|306|-9|                Set memIdx = $Piece(members, ",", mi)
L|Graph.KG.Communities.1|307|-9|                Set nid = $Get(^NKG("$ND", memIdx), memIdx)
L|Graph.KG.Communities.1|308|-9|                Set json = json _ sep _ "{""id"":""" _ nid _ """,""component"":" _ newId _ ",""size"":" _ msize _ "}"
L|Graph.KG.Communities.1|309|-9|                Set sep = ","
L|Graph.KG.Communities.1|310|-9|                Set emitted = emitted + 1
L|Graph.KG.Communities.1|311|-9|            }
L|Graph.KG.Communities.1|312|-9|            Set newId = newId + 1
L|Graph.KG.Communities.1|313|-9|            If (topK > 0) && (emitted >= topK) Quit
