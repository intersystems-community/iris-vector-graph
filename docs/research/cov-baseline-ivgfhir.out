L|Graph.KG.LedgerApply.1|316|-9|        Set tS = tRS.%GetData(2), tP = tRS.%GetData(3), tO = tRS.%GetData(4), tG = tRS.%GetData(5)
L|Graph.KG.LedgerApply.1|317|-9|        Set tStmt = $Get(^IVG.Ledger("tuple", tS, tP, tO, ##class(Graph.KG.Ledger).GKey(tG)), "")
L|Graph.KG.LedgerApply.1|318|-9|        Set tFlags = "cascade"
