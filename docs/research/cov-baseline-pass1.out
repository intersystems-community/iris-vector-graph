L|Graph.KG.FHIRGraph.1|1809|0|		} Else {
L|Graph.KG.FHIRGraph.1|1810|0|			Set tUnres(tPred, tTarget) = $Select(tTLive = -1: "deleted", 1: "missing")
L|Graph.KG.FHIRGraph.1|1811|0|		}
L|Graph.KG.FHIRGraph.1|1812|0|	}
L|Graph.KG.FHIRGraph.1|1813|0|	// Canonicals resolve against the definitions table by the rule (research R7).
L|Graph.KG.FHIRGraph.1|1814|0|	Kill tCands
L|Graph.KG.FHIRGraph.1|1815|0|	Set tParam = ""
L|Graph.KG.FHIRGraph.1|1816|0|	For {
