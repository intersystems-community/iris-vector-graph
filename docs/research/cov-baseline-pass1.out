L|Graph.KG.BM25Index.1|182|3|            Set ^BM25Idx(name, "cfg", "N") = ^BM25Idx(name, "cfg", "N") + 1
L|Graph.KG.BM25Index.1|183|3|            Set ^BM25Idx(name, "cfg", "totalLen") = ^BM25Idx(name, "cfg", "totalLen") + docLen
L|Graph.KG.BM25Index.1|184|0|        }
