L|Graph.KG.BM25Index.1|170|3|            Set tok = ""
L|Graph.KG.BM25Index.1|171|3|            For {
L|Graph.KG.BM25Index.1|172|12|                Set tok = $Order(tfMap(tok))
L|Graph.KG.BM25Index.1|173|12|                Quit:tok=""
L|Graph.KG.BM25Index.1|174|9|                Set ^BM25Idx(name, "tf", tok, docId) = tfMap(tok)
