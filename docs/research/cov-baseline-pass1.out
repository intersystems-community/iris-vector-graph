L|Graph.KG.NKGAccelCentrality.1|108|0|    // Try arno fast path ? reuses BETWEENNESS_ADJ_CACHE, extracts subgraph in Rust
L|Graph.KG.NKGAccelCentrality.1|109|0|    Try {
L|Graph.KG.NKGAccelCentrality.1|110|14|        If ##class(Graph.KG.NKGAccelLoader).IsLoaded() {
