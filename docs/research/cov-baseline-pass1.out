L|Graph.KG.FHIRGraph.1|1870|0|	}
L|Graph.KG.FHIRGraph.1|1871|0|	// --- diff against the edges the graph holds ------------------------------
L|Graph.KG.FHIRGraph.1|1872|0|	Kill tHave
L|Graph.KG.FHIRGraph.1|1873|0|	Set tRs = ..Query("SELECT edge_id, p, o_id, qualifiers FROM Graph_KG.rdf_edges WHERE graph_id = ? AND s = ?", ..GraphId, pKey)
L|Graph.KG.FHIRGraph.1|1874|0|	Kill tRows
L|Graph.KG.FHIRGraph.1|1875|0|	While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1876|0|		Set tRows($Increment(tRows)) = $ListBuild(tRs.%GetData(1), tRs.%GetData(2), tRs.%GetData(3), tRs.%GetData(4))
