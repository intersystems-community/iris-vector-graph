L|Graph.KG.NKGAccelCentrality.1|309|929|        Quit:nidTmp=""
L|Graph.KG.NKGAccelCentrality.1|310|922|        Set n = n + 1
L|Graph.KG.NKGAccelCentrality.1|311|922|    }
L|Graph.KG.NKGAccelCentrality.1|312|7|    If n = 0 { Quit "ERROR:^NKG nodeCount=0" }
L|Graph.KG.NKGAccelCentrality.1|313|7|    Set json = "["
