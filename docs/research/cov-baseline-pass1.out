L|Graph.KG.BM25Index.1|234|0|Search(name,queryText,k=10) methodimpl {
L|Graph.KG.BM25Index.1|235|0|    // Load config
L|Graph.KG.BM25Index.1|236|16|    Set N = +$Get(^BM25Idx(name, "cfg", "N"), 0)
L|Graph.KG.BM25Index.1|237|16|    If N = 0 || (queryText = "") Return "[]"
L|Graph.KG.BM25Index.1|238|0|    // Schema 2 derives avgdl and IDF from N, totalLen and df; schema 1 reads what Build
L|Graph.KG.BM25Index.1|239|0|    // and Insert stored. The schema is read once, before anything else, so a Search never
L|Graph.KG.BM25Index.1|240|0|    // mixes the two shapes (Upgrade sets it last).
L|Graph.KG.BM25Index.1|241|10|    Set schema = +$Get(^BM25Idx(name, "cfg", "schema"), 1)
L|Graph.KG.BM25Index.1|242|10|    If schema >= 2 {
L|Graph.KG.BM25Index.1|243|10|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "totalLen"), 0) / N
L|Graph.KG.BM25Index.1|244|0|    } Else {
L|Graph.KG.BM25Index.1|245|0|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "avgdl"), 1)
L|Graph.KG.BM25Index.1|246|0|    }
L|Graph.KG.BM25Index.1|247|10|    If avgdl <= 0 Set avgdl = 1
L|Graph.KG.BM25Index.1|248|10|    Set k1 = +$Get(^BM25Idx(name, "cfg", "k1"), 1.5)
L|Graph.KG.BM25Index.1|249|10|    Set b = +$Get(^BM25Idx(name, "cfg", "b"), 0.75)
L|Graph.KG.BM25Index.1|250|0|    // Tokenize query
L|Graph.KG.BM25Index.1|251|10|    Set queryTokens = ..Tokenize(queryText)
L|Graph.KG.BM25Index.1|252|10|    If $LISTLENGTH(queryTokens) = 0 Return "[]"
L|Graph.KG.BM25Index.1|253|0|    // Accumulate BM25 scores per doc in process-private array
L|Graph.KG.BM25Index.1|254|10|    Kill ^||bm25scores
L|Graph.KG.BM25Index.1|255|10|    Set tIdx = 0
L|Graph.KG.BM25Index.1|256|10|    While $LISTNEXT(queryTokens, tIdx, tok) {
L|Graph.KG.BM25Index.1|257|12|        If tok = "" Continue
L|Graph.KG.BM25Index.1|258|12|        If schema >= 2 {
L|Graph.KG.BM25Index.1|259|12|            Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|260|12|            If df = 0 Continue
L|Graph.KG.BM25Index.1|261|12|            Set idf = $ZLN((N - df + 0.5) / (df + 0.5) + 1)
L|Graph.KG.BM25Index.1|262|0|        } Else {
L|Graph.KG.BM25Index.1|263|0|            Set idf = +$Get(^BM25Idx(name, "idf", tok), 0)
L|Graph.KG.BM25Index.1|264|0|            If idf = 0 {
L|Graph.KG.BM25Index.1|265|0|                // Upgrade removes the stored idf after it sets schema 2; a Search that
L|Graph.KG.BM25Index.1|266|0|                // began on schema 1 finishes with the same numbers computed from df.
L|Graph.KG.BM25Index.1|267|0|                Set df = +$Get(^BM25Idx(name, "df", tok), 0)
L|Graph.KG.BM25Index.1|268|0|                If df = 0 || (+$Get(^BM25Idx(name, "cfg", "schema"), 1) < 2) Continue
L|Graph.KG.BM25Index.1|269|0|                Set idf = $ZLN((N - df + 0.5) / (df + 0.5) + 1)
L|Graph.KG.BM25Index.1|270|0|            }
L|Graph.KG.BM25Index.1|271|0|        }
L|Graph.KG.BM25Index.1|272|0|        // Iterate posting list for this term
L|Graph.KG.BM25Index.1|273|12|        Set docId = ""
L|Graph.KG.BM25Index.1|274|12|        For {
L|Graph.KG.BM25Index.1|275|28|            Set docId = $Order(^BM25Idx(name, "tf", tok, docId), 1, tf)
L|Graph.KG.BM25Index.1|276|28|            Quit:docId=""
L|Graph.KG.BM25Index.1|277|16|            Set docLen = +$Get(^BM25Idx(name, "len", docId), 1)
L|Graph.KG.BM25Index.1|278|0|            // BM25 score contribution
L|Graph.KG.BM25Index.1|279|0|            // Parenthesised because ObjectScript evaluates strictly left to right. Written
L|Graph.KG.BM25Index.1|280|0|            // as `tf + k1 * (1 - b + b * docLen / avgdl)` this was
L|Graph.KG.BM25Index.1|281|0|            // `(tf + k1) * (((1 - b) + b) * docLen / avgdl)`, which equals BM25 only when
L|Graph.KG.BM25Index.1|282|0|            // every document has the average length.
L|Graph.KG.BM25Index.1|283|16|            Set numer = tf * (k1 + 1)
L|Graph.KG.BM25Index.1|284|16|            Set denom = tf + (k1 * ((1 - b) + (b * (docLen / avgdl))))
L|Graph.KG.BM25Index.1|285|16|            Set contrib = idf * numer / denom
L|Graph.KG.BM25Index.1|286|16|            Set ^||bm25scores(docId) = $Get(^||bm25scores(docId), 0) + contrib
L|Graph.KG.BM25Index.1|287|16|        }
L|Graph.KG.BM25Index.1|288|12|    }
L|Graph.KG.BM25Index.1|289|0|    // Sort by score descending ? collect top k
L|Graph.KG.BM25Index.1|290|0|    // Scale score to a 12-decimal fixed-point integer subscript so $Order
L|Graph.KG.BM25Index.1|291|0|    // gives ascending-numeric order; we iterate in reverse with $Order(...,-1).
L|Graph.KG.BM25Index.1|292|0|    // This avoids the "10M offset" overflow that breaks when BM25 scores exceed it.
L|Graph.KG.BM25Index.1|293|10|    Kill ^||bm25sorted
L|Graph.KG.BM25Index.1|294|10|    Set docId = ""
L|Graph.KG.BM25Index.1|295|10|    For {
L|Graph.KG.BM25Index.1|296|25|        Set docId = $Order(^||bm25scores(docId), 1, score)
L|Graph.KG.BM25Index.1|297|25|        Quit:docId=""
L|Graph.KG.BM25Index.1|298|0|        // Multiply by 1e12 and round to integer ? subscript safe for any BM25 score
L|Graph.KG.BM25Index.1|299|15|        Set sortKey = $NUMBER(score * 1000000000000, 0)
L|Graph.KG.BM25Index.1|300|15|        Set ^||bm25sorted(sortKey, docId) = score
L|Graph.KG.BM25Index.1|301|15|    }
L|Graph.KG.BM25Index.1|302|0|    // Walk in descending order using $Order with direction -1
L|Graph.KG.BM25Index.1|303|10|    Set result = "["
L|Graph.KG.BM25Index.1|304|10|    Set count = 0
L|Graph.KG.BM25Index.1|305|10|    Set sortKey = ""
L|Graph.KG.BM25Index.1|306|10|    For {
L|Graph.KG.BM25Index.1|307|25|        If count >= k Quit
L|Graph.KG.BM25Index.1|308|25|        Set sortKey = $Order(^||bm25sorted(sortKey), -1)
L|Graph.KG.BM25Index.1|309|25|        Quit:sortKey=""
L|Graph.KG.BM25Index.1|310|15|        Set docId = ""
L|Graph.KG.BM25Index.1|311|15|        For {
L|Graph.KG.BM25Index.1|312|30|            If count >= k Quit
L|Graph.KG.BM25Index.1|313|30|            Set docId = $Order(^||bm25sorted(sortKey, docId), 1, score)
L|Graph.KG.BM25Index.1|314|30|            Quit:docId=""
L|Graph.KG.BM25Index.1|315|15|            If count > 0 Set result = result_","
L|Graph.KG.BM25Index.1|316|15|            Set safeId = $Replace(docId, """", "\""")
