L|Graph.KG.Benchmark.1|12|-9|    Write "Standard BFS (Objects): ", duration, "s | Count: ", results.%Size(), !
L|Graph.KG.Benchmark.1|13|-9|    // 2. Fast BFS (PPG + ListBuild)
