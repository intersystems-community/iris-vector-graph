L|Graph.KG.FHIRGraph.1|1549|0|	} Catch tEx {
L|Graph.KG.FHIRGraph.1|1550|0|		While $TLevel > tLevel { TROLLBACK 1 }
L|Graph.KG.FHIRGraph.1|1551|0|		Set tOut = ..Err(tEx)
L|Graph.KG.FHIRGraph.1|1552|0|		Do ..RecordError(pGraph, tOut)
L|Graph.KG.FHIRGraph.1|1553|0|	}
L|Graph.KG.FHIRGraph.1|1554|0|	If tLocked { Lock -^IVG.FHIRGraph(pGraph) }
L|Graph.KG.FHIRGraph.1|1555|0|	Return tOut }
L|Graph.KG.FHIRGraph.1|1556|0|Resolve(pUrl,pVersion,pCandJson) methodimpl {
L|Graph.KG.FHIRGraph.1|1557|0|	Try {
L|Graph.KG.FHIRGraph.1|1558|0|		Set tCands = ##class(%Library.DynamicObject).%FromJSON(pCandJson)
L|Graph.KG.FHIRGraph.1|1559|0|		Set tIter = tCands.%GetIterator()
L|Graph.KG.FHIRGraph.1|1560|0|		While tIter.%GetNext(.tKey, .tVer) {
L|Graph.KG.FHIRGraph.1|1561|0|			Set tCand(tKey) = $Select(tCands.%GetTypeOf(tKey) = "null": "", 1: tVer)
L|Graph.KG.FHIRGraph.1|1562|0|		}
L|Graph.KG.FHIRGraph.1|1563|0|		Set tOutcome = ..ResolveCands(pVersion, .tCand, .tTarget)
L|Graph.KG.FHIRGraph.1|1564|0|		Set tOut = {"outcome": (tOutcome), "target": (tTarget)}.%ToJSON()
L|Graph.KG.FHIRGraph.1|1565|0|	} Catch tEx {
L|Graph.KG.FHIRGraph.1|1566|0|		Set tOut = ..Err(tEx)
L|Graph.KG.FHIRGraph.1|1567|0|	}
L|Graph.KG.FHIRGraph.1|1568|0|	Return tOut }
L|Graph.KG.FHIRGraph.1|1569|0|ResolveCands(pVersion,pCand,pTarget) methodimpl {
L|Graph.KG.FHIRGraph.1|1570|0|	Set pTarget = ""
L|Graph.KG.FHIRGraph.1|1571|0|	If $Order(pCand("")) = "" {
L|Graph.KG.FHIRGraph.1|1572|0|		Return "no-definition"
L|Graph.KG.FHIRGraph.1|1573|0|	}
L|Graph.KG.FHIRGraph.1|1574|0|	Set tHits = 0, tKey = ""
L|Graph.KG.FHIRGraph.1|1575|0|	For {
L|Graph.KG.FHIRGraph.1|1576|0|		Set tKey = $Order(pCand(tKey), 1, tVer)
L|Graph.KG.FHIRGraph.1|1577|0|		Quit:tKey=""
L|Graph.KG.FHIRGraph.1|1578|0|		Continue:(pVersion'="")&&(tVer'=pVersion)
L|Graph.KG.FHIRGraph.1|1579|0|		Set tHits = tHits + 1, tHit = tKey
L|Graph.KG.FHIRGraph.1|1580|0|	}
L|Graph.KG.FHIRGraph.1|1581|0|	If tHits = 1 {
L|Graph.KG.FHIRGraph.1|1582|0|		Set pTarget = tHit
L|Graph.KG.FHIRGraph.1|1583|0|		Return "resolved"
L|Graph.KG.FHIRGraph.1|1584|0|	}
L|Graph.KG.FHIRGraph.1|1585|0|	Return $Select(tHits > 1: "ambiguous", 1: "version-not-found") }
L|Graph.KG.FHIRGraph.1|1586|0|ResolveConcepts(pGraph,pConceptGraph="",pIdsJson="[]",pParamsJson="",pRelationsJson="") methodimpl {
L|Graph.KG.FHIRGraph.1|1587|0|	Set tOut = ""
L|Graph.KG.FHIRGraph.1|1588|0|	Try {
L|Graph.KG.FHIRGraph.1|1589|0|		Set tStart = $ZHorolog
L|Graph.KG.FHIRGraph.1|1590|0|		Set tCtx = ..Open(pGraph)
L|Graph.KG.FHIRGraph.1|1591|0|		Set tConceptName = ##class(Graph.KG.GraphKey).ForName(pConceptGraph)
L|Graph.KG.FHIRGraph.1|1592|0|		Set tIds = ##class(%Library.DynamicAbstractObject).%FromJSON(pIdsJson)
L|Graph.KG.FHIRGraph.1|1593|0|		Set tParams = $Select(pParamsJson = "": ["code"], 1: ##class(%Library.DynamicAbstractObject).%FromJSON(pParamsJson))
L|Graph.KG.FHIRGraph.1|1594|0|		Set tRels = $Select(pRelationsJson = "": ["exact", "broader", "narrower", "related"], 1: ##class(%Library.DynamicAbstractObject).%FromJSON(pRelationsJson))
L|Graph.KG.FHIRGraph.1|1595|0|		Kill tRelOk
L|Graph.KG.FHIRGraph.1|1596|0|		Set tIt = tRels.%GetIterator()
L|Graph.KG.FHIRGraph.1|1597|0|		While tIt.%GetNext(, .tR) { Set tRelOk(tR) = "" }
L|Graph.KG.FHIRGraph.1|1598|0|		// (system, code) pairs for the concepts.
L|Graph.KG.FHIRGraph.1|1599|0|		Kill tCodes
L|Graph.KG.FHIRGraph.1|1600|0|		Set tNCodes = 0
L|Graph.KG.FHIRGraph.1|1601|0|		// A "" bind arrives as NULL and matches nothing, so the default graph is a literal.
L|Graph.KG.FHIRGraph.1|1602|0|		Set tXwSql = "SELECT code_system_uri, code, relation FROM Graph_KG.code_crosswalk WHERE target_node_id = ? AND target_graph = " _ $Select(tConceptName = "": "''", 1: "?")
L|Graph.KG.FHIRGraph.1|1603|0|		Set tIt = tIds.%GetIterator()
L|Graph.KG.FHIRGraph.1|1604|0|		While tIt.%GetNext(, .tId) {
L|Graph.KG.FHIRGraph.1|1605|0|			If tConceptName = "" {
L|Graph.KG.FHIRGraph.1|1606|0|				Set tRs = tCtx.Query(tXwSql, tId)
L|Graph.KG.FHIRGraph.1|1607|0|			} Else {
L|Graph.KG.FHIRGraph.1|1608|0|				Set tRs = tCtx.Query(tXwSql, tId, tConceptName)
L|Graph.KG.FHIRGraph.1|1609|0|			}
L|Graph.KG.FHIRGraph.1|1610|0|			While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1611|0|				Continue:'$Data(tRelOk(tRs.%GetData(3)))
L|Graph.KG.FHIRGraph.1|1612|0|				Set tSys = tRs.%GetData(1)
L|Graph.KG.FHIRGraph.1|1613|0|				Set tCode = tRs.%GetData(2)
L|Graph.KG.FHIRGraph.1|1614|0|				If '$Data(tCodes(tSys, tCode)) {
L|Graph.KG.FHIRGraph.1|1615|0|					Set tCodes(tSys, tCode) = ""
L|Graph.KG.FHIRGraph.1|1616|0|					Set tNCodes = tNCodes + 1
L|Graph.KG.FHIRGraph.1|1617|0|				}
L|Graph.KG.FHIRGraph.1|1618|0|			}
L|Graph.KG.FHIRGraph.1|1619|0|		}
L|Graph.KG.FHIRGraph.1|1620|0|		// Token columns for the params, restricted to the resource types present.
L|Graph.KG.FHIRGraph.1|1621|0|		Kill tTypes
L|Graph.KG.FHIRGraph.1|1622|0|		Set tRs = tCtx.Query("SELECT DISTINCT ResourceType FROM " _ tCtx.RTable() _ " WHERE Deleted = 0")
L|Graph.KG.FHIRGraph.1|1623|0|		While tRs.%Next() { Set tTypes(tRs.%GetData(1)) = "" }
L|Graph.KG.FHIRGraph.1|1624|0|		Kill tTok
L|Graph.KG.FHIRGraph.1|1625|0|		Set tIt = tParams.%GetIterator()
L|Graph.KG.FHIRGraph.1|1626|0|		While tIt.%GetNext(, .tParam) {
L|Graph.KG.FHIRGraph.1|1627|0|			Set tRs = tCtx.Query("SELECT ResourceType, TableName, ColumnName, isMultiValue FROM " _ ..#SEARCHCOLUMN _ " WHERE RepoKey = ? AND %UPPER(Type) = 'TOKEN' AND ParamName = ?", tCtx.RepoId, tParam)
L|Graph.KG.FHIRGraph.1|1628|0|			While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1629|0|				Set tType = tRs.%GetData(1)
L|Graph.KG.FHIRGraph.1|1630|0|				Continue:'$Data(tTypes(tType))
L|Graph.KG.FHIRGraph.1|1631|0|				Set tTok($Increment(tTok)) = $ListBuild(tRs.%GetData(2), tRs.%GetData(3), +tRs.%GetData(4))
L|Graph.KG.FHIRGraph.1|1632|0|			}
L|Graph.KG.FHIRGraph.1|1633|0|		}
L|Graph.KG.FHIRGraph.1|1634|0|		Set tKeys = []
L|Graph.KG.FHIRGraph.1|1635|0|		Kill tSeen
L|Graph.KG.FHIRGraph.1|1636|0|		For tI = 1:1:$Get(tTok) {
L|Graph.KG.FHIRGraph.1|1637|0|			Set tTable = $ListGet(tTok(tI), 1)
L|Graph.KG.FHIRGraph.1|1638|0|			Set tCol = $ListGet(tTok(tI), 2)
L|Graph.KG.FHIRGraph.1|1639|0|			If $ListGet(tTok(tI), 3) {
L|Graph.KG.FHIRGraph.1|1640|0|				Set tSql = "SELECT Key FROM " _ ..Q(tCtx.SSchema _ "_" _ tTable) _ "." _ ..Q(tCol) _ " WHERE value_System = ? AND value_Value = ?"
L|Graph.KG.FHIRGraph.1|1641|0|			} Else {
L|Graph.KG.FHIRGraph.1|1642|0|				Set tSql = "SELECT Key FROM " _ ..Q(tCtx.SSchema) _ "." _ ..Q(tTable) _ " WHERE " _ ..Q(tCol _ "_System") _ " = ? AND " _ ..Q(tCol _ "_Value") _ " = ?"
L|Graph.KG.FHIRGraph.1|1643|0|			}
L|Graph.KG.FHIRGraph.1|1644|0|			Set tSys = ""
L|Graph.KG.FHIRGraph.1|1645|0|			For {
L|Graph.KG.FHIRGraph.1|1646|0|				Set tSys = $Order(tCodes(tSys))
L|Graph.KG.FHIRGraph.1|1647|0|				Quit:tSys=""
L|Graph.KG.FHIRGraph.1|1648|0|				Set tCode = ""
L|Graph.KG.FHIRGraph.1|1649|0|				For {
L|Graph.KG.FHIRGraph.1|1650|0|					Set tCode = $Order(tCodes(tSys, tCode))
L|Graph.KG.FHIRGraph.1|1651|0|					Quit:tCode=""
L|Graph.KG.FHIRGraph.1|1652|0|					Set tRs = tCtx.Query(tSql, tSys, tCode)
L|Graph.KG.FHIRGraph.1|1653|0|					While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1654|0|						Set tK = tRs.%GetData(1)
L|Graph.KG.FHIRGraph.1|1655|0|						Continue:$Data(tSeen(tK))
L|Graph.KG.FHIRGraph.1|1656|0|						Set tSeen(tK) = ""
L|Graph.KG.FHIRGraph.1|1657|0|						// A delete removes the search rows (spec fact 5); checking Rsrc as
L|Graph.KG.FHIRGraph.1|1658|0|						// well costs one indexed probe and does not depend on that.
L|Graph.KG.FHIRGraph.1|1659|0|						Continue:tCtx.Liveness(tK)'=1
L|Graph.KG.FHIRGraph.1|1660|0|						Do tKeys.%Push(tK)
L|Graph.KG.FHIRGraph.1|1661|0|					}
L|Graph.KG.FHIRGraph.1|1662|0|				}
L|Graph.KG.FHIRGraph.1|1663|0|			}
L|Graph.KG.FHIRGraph.1|1664|0|		}
L|Graph.KG.FHIRGraph.1|1665|0|		// Medication hop (spec 235, R10): a resolved Medication adds the four
L|Graph.KG.FHIRGraph.1|1666|0|		// medication-use types that reference it through `medication`.
L|Graph.KG.FHIRGraph.1|1667|0|		Set tVia = {}
L|Graph.KG.FHIRGraph.1|1668|0|		Set tNMed = 0
L|Graph.KG.FHIRGraph.1|1669|0|		Set tAdded = 0
L|Graph.KG.FHIRGraph.1|1670|0|		Set tN = tKeys.%Size()
L|Graph.KG.FHIRGraph.1|1671|0|		For tI = 0:1:tN-1 {
L|Graph.KG.FHIRGraph.1|1672|0|			Set tM = tKeys.%Get(tI)
L|Graph.KG.FHIRGraph.1|1673|0|			Continue:$Piece(tM, "/")'="Medication"
L|Graph.KG.FHIRGraph.1|1674|0|			Set tNMed = tNMed + 1
L|Graph.KG.FHIRGraph.1|1675|0|			Set tSrc = ""
L|Graph.KG.FHIRGraph.1|1676|0|			For {
L|Graph.KG.FHIRGraph.1|1677|0|				Set tSrc = $Order(^KG("in", tCtx.GKey, tM, "medication", tSrc))
L|Graph.KG.FHIRGraph.1|1678|0|				Quit:tSrc=""
L|Graph.KG.FHIRGraph.1|1679|0|				Continue:'$ListFind($ListBuild("MedicationRequest", "MedicationStatement", "MedicationAdministration", "MedicationDispense"), $Piece(tSrc, "/"))
L|Graph.KG.FHIRGraph.1|1680|0|				Continue:$Data(tSeen(tSrc))
L|Graph.KG.FHIRGraph.1|1681|0|				Set tSeen(tSrc) = ""
L|Graph.KG.FHIRGraph.1|1682|0|				Continue:tCtx.Liveness(tSrc)'=1
L|Graph.KG.FHIRGraph.1|1683|0|				Do tKeys.%Push(tSrc)
L|Graph.KG.FHIRGraph.1|1684|0|				Do tVia.%Set(tSrc, "medication")
L|Graph.KG.FHIRGraph.1|1685|0|				Set tAdded = tAdded + 1
L|Graph.KG.FHIRGraph.1|1686|0|			}
L|Graph.KG.FHIRGraph.1|1687|0|		}
L|Graph.KG.FHIRGraph.1|1688|0|		Set tHop = {}
L|Graph.KG.FHIRGraph.1|1689|0|		Do tHop.%Set("medications", tNMed, "number")
L|Graph.KG.FHIRGraph.1|1690|0|		Do tHop.%Set("added", tAdded, "number")
L|Graph.KG.FHIRGraph.1|1691|0|		Set tRes = {"status": "ok", "graph_id": (pGraph), "keys": (tKeys), "via": (tVia), "medication_hop": (tHop)}
L|Graph.KG.FHIRGraph.1|1692|0|		Do tRes.%Set("codes", tNCodes, "number")
L|Graph.KG.FHIRGraph.1|1693|0|		Do tRes.%Set("elapsed_ms", $Justify(($ZHorolog - tStart) * 1000, 0, 1), "number")
L|Graph.KG.FHIRGraph.1|1694|0|		Set tOut = tRes.%ToJSON()
L|Graph.KG.FHIRGraph.1|1695|0|	} Catch tEx {
L|Graph.KG.FHIRGraph.1|1696|0|		Set tOut = ..Err(tEx)
L|Graph.KG.FHIRGraph.1|1697|0|	}
L|Graph.KG.FHIRGraph.1|1698|0|	Return tOut }
L|Graph.KG.FHIRGraph.1|1699|0|ResyncKey(pKey,pFollow=0) methodimpl {
L|Graph.KG.FHIRGraph.1|1700|0|	Set ..Done(pKey) = ""
L|Graph.KG.FHIRGraph.1|1701|0|	Set tLive = ..Liveness(pKey)
L|Graph.KG.FHIRGraph.1|1702|0|	If tLive '= 1 {
L|Graph.KG.FHIRGraph.1|1703|0|		Do ..DropNode(pKey, $Select(tLive = -1: "deleted", 1: "missing"))
L|Graph.KG.FHIRGraph.1|1704|0|		Return
L|Graph.KG.FHIRGraph.1|1705|0|	}
L|Graph.KG.FHIRGraph.1|1706|0|	Set tType = $Piece(pKey, "/", 1)
L|Graph.KG.FHIRGraph.1|1707|0|	Do ..EnsureNode(pKey)
L|Graph.KG.FHIRGraph.1|1708|0|	// --- what the body says, when a json link or the split needs it (R6) -------
L|Graph.KG.FHIRGraph.1|1709|0|	// tWant(p, target) = $lb(qualifier key, value); tRefs(p, url, version or $C(0))
L|Graph.KG.FHIRGraph.1|1710|0|	// = origin; tXRefs(p, reference) = entry, for extension References.
L|Graph.KG.FHIRGraph.1|1711|0|	Kill tWant, tUnres, tRefs, tXRefs, tFound, tInLib, tInRa
L|Graph.KG.FHIRGraph.1|1712|0|	Set tSplitOn = ($Data(..LibLink(tType)) > 0)
L|Graph.KG.FHIRGraph.1|1713|0|	If $Data(..LinkTypes(tType)) || ..HasExt {
L|Graph.KG.FHIRGraph.1|1714|0|		Set tBody = ..ReadResource(pKey)
L|Graph.KG.FHIRGraph.1|1715|0|		If $IsObject(tBody) {
L|Graph.KG.FHIRGraph.1|1716|0|			Kill tLinks
L|Graph.KG.FHIRGraph.1|1717|0|			Merge tLinks = ..Links
L|Graph.KG.FHIRGraph.1|1718|0|			Do ..Extract(tBody, .tLinks, .tFound)
L|Graph.KG.FHIRGraph.1|1719|0|			If tSplitOn {
L|Graph.KG.FHIRGraph.1|1720|0|				If tBody.%GetTypeOf("library") = "array" {
L|Graph.KG.FHIRGraph.1|1721|0|					Set tArr = tBody.library
L|Graph.KG.FHIRGraph.1|1722|0|					For tI = 0:1:(tArr.%Size() - 1) {
L|Graph.KG.FHIRGraph.1|1723|0|						Continue:tArr.%GetTypeOf(tI)'="string"
L|Graph.KG.FHIRGraph.1|1724|0|						Set tC = ..CanonKey(tArr.%Get(tI))
L|Graph.KG.FHIRGraph.1|1725|0|						Set:tC'="" tInLib(tC) = ""
L|Graph.KG.FHIRGraph.1|1726|0|					}
L|Graph.KG.FHIRGraph.1|1727|0|				}
L|Graph.KG.FHIRGraph.1|1728|0|				If tBody.%GetTypeOf("relatedArtifact") = "array" {
L|Graph.KG.FHIRGraph.1|1729|0|					Set tArr = tBody.relatedArtifact
L|Graph.KG.FHIRGraph.1|1730|0|					For tI = 0:1:(tArr.%Size() - 1) {
L|Graph.KG.FHIRGraph.1|1731|0|						Continue:tArr.%GetTypeOf(tI)'="object"
L|Graph.KG.FHIRGraph.1|1732|0|						Set tRa = tArr.%Get(tI)
L|Graph.KG.FHIRGraph.1|1733|0|						Continue:(tRa.type'="depends-on")||(tRa.%GetTypeOf("resource")'="string")
L|Graph.KG.FHIRGraph.1|1734|0|						Set tC = ..CanonKey(tRa.resource)
L|Graph.KG.FHIRGraph.1|1735|0|						Set:tC'="" tInRa(tC) = ""
L|Graph.KG.FHIRGraph.1|1736|0|					}
L|Graph.KG.FHIRGraph.1|1737|0|				}
L|Graph.KG.FHIRGraph.1|1738|0|			}
L|Graph.KG.FHIRGraph.1|1739|0|		}
L|Graph.KG.FHIRGraph.1|1740|0|	}
L|Graph.KG.FHIRGraph.1|1741|0|	// --- what the repository index says this key references --------------------
L|Graph.KG.FHIRGraph.1|1742|0|	Set tParam = ""
L|Graph.KG.FHIRGraph.1|1743|0|	For {
L|Graph.KG.FHIRGraph.1|1744|0|		Set tParam = $Order(..Cols(tType, tParam), 1, tCol)
L|Graph.KG.FHIRGraph.1|1745|0|		Quit:tParam=""
L|Graph.KG.FHIRGraph.1|1746|0|		Set tTable = $ListGet(tCol, 1)
L|Graph.KG.FHIRGraph.1|1747|0|		Set tColumn = $ListGet(tCol, 2)
L|Graph.KG.FHIRGraph.1|1748|0|		If $ListGet(tCol, 5) = "canonical" {
L|Graph.KG.FHIRGraph.1|1749|0|			// The index has split each value into url and version already.
L|Graph.KG.FHIRGraph.1|1750|0|			If $ListGet(tCol, 3) {
L|Graph.KG.FHIRGraph.1|1751|0|				Set tSql = "SELECT value_Reference, value_Version FROM " _ ..Q(..SSchema _ "_" _ tTable) _ "." _ ..Q(tColumn) _ " WHERE Key = ?"
L|Graph.KG.FHIRGraph.1|1752|0|			} Else {
L|Graph.KG.FHIRGraph.1|1753|0|				Set tSql = "SELECT " _ ..Q(tColumn _ "_Reference") _ ", " _ ..Q(tColumn _ "_Version") _ " FROM " _ ..Q(..SSchema) _ "." _ ..Q(tTable) _ " WHERE Key = ?"
L|Graph.KG.FHIRGraph.1|1754|0|			}
L|Graph.KG.FHIRGraph.1|1755|0|			Set tRs = ..Query(tSql, pKey)
L|Graph.KG.FHIRGraph.1|1756|0|			While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1757|0|				Set tUrl = $Extract(tRs.%GetData(1), 1, ..#CANONICALMAX)
L|Graph.KG.FHIRGraph.1|1758|0|				Continue:(tUrl="")||($Extract(tUrl)="#")
L|Graph.KG.FHIRGraph.1|1759|0|				Set tVer = $Extract(tRs.%GetData(2), 1, ..#CANONICALMAX)
L|Graph.KG.FHIRGraph.1|1760|0|				// The split: a value the body has only in library is a library edge.
L|Graph.KG.FHIRGraph.1|1761|0|				Continue:tSplitOn&&$ListGet(tCol,6)&&'..KeepIndex(tUrl_$Select(tVer="":"",1:"|"_tVer),.tInLib,.tInRa)
L|Graph.KG.FHIRGraph.1|1762|0|				Set tRefs(tParam, tUrl, $Select(tVer = "": $Char(0), 1: tVer)) = "index"
L|Graph.KG.FHIRGraph.1|1763|0|			}
L|Graph.KG.FHIRGraph.1|1764|0|			Continue
L|Graph.KG.FHIRGraph.1|1765|0|		}
L|Graph.KG.FHIRGraph.1|1766|0|		If $ListGet(tCol, 3) {
L|Graph.KG.FHIRGraph.1|1767|0|			Set tSql = "SELECT value_Reference, value_RelativeRef FROM " _ ..Q(..SSchema _ "_" _ tTable) _ "." _ ..Q(tColumn) _ " WHERE Key = ?"
L|Graph.KG.FHIRGraph.1|1768|0|		} Else {
L|Graph.KG.FHIRGraph.1|1769|0|			Set tSql = "SELECT " _ ..Q(tColumn _ "_Reference") _ ", " _ ..Q(tColumn _ "_RelativeRef") _ " FROM " _ ..Q(..SSchema) _ "." _ ..Q(tTable) _ " WHERE Key = ?"
L|Graph.KG.FHIRGraph.1|1770|0|		}
L|Graph.KG.FHIRGraph.1|1771|0|		Set tRs = ..Query(tSql, pKey)
L|Graph.KG.FHIRGraph.1|1772|0|		While tRs.%Next() {
L|Graph.KG.FHIRGraph.1|1773|0|			Set tKind = ..Classify(tRs.%GetData(1), tRs.%GetData(2), .tTarget)
L|Graph.KG.FHIRGraph.1|1774|0|			Continue:tKind="skip"
L|Graph.KG.FHIRGraph.1|1775|0|			If tKind = "external" {
L|Graph.KG.FHIRGraph.1|1776|0|				Set tUnres(tParam, tTarget) = "external"
L|Graph.KG.FHIRGraph.1|1777|0|				Continue
L|Graph.KG.FHIRGraph.1|1778|0|			}
L|Graph.KG.FHIRGraph.1|1779|0|			Set tTLive = ..Liveness(tTarget)
L|Graph.KG.FHIRGraph.1|1780|0|			If tTLive = 1 {
L|Graph.KG.FHIRGraph.1|1781|0|				Set tWant(tParam, tTarget) = $ListBuild("searchParam", $ListGet(tCol, 4))
L|Graph.KG.FHIRGraph.1|1782|0|			} Else {
L|Graph.KG.FHIRGraph.1|1783|0|				Set tUnres(tParam, tTarget) = $Select(tTLive = -1: "deleted", 1: "missing")
L|Graph.KG.FHIRGraph.1|1784|0|			}
L|Graph.KG.FHIRGraph.1|1785|0|		}
L|Graph.KG.FHIRGraph.1|1786|0|	}
L|Graph.KG.FHIRGraph.1|1787|0|	// Body links. A canonical joins the index's; the index's origin wins a tie.
L|Graph.KG.FHIRGraph.1|1788|0|	For tI = 1:1:$Get(tFound) {
