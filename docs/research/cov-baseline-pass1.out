L|Graph.KG.BM25Index.1|120|0|Info(name) methodimpl {
L|Graph.KG.BM25Index.1|121|2|    Set N = $Get(^BM25Idx(name, "cfg", "N"), "")
L|Graph.KG.BM25Index.1|122|2|    If N = "" Return "{}"
L|Graph.KG.BM25Index.1|123|2|    Set schema = +$Get(^BM25Idx(name, "cfg", "schema"), 1)
L|Graph.KG.BM25Index.1|124|2|    If schema >= 2 {
L|Graph.KG.BM25Index.1|125|2|        Set avgdl = $Select(N > 0: +$Get(^BM25Idx(name, "cfg", "totalLen"), 0) / N, 1: 0)
L|Graph.KG.BM25Index.1|126|0|    } Else {
L|Graph.KG.BM25Index.1|127|0|        Set avgdl = +$Get(^BM25Idx(name, "cfg", "avgdl"), 0)
