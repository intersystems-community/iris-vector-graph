L|Graph.KG.NKGAccelCentrality.1|140|0|BetweennessNeighborhoodOS(n,sampleSize,topK) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|141|0|    If n = 0 Quit "ERROR:no nodes"
L|Graph.KG.NKGAccelCentrality.1|142|0|    Set srcCount = $Select((sampleSize>0)&&(sampleSize<n):sampleSize, 1:n)
L|Graph.KG.NKGAccelCentrality.1|143|0|    Set scale = +$Number(n/srcCount,15)
L|Graph.KG.NKGAccelCentrality.1|144|0|    Set parentPid = $Job
L|Graph.KG.NKGAccelCentrality.1|145|0|    Kill ^bcParSrc(parentPid), ^bcParScore(parentPid), ^bcBitAdj(parentPid)
L|Graph.KG.NKGAccelCentrality.1|146|0|    // Build $BIT adjacency restricted to neighborhood
L|Graph.KG.NKGAccelCentrality.1|147|0|    Set idx = "", pos = 0
L|Graph.KG.NKGAccelCentrality.1|148|0|    For {
L|Graph.KG.NKGAccelCentrality.1|149|0|        Set idx = $Order(^||nbhIdx(idx))
L|Graph.KG.NKGAccelCentrality.1|150|0|        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|151|0|        Set negP = $Order(^NKG(-1,idx,""))
L|Graph.KG.NKGAccelCentrality.1|152|0|        While negP '= "" {
L|Graph.KG.NKGAccelCentrality.1|153|0|            Set dstIdx = $Order(^NKG(-1,idx,negP,""))
L|Graph.KG.NKGAccelCentrality.1|154|0|            While dstIdx '= "" {
L|Graph.KG.NKGAccelCentrality.1|155|0|                If $Data(^||nbhIdx(dstIdx)) {
L|Graph.KG.NKGAccelCentrality.1|156|0|                    Set $BIT(^bcBitAdj(parentPid,idx),dstIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|157|0|                    Set $BIT(^bcBitAdj(parentPid,dstIdx),idx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|158|0|                }
L|Graph.KG.NKGAccelCentrality.1|159|0|                Set dstIdx = $Order(^NKG(-1,idx,negP,dstIdx))
L|Graph.KG.NKGAccelCentrality.1|160|0|            }
L|Graph.KG.NKGAccelCentrality.1|161|0|            Set negP = $Order(^NKG(-1,idx,negP))
L|Graph.KG.NKGAccelCentrality.1|162|0|        }
L|Graph.KG.NKGAccelCentrality.1|163|0|    }
L|Graph.KG.NKGAccelCentrality.1|164|0|    For si = 0:1:srcCount-1 {
L|Graph.KG.NKGAccelCentrality.1|165|0|        Set ^bcParSrc(parentPid,si) = ^||nbhNodes(si)
L|Graph.KG.NKGAccelCentrality.1|166|0|    }
L|Graph.KG.NKGAccelCentrality.1|167|0|    Set numJobs = $System.Util.NumberOfCPUs()
L|Graph.KG.NKGAccelCentrality.1|168|0|    If numJobs > 8 { Set numJobs = 8 }
L|Graph.KG.NKGAccelCentrality.1|169|0|    If numJobs > srcCount { Set numJobs = srcCount }
L|Graph.KG.NKGAccelCentrality.1|170|0|    Set queue = ##class(%SYSTEM.WorkMgr).%New("",numJobs)
L|Graph.KG.NKGAccelCentrality.1|171|0|    Set chunkSize = srcCount\numJobs, remainder = srcCount#numJobs, cursor = 0
L|Graph.KG.NKGAccelCentrality.1|172|0|    For w = 1:1:numJobs {
L|Graph.KG.NKGAccelCentrality.1|173|0|        Set wSize = chunkSize + $Select(w<=remainder:1,1:0)
L|Graph.KG.NKGAccelCentrality.1|174|0|        Set sc = queue.Queue("##class(Graph.KG.NKGAccel).BetweennessWorker",parentPid,w,cursor,cursor+wSize-1,scale)
L|Graph.KG.NKGAccelCentrality.1|175|0|        Set cursor = cursor + wSize
L|Graph.KG.NKGAccelCentrality.1|176|0|        If ('sc) {
L|Graph.KG.NKGAccelCentrality.1|177|0|            Kill ^bcParSrc(parentPid),^bcParScore(parentPid),^bcBitAdj(parentPid),^||nbhIdx,^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|178|0|            Quit "ERROR:Queue failed"
L|Graph.KG.NKGAccelCentrality.1|179|0|        }
L|Graph.KG.NKGAccelCentrality.1|180|0|    }
L|Graph.KG.NKGAccelCentrality.1|181|0|    Do queue.Sync()
L|Graph.KG.NKGAccelCentrality.1|182|0|    Kill ^bcParSrc(parentPid), ^bcBitAdj(parentPid)
L|Graph.KG.NKGAccelCentrality.1|183|0|    Set json = "[", sep = "", cnt = 0
L|Graph.KG.NKGAccelCentrality.1|184|0|    Set idx = ""
L|Graph.KG.NKGAccelCentrality.1|185|0|    For {
L|Graph.KG.NKGAccelCentrality.1|186|0|        Set idx = $Order(^||nbhIdx(idx))
L|Graph.KG.NKGAccelCentrality.1|187|0|        Quit:idx=""
L|Graph.KG.NKGAccelCentrality.1|188|0|        Set nid = $Get(^NKG("$ND",idx),"")
L|Graph.KG.NKGAccelCentrality.1|189|0|        If nid = "" Continue
L|Graph.KG.NKGAccelCentrality.1|190|0|        Set total = 0
L|Graph.KG.NKGAccelCentrality.1|191|0|        For w = 1:1:numJobs { Set total = total + $Get(^bcParScore(parentPid,w,idx),0) }
L|Graph.KG.NKGAccelCentrality.1|192|0|        If total = 0 Continue
L|Graph.KG.NKGAccelCentrality.1|193|0|        Set json = json_sep_"{""id"":"""_nid_""",""score"":"_total_"}"
L|Graph.KG.NKGAccelCentrality.1|194|0|        Set sep = ","
L|Graph.KG.NKGAccelCentrality.1|195|0|        Set cnt = cnt+1
L|Graph.KG.NKGAccelCentrality.1|196|0|        If (topK>0)&&(cnt>=topK) Quit
L|Graph.KG.NKGAccelCentrality.1|197|0|    }
L|Graph.KG.NKGAccelCentrality.1|198|0|    Kill ^bcParScore(parentPid), ^||nbhIdx, ^||nbhNodes
L|Graph.KG.NKGAccelCentrality.1|199|0|    Quit "OK:"_json_"]" }
L|Graph.KG.NKGAccelCentrality.1|200|0|BetweennessWorker(parentPid,workerN,srcFirst,srcLast,scale) methodimpl {
L|Graph.KG.NKGAccelCentrality.1|201|232|    Set n = +$Get(^NKG("$meta","nodeCount"),0)
L|Graph.KG.NKGAccelCentrality.1|202|232|    If n = 0 Return 1
L|Graph.KG.NKGAccelCentrality.1|203|232|    Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack, ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|204|232|    For si = srcFirst:1:srcLast {
L|Graph.KG.NKGAccelCentrality.1|205|538|        Set srcNid = $Get(^bcParSrc(parentPid, si),"")
L|Graph.KG.NKGAccelCentrality.1|206|538|        If srcNid = "" Continue
L|Graph.KG.NKGAccelCentrality.1|207|538|        Set sIdx = $Get(^NKG("$NI",srcNid),-1)
L|Graph.KG.NKGAccelCentrality.1|208|538|        If sIdx = -1 Continue
L|Graph.KG.NKGAccelCentrality.1|209|538|        Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack
L|Graph.KG.NKGAccelCentrality.1|210|538|        Set ^||bwSigma(sIdx)=1, ^||bwDist(sIdx)=0
L|Graph.KG.NKGAccelCentrality.1|211|538|        Set frontier = ""
L|Graph.KG.NKGAccelCentrality.1|212|538|        Set $BIT(frontier, sIdx+1) = 1
L|Graph.KG.NKGAccelCentrality.1|213|538|        Set visited = frontier
L|Graph.KG.NKGAccelCentrality.1|214|538|        Set stackTop = 0, bfsLevel = 0
L|Graph.KG.NKGAccelCentrality.1|215|538|        Set ^||bwStack(0) = sIdx
L|Graph.KG.NKGAccelCentrality.1|216|538|        While $BITCOUNT(frontier,1) > 0 {
L|Graph.KG.NKGAccelCentrality.1|217|3497|            Set bfsLevel = bfsLevel + 1
L|Graph.KG.NKGAccelCentrality.1|218|3497|            Set candidates = ""
L|Graph.KG.NKGAccelCentrality.1|219|3499|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|220|3499|            For {
L|Graph.KG.NKGAccelCentrality.1|221|47044|                Set pos = $BITFIND(frontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|222|46975|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|223|43473|                Set v = pos-1
L|Graph.KG.NKGAccelCentrality.1|224|43495|                If $Data(^bcBitAdj(parentPid,v)) {
L|Graph.KG.NKGAccelCentrality.1|225|43520|                    Set candidates = $BITLOGIC(candidates | ^bcBitAdj(parentPid,v))
L|Graph.KG.NKGAccelCentrality.1|226|0|                }
L|Graph.KG.NKGAccelCentrality.1|227|43480|            }
L|Graph.KG.NKGAccelCentrality.1|228|3495|            Set newFrontier = $BITLOGIC(candidates & ~visited)
L|Graph.KG.NKGAccelCentrality.1|229|3495|            Quit:$BITCOUNT(newFrontier,1)=0
L|Graph.KG.NKGAccelCentrality.1|230|2957|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|231|2958|            For {
L|Graph.KG.NKGAccelCentrality.1|232|45842|                Set pos = $BITFIND(newFrontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|233|45793|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|234|42866|                Set w = pos-1
L|Graph.KG.NKGAccelCentrality.1|235|42766|                Set ^||bwDist(w) = bfsLevel
L|Graph.KG.NKGAccelCentrality.1|236|42847|                Set ^||bwSigma(w) = 0
L|Graph.KG.NKGAccelCentrality.1|237|42734|                Set stackTop = stackTop+1
L|Graph.KG.NKGAccelCentrality.1|238|42874|                Set ^||bwStack(stackTop) = w
L|Graph.KG.NKGAccelCentrality.1|239|42807|            }
L|Graph.KG.NKGAccelCentrality.1|240|2959|            Set pos = 0
L|Graph.KG.NKGAccelCentrality.1|241|2960|            For {
L|Graph.KG.NKGAccelCentrality.1|242|41438|                Set pos = $BITFIND(frontier, 1, pos+1)
L|Graph.KG.NKGAccelCentrality.1|243|41432|                Quit:pos=0
L|Graph.KG.NKGAccelCentrality.1|244|38487|                Set v = pos-1
L|Graph.KG.NKGAccelCentrality.1|245|38454|                If $Data(^bcBitAdj(parentPid,v)) {
L|Graph.KG.NKGAccelCentrality.1|246|38472|                    Set vToNew = $BITLOGIC(^bcBitAdj(parentPid,v) & newFrontier)
L|Graph.KG.NKGAccelCentrality.1|247|38421|                    Set pos2 = 0
L|Graph.KG.NKGAccelCentrality.1|248|38417|                    For {
L|Graph.KG.NKGAccelCentrality.1|249|124284|                        Set pos2 = $BITFIND(vToNew, 1, pos2+1)
L|Graph.KG.NKGAccelCentrality.1|250|123819|                        Quit:pos2=0
L|Graph.KG.NKGAccelCentrality.1|251|86182|                        Set w = pos2-1
L|Graph.KG.NKGAccelCentrality.1|252|85501|                        Set ^||bwSigma(w) = +$Number($Get(^||bwSigma(w),0)+$Get(^||bwSigma(v),1),15)
L|Graph.KG.NKGAccelCentrality.1|253|85923|                        Set ^||bwPred(w,v) = ""
L|Graph.KG.NKGAccelCentrality.1|254|85801|                    }
L|Graph.KG.NKGAccelCentrality.1|255|0|                }
L|Graph.KG.NKGAccelCentrality.1|256|38502|            }
L|Graph.KG.NKGAccelCentrality.1|257|2961|            Set visited = $BITLOGIC(visited | newFrontier)
L|Graph.KG.NKGAccelCentrality.1|258|2958|            Set frontier = newFrontier
L|Graph.KG.NKGAccelCentrality.1|259|2958|        }
L|Graph.KG.NKGAccelCentrality.1|260|538|        Kill ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|261|538|        Set wi = stackTop
L|Graph.KG.NKGAccelCentrality.1|262|538|        While wi >= 0 {
L|Graph.KG.NKGAccelCentrality.1|263|43372|            Set wIdx = ^||bwStack(wi), wi = wi-1
L|Graph.KG.NKGAccelCentrality.1|264|43499|            Set v2 = $Order(^||bwPred(wIdx,""))
L|Graph.KG.NKGAccelCentrality.1|265|43463|            While v2 '= "" {
L|Graph.KG.NKGAccelCentrality.1|266|85999|                Set sv = +$Number($Get(^||bwSigma(v2),1),15)
L|Graph.KG.NKGAccelCentrality.1|267|85964|                Set sw = +$Number($Get(^||bwSigma(wIdx),1),15)
L|Graph.KG.NKGAccelCentrality.1|268|85900|                If sw > 0 {
L|Graph.KG.NKGAccelCentrality.1|269|85964|                    Set dv = +$Number($Get(^||bwDelta(v2),0),15)
L|Graph.KG.NKGAccelCentrality.1|270|86084|                    Set dw = +$Number($Get(^||bwDelta(wIdx),0),15)
L|Graph.KG.NKGAccelCentrality.1|271|86229|                    Set r  = +$Number(sv/sw,15)
L|Graph.KG.NKGAccelCentrality.1|272|86128|                    Set c  = +$Number(r*(1+dw),15)
L|Graph.KG.NKGAccelCentrality.1|273|85918|                    Set ^||bwDelta(v2) = +$Number(dv+c,15)
L|Graph.KG.NKGAccelCentrality.1|274|0|                }
L|Graph.KG.NKGAccelCentrality.1|275|86062|                Set v2 = $Order(^||bwPred(wIdx,v2))
L|Graph.KG.NKGAccelCentrality.1|276|85879|            }
L|Graph.KG.NKGAccelCentrality.1|277|43446|            If wIdx '= sIdx {
L|Graph.KG.NKGAccelCentrality.1|278|42950|                Set d   = +$Number($Get(^||bwDelta(wIdx),0),15)
L|Graph.KG.NKGAccelCentrality.1|279|42975|                Set cur = $Get(^bcParScore(parentPid,workerN,wIdx),0)
L|Graph.KG.NKGAccelCentrality.1|280|42979|                Set ^bcParScore(parentPid,workerN,wIdx) = +$Number(cur + +$Number(d*scale,15),15)
L|Graph.KG.NKGAccelCentrality.1|281|0|            }
L|Graph.KG.NKGAccelCentrality.1|282|43494|        }
L|Graph.KG.NKGAccelCentrality.1|283|538|    }
L|Graph.KG.NKGAccelCentrality.1|284|232|    Kill ^||bwSigma, ^||bwDist, ^||bwPred, ^||bwStack, ^||bwDelta
L|Graph.KG.NKGAccelCentrality.1|285|232|    Return 1 }
