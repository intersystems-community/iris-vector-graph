L|Graph.KG.NKGAccelTraversal.1|505|132|            Set first = 0
L|Graph.KG.NKGAccelTraversal.1|506|132|            Set result = result _ "{""id"":"""_nodeId_""",""score"":"_$FNumber(score,"",6)_"}"
